#!/bin/sh
# iriscale_voice — let your coding agents tell you when they're done or need you.
#
# Called by Claude Code hooks with the hook's JSON payload on stdin:
#   iriscale-voice <event>          (see `iriscale-voice events`)
# Also a CLI, used by the /iriscale-voice:* slash commands and by humans:
#   iriscale-voice --help
#
# Strict POSIX sh, zero dependencies: no jq, node, python. Speech uses whatever the
# OS ships: PowerShell/System.Speech (Windows), say (macOS), spd-say/espeak (Linux).

VERSION="0.1.28"
EVENT="${1:-Stop}"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CONF="$CLAUDE_DIR/iriscale-voice.conf"
# Runtime files live under the user's config directory, never a shared /tmp name.
# -O is supported by all our target shells (dash, Bash and zsh); fail closed otherwise.
STATE="$CLAUDE_DIR/iriscale-voice-runtime"
umask 077
if [ -L "$STATE" ]; then echo "unsafe runtime directory (symlink): $STATE" >&2; exit 1; fi
[ -d "$STATE" ] || mkdir -p -m 700 "$STATE" 2>/dev/null
if [ ! -d "$STATE" ] || [ ! -O "$STATE" ]; then echo "cannot use private runtime directory: $STATE" >&2; exit 1; fi
# A raw shell launch may have no PATH; use the OS utility directly in that case.
_chmod=chmod; command -v chmod >/dev/null 2>&1 || _chmod=/bin/chmod
"$_chmod" 700 "$STATE" 2>/dev/null || { echo "cannot protect runtime directory: $STATE" >&2; exit 1; }
SESS="$CLAUDE_DIR/iriscale-voice-sessions"     # one state file per live session (any agent)

# ---------- tiny helpers ------------------------------------------------------
# PERFORMANCE NOTE. This script runs on every hook event, and on Windows/MSYS each
# external process (sed, grep, tr...) costs 25-50 ms to spawn. The first versions
# spawned ~40 of them per event and took ~1.8 s before speaking. So the hot paths
# below use only shell builtins: the config file is read ONCE into memory and every
# lookup is parameter expansion + case. Keep it that way.
NL='
'
CR=$(printf '\r')
ESC=$(printf '\033')     # the escape byte; colours and cursor control are built from it

# Pull a string field out of flat-ish JSON without jq: first occurrence of "key",
# then optional whitespace, ':', whitespace, and a double-quoted value. Not a JSON
# parser — good enough for the ids, paths and tool names we read. Zero spawns.
jget() {
    j=$2
    case $j in *"\"$1\""*) ;; *) return 0 ;; esac
    r=${j#*"\"$1\""}
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in ':'*) r=${r#:} ;; *) return 0 ;; esac
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in '"'*) r=${r#\"} ;; *) return 0 ;; esac
    # fast path: no backslash before the closing quote
    _head=${r%%\"*}
    case $_head in *\\*) ;; *) printf '%s' "$_head"; return 0 ;; esac
    # slow path: honour JSON escapes (\" \\ \n \t \/) so a value like
    # curl -H \"Authorization: ...\" is returned whole, not cut at the first \"
    _v=""
    while [ -n "$r" ]; do
        _ch=${r%"${r#?}"}; r=${r#?}
        case $_ch in
            \\) _n=${r%"${r#?}"}; r=${r#?}
                case $_n in n|t|r) _v="$_v " ;; '') ;; *) _v="$_v$_n" ;; esac ;;
            \") break ;;
            *)  _v="$_v$_ch" ;;
        esac
    done
    printf '%s' "$_v"
}

# Unquoted number field: "pid":12345  (zero spawns)
jnum() { case $2 in *"\"$1\":"*) r=${2#*"\"$1\":"}; while case $r in ' '*) true ;; *) false ;; esac; do r=${r#?}; done; printf '%s' "${r%%[!0-9]*}" ;; esac; }

# Pull the first string from a JSON array field (for workspace_roots aliases).
# Like jget, this deliberately handles only the small hook-payload shape we need.
jfirst() {
    j=$2
    case $j in *"\"$1\""*) ;; *) return 0 ;; esac
    r=${j#*"\"$1\""}
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in ':'*) r=${r#:} ;; *) return 0 ;; esac
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in '['*) r=${r#[} ;; *) return 0 ;; esac
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in '"'*) r=${r#\"} ;; *) return 0 ;; esac
    printf '%s' "${r%%\"*}"
}

# Config: key=value lines, '#' comments, no quoting. Loaded once into CONF_DATA
# (normalized: trimmed, CR stripped, comments dropped). Last occurrence of a key wins.
CONF_DATA=""
load_conf() {
    CONF_DATA=""
    [ -f "$CONF" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%"$CR"}
        case $line in *=*) ;; *) continue ;; esac          # skips blanks and non key=value lines
        k=${line%%=*}; v=${line#*=}
        while case $k in ' '*|"	"*) true ;; *) false ;; esac; do k=${k#?}; done
        while case $k in *' '|*"	") true ;; *) false ;; esac; do k=${k%?}; done
        while case $v in ' '*|"	"*) true ;; *) false ;; esac; do v=${v#?}; done
        while case $v in *' '|*"	") true ;; *) false ;; esac; do v=${v%?}; done
        case $k in '#'*|'') continue ;; esac                # comments
        CONF_DATA="$CONF_DATA$k=$v$NL"
    done < "$CONF"
}
load_conf

# cfgv VAR <key> <default> — assign the setting to VAR with no subshell (use this on
# the hook path: $(cfg ...) forks, ~14 ms each on MSYS).  cfg <key> <default> prints.
# Precedence: conf file > plugin setting (CLAUDE_PLUGIN_OPTION_<KEY>) > default.
cfgv() {
    _k=$2; _v=""; _rest=$CONF_DATA
    while [ -n "$_rest" ]; do
        _line=${_rest%%"$NL"*}; _rest=${_rest#*"$NL"}
        case $_line in "$_k="*) _v=${_line#*=} ;; esac
    done
    if [ -z "$_v" ] && [ "$HAVE_PLUGIN_OPTS" = 1 ]; then
        _envkey=CLAUDE_PLUGIN_OPTION_$(printf '%s' "$_k" | tr 'a-z.' 'A-Z_')
        eval "_v=\${$_envkey:-}"
    fi
    [ -n "$_v" ] || _v=$3
    eval "$1=\$_v"
}
cfg() { cfgv _out "$1" "$2"; printf '%s' "$_out"; }
# only pay for the env-var fallback if the plugin host actually exported options
HAVE_PLUGIN_OPTS=0
case "$(env 2>/dev/null)" in *CLAUDE_PLUGIN_OPTION_*) HAVE_PLUGIN_OPTS=1 ;; esac
cfg_set() {   # cfg_set <key> <value>  (create/replace the line, keep everything else)
    case $1 in ''|*[!A-Za-z0-9._]*) echo "invalid key: $1" >&2; return 2 ;; esac
    case $2 in *"$NL"*) echo "value may not contain a newline" >&2; return 2 ;; esac
    [ -f "$CONF" ] || : > "$CONF"
    # rewrite with builtins (no sed metacharacter surprises from '|', '&', '\')
    _out=""; _hit=0
    while IFS= read -r _l || [ -n "$_l" ]; do
        _k=${_l%%=*}; while case $_k in ' '*|"	"*) true ;; *) false ;; esac; do _k=${_k#?}; done
        while case $_k in *' '|*"	") true ;; *) false ;; esac; do _k=${_k%?}; done
        case $_l in *=*) if [ "$_k" = "$1" ]; then _out="$_out$1=$2$NL"; _hit=1; continue; fi ;; esac
        _out="$_out$_l$NL"
    done < "$CONF"
    [ "$_hit" = 1 ] || _out="$_out$1=$2$NL"
    printf '%s' "$_out" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
    load_conf
}
now() { printf "%s" "$NOW"; }   # NOW is set once, at the top of the hook path
os() {
    # $OS is set to Windows_NT by Windows itself - no spawn, and it works even when
    # the launching process gave us a PATH without uname (raw MSYS sh.exe).
    case "${OS:-}" in Windows_NT) echo win; return ;; esac
    case "$(uname -s 2>/dev/null)" in
        Darwin) echo mac ;;
        MINGW*|MSYS*|CYGWIN*|Windows_NT) echo win ;;
        *) echo linux ;;
    esac
}
# keep spoken text shell-safe for every backend: letters, digits, basic punctuation.
# SECURITY INVARIANT: the allowlist must never admit ' " \ ` or $ - the Windows
# backend embeds this text in a single-quoted PowerShell string. A test asserts it.
# If tr is unreachable (PATH-less launch) fall back to a builtin scrub of the
# characters that could break the quoted speech command - never go silent.
clean() {
    # allowlist scrub with builtins only (no tr): anything outside the set becomes a
    # space, runs of spaces collapse. Zero spawns, works with a PATH-less launch.
    _in=$1; _o=""; _sp=0
    while [ -n "$_in" ]; do
        _ch=${_in%"${_in#?}"}; _in=${_in#?}
        case $_ch in
            [A-Za-z0-9.,:\;!?\(\)/\&%+=@#\[\]-]) _o="$_o$_ch"; _sp=0 ;;
            *) [ "$_sp" = 1 ] || _o="$_o "; _sp=1 ;;
        esac
    done
    printf '%s' "$_o"
}
# lc_to VAR <text>: lowercase with builtins (no tr - sayable also runs on the debug path)
lc_to() {
    _ls=$2; _lr=""
    while [ -n "$_ls" ]; do
        _lc=${_ls%"${_ls#?}"}; _ls=${_ls#?}
        case $_lc in A) _lc=a;; B) _lc=b;; C) _lc=c;; D) _lc=d;; E) _lc=e;; F) _lc=f;; G) _lc=g;; H) _lc=h;; I) _lc=i;; J) _lc=j;; K) _lc=k;; L) _lc=l;; M) _lc=m;; N) _lc=n;; O) _lc=o;; P) _lc=p;; Q) _lc=q;; R) _lc=r;; S) _lc=s;; T) _lc=t;; U) _lc=u;; V) _lc=v;; W) _lc=w;; X) _lc=x;; Y) _lc=y;; Z) _lc=z;; esac
        _lr="$_lr$_lc"
    done
    eval "$1=\$_lr"
}
# PORTABILITY. A range like [a-z] is matched through the locale's COLLATION order, not
# the byte order: in a UTF-8 locale the collation runs aAbBcC..., so [A-Z] also matches
# every lowercase letter except "a", and [a-z] matches uppercase ones. That silently
# turned "payments done" into "pa y m e n t s, d o n e" on any machine with a UTF-8
# locale. Enumerate the letters wherever a range has to mean exactly one case.
LOWER=abcdefghijklmnopqrstuvwxyz
UPPER=ABCDEFGHIJKLMNOPQRSTUVWXYZ
HEXLET=abcdef

# sayable <text>: rewrite code-ish words so a synthesizer says them the way you would.
# Left alone they come out mangled: "AskUserQuestion" as one smeared word, "4d" as
# "fourd", "npx" as "nix". Word by word, first match wins:
#   1. your `pronounce` setting  (pronounce=iriscale=eye riss scale,naro=nah row)
#   2. well-known CLI names       (npx -> N P X, kubectl -> kube control, eslint -> E S lint)
#   3. short hex-ish tokens       (4d -> 4 D, 0f -> 0 F, aa -> A A: auto session-name suffixes)
#   4. CamelCase                  (AskUserQuestion -> Ask User Question)
# Runs in the detached speaker (and once on the debug path), builtins only. Output still
# goes through clean(), so a pronounce value can never smuggle a quote to the shell.
sayable() {
    cfgv _pr pronounce ""
    _sout=""; _oifs=$IFS; IFS=' '; set -f
    for _w in $1; do
        _tp=""   # trailing punctuation stays attached, outside the match
        while case $_w in ?*[.,:\;!?\)]) true ;; *) false ;; esac; do _tp="${_w#"${_w%?}"}$_tp"; _w=${_w%?}; done
        _sw=""; lc_to _lw "$_w"
        if [ -n "$_pr" ]; then
            _prest="$_pr,"
            while [ -n "$_prest" ]; do
                _pair=${_prest%%,*}; _prest=${_prest#*,}
                case $_pair in *=*) ;; *) continue ;; esac
                _pk=${_pair%%=*}; _pv=${_pair#*=}
                while case $_pk in ' '*) true ;; *) false ;; esac; do _pk=${_pk#?}; done
                while case $_pk in *' ') true ;; *) false ;; esac; do _pk=${_pk%?}; done
                lc_to _pk "$_pk"
                [ "$_pk" = "$_lw" ] && { _sw=$_pv; break; }
            done
        fi
        if [ -z "$_sw" ]; then
            case $_lw in
                npm) _sw="N P M" ;; npx) _sw="N P X" ;; pnpm) _sw="P N P M" ;; nvm) _sw="N V M" ;;
                gh) _sw="G H" ;; ls) _sw="L S" ;; cd) _sw="C D" ;; rm) _sw="R M" ;; cp) _sw="C P" ;;
                mv) _sw="M V" ;; ln) _sw="L N" ;; ssh) _sw="S S H" ;; scp) _sw="S C P" ;;
                tsc) _sw="T S C" ;; tsx) _sw="T S X" ;; psql) _sw="P S Q L" ;; sql) _sw="S Q L" ;;
                mysql) _sw="my S Q L" ;; cli) _sw="C L I" ;; api) _sw="A P I" ;; url) _sw="U R L" ;;
                mcp) _sw="M C P" ;; ci) _sw="C I" ;; pr) _sw="P R" ;; db) _sw="D B" ;;
                eslint) _sw="E S lint" ;; kubectl) _sw="kube control" ;; k8s) _sw="kubernetes" ;;
                chmod) _sw="C H mod" ;; chown) _sw="C H own" ;; mkdir) _sw="make dir" ;;
                aws) _sw="A W S" ;; gcloud) _sw="G cloud" ;; sh) _sw="S H" ;; zsh) _sw="Z S H" ;;
                js) _sw="J S" ;; ts) _sw="T S" ;; vscode) _sw="V S code" ;; ide) _sw="I D E" ;;
                ui) _sw="U I" ;; iriscale) _sw="iris scale" ;; '&&') _sw="and then" ;;
            esac
        fi
        if [ -z "$_sw" ]; then
            case $_lw in
                *[!0-9$HEXLET]*|'') ;;                   # not hex-shaped
                *) _hd=0; case $_lw in *[0-9]*) _hd=1 ;; esac
                   _hl=0; case $_lw in *[$HEXLET]*) _hl=1 ;; esac
                   _spell=0
                   if [ "$_hd" = 1 ] && [ "$_hl" = 1 ] && [ ${#_lw} -le 4 ]; then _spell=1
                   elif [ "$_hd" = 0 ] && [ ${#_lw} = 2 ]; then case $_lw in be|de|ad|ab|fa) ;; *) _spell=1 ;; esac; fi
                   if [ "$_spell" = 1 ]; then
                       _hs=$_lw
                       while [ -n "$_hs" ]; do
                           _hc=${_hs%"${_hs#?}"}; _hs=${_hs#?}
                           case $_hc in a) _hc=A ;; b) _hc=B ;; c) _hc=C ;; d) _hc=D ;; e) _hc=E ;; f) _hc=F ;; esac
                           _sw="$_sw${_sw:+ }$_hc"
                       done
                   fi ;;
            esac
        fi
        if [ -z "$_sw" ]; then
            case $_w in
                *[$LOWER]*[$UPPER]*) case $_w in *[!$LOWER$UPPER]*) ;; *)   # CamelCase, letters only
                    _cs=$_w; _pc=""; _cw=""
                    while [ -n "$_cs" ]; do
                        _cc=${_cs%"${_cs#?}"}; _cs=${_cs#?}
                        case $_pc$_cc in [$LOWER][$UPPER]) _cw="$_cw " ;; esac
                        _cw="$_cw$_cc"; _pc=$_cc
                    done
                    _sw=$_cw ;; esac ;;
            esac
        fi
        [ -n "$_sw" ] || _sw=$_w
        _sout="$_sout${_sout:+ }$_sw$_tp"
    done
    set +f; IFS=$_oifs
    printf '%s' "$_sout"
}
# empty output = clock unavailable (caller then skips quiet hours). Midnight "00" -> "0".
hour_now() { h=$(date +%H 2>/dev/null); case $h in ??) h=${h#0} ;; esac; printf '%s' "$h"; }

# ---------- presets -----------------------------------------------------------
# preset_events <preset>  -> space-separated list of events that speak
preset_events() {
    case "$1" in
        basic)    echo "Stop idle_prompt" ;;
        verbose)  echo "Stop StopFailure PermissionRequest idle_prompt agent_completed SubagentStop SessionEnd StepDone Scheduled Remind WelcomeBack" ;;
        off)      echo "" ;;
        *)        echo "Stop StopFailure PermissionRequest idle_prompt Remind WelcomeBack" ;;   # standard
    esac
}
preset_min_turn() { case "$1" in standard) echo 30 ;; *) echo 0 ;; esac; }

# ---------- speaking backends -------------------------------------------------
speak() {
    text=$(clean "$(sayable "$1")")
    cfgv vol volume 100; cfgv rate rate 0; cfgv voice voice ""
    # config values are interpolated into the speech command: keep them boring. Voice
    # names need ( ) too: macOS lists its clearer voices as "Eddy (English (US))" and
    # downloaded ones as "Samantha (Enhanced)"; parentheses are inert inside the
    # single-quoted PowerShell string and the quoted say argument.
    case $vol in ''|*[!0-9]*) vol=100 ;; esac
    case $rate in ''|-) rate=0 ;; -[0-9]*|[0-9]*) case ${rate#-} in *[!0-9]*) rate=0 ;; esac ;; *) rate=0 ;; esac
    case $voice in *[!A-Za-z0-9\ ._\(\)-]*) voice="" ;; esac
    case "$(os)" in
        win)
            # Speech runs through a small PowerShell file so it can watch the microphone:
            # Windows keeps a per-app record of mic use for its privacy indicator, and while
            # an app holds the mic (dictation such as Wispr Flow or voice typing, a call)
            # LastUsedTimeStop is 0. An announcement spoken then lands in the transcript, so
            # with mic_aware the speaker waits up to mic_wait seconds for the mic to close,
            # and if it opens mid-sentence it stops and says the line again afterwards.
            # This runs in the detached speaker, never on the hook path.
            cfgv mic_aware mic_aware true; cfgv mic_wait mic_wait 30
            case $mic_wait in ''|*[!0-9]*) mic_wait=30 ;; esac
            [ -d "$STATE" ] || mkdir -p -m 700 "$STATE" 2>/dev/null
            cat > "$STATE/speak.ps1.$$" <<'EOF'
# iriscale voice speaker (Windows) - rewritten by bin/iriscale-voice before each announcement.
param([string]$Text = '', [int]$Volume = 100, [int]$Rate = 0, [string]$Voice = '', [int]$MicWait = 30,
      [switch]$MicAware, [switch]$Probe,
      [string]$ConsentRoot = 'HKCU:\Software\Microsoft\Windows\CurrentVersion\CapabilityAccessManager\ConsentStore\microphone')
function MicInUse {
  try {
    foreach ($k in (Get-ChildItem -Path $ConsentRoot -Recurse -ErrorAction SilentlyContinue)) {
      $p = Get-ItemProperty -Path $k.PSPath -ErrorAction SilentlyContinue
      if ($null -ne $p.LastUsedTimeStart -and $p.LastUsedTimeStart -gt 0 -and
          ($p.LastUsedTimeStop -eq 0 -or $p.LastUsedTimeStart -gt $p.LastUsedTimeStop)) { return $true }
    }
  } catch {}
  return $false
}
if ($Probe) { if (MicInUse) { 'mic=inuse' } else { 'mic=free' }; exit 0 }
if ($Text -eq '') { exit 0 }
function WaitMic { $w = 0; while ($MicAware -and (MicInUse) -and $w -lt $MicWait) { Start-Sleep -Seconds 1; $w++ } }
Add-Type -AssemblyName System.Speech
$s = New-Object System.Speech.Synthesis.SpeechSynthesizer
$s.Volume = $Volume; $s.Rate = $Rate
if ($Voice) { try { $s.SelectVoice($Voice) } catch {} }
WaitMic
$attempt = 0
do {
  $attempt++; $cut = $false
  $prompt = $s.SpeakAsync($Text)
  while (-not $prompt.IsCompleted) {
    Start-Sleep -Milliseconds 500
    if ($MicAware -and (MicInUse)) { $s.SpeakAsyncCancelAll(); $cut = $true; break }
  }
  if ($cut) { Start-Sleep -Seconds 1; WaitMic; Start-Sleep -Milliseconds 400 }
} while ($cut -and $attempt -lt 3)
$s.Dispose()
EOF
            mv -f "$STATE/speak.ps1.$$" "$STATE/speak.ps1" 2>/dev/null
            _mic=""; [ "$mic_aware" = true ] && _mic=-MicAware
            powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$STATE/speak.ps1" -Voice "$voice" -Volume "$vol" -Rate "$rate" -MicWait "$mic_wait" $_mic -Text "$text" >/dev/null 2>&1 ;;
        mac)
            # say: rate is words/min (default ~175); map our -10..10 onto 120..300
            wpm=$((175 + rate * 12))
            if [ -n "$voice" ]; then say -v "$voice" -r "$wpm" "$text" 2>/dev/null
            else say -r "$wpm" "$text" 2>/dev/null; fi ;;
        *)
            if command -v spd-say >/dev/null 2>&1; then spd-say -w -r "$((rate * 10))" "$text" 2>/dev/null
            elif command -v espeak-ng >/dev/null 2>&1; then espeak-ng "$text" 2>/dev/null
            elif command -v espeak >/dev/null 2>&1; then espeak "$text" 2>/dev/null
            elif command -v notify-send >/dev/null 2>&1; then notify-send "iriscale voice" "$text" 2>/dev/null
            else printf '\a'; fi ;;
    esac
}

# serialize across concurrent sessions so two announcements never overlap.
# mkdir is atomic everywhere; flock isn't on macOS.
with_lock() {
    lock="$STATE/speak.lock"; i=0
    while ! mkdir "$lock" 2>/dev/null; do
        # stale lock (a killed speaker) is stolen once it is over a minute old; after
        # ~20 s of waiting we give up on the queue and speak anyway (an overlap beats a
        # lost announcement).
        if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rmdir "$lock" 2>/dev/null; continue; fi
        i=$((i+1)); [ "$i" -gt 40 ] && break; sleep 0.5
    done
    "$@"
    rmdir "$lock" 2>/dev/null
}

# ---------- CLI ---------------------------------------------------------------
# All settings, with their default and one-line meaning. Single source of truth for
# `config list`, `config get`, and `--help`; docs/CONFIG.md mirrors it.
#   key | default | description
settings_table() {
    p=$(cfg preset standard)
    cat <<EOF
preset|standard|off, basic, standard, verbose — how much gets spoken
enabled|true|false = silent (\`mute\` / \`unmute\`)
event.<Event>|(preset)|on/off — override one event regardless of preset (see \`events\`)
quiet_hours|(none)|22-8 style, 24h, may wrap midnight; nothing speaks inside the window
min_turn_seconds|$(preset_min_turn "$p")|don't say "done" for turns shorter than this; errors and permission prompts still speak
say_elapsed|true|append "after N minutes" to "done" for turns of 60s or more
command_detail|redacted|what a permission prompt says about the command: redacted = up to 60 chars with credential-looking words scrubbed; program = program + first word only ("git push"); full = verbatim
repeat_cooldown|60|seconds; identical line for the same session inside the window is said once; 0 disables
remind_answer|$(preset_remind "$p" answer)|minutes after a permission prompt to say "still needs your answer" (comma list); off = never. standard 3,10 · verbose 3,10,20 · basic never
remind_review|$(preset_remind "$p" review)|minutes after a turn ends to remind about an unreviewed session; off = never. standard 15 · verbose 10,30
remind_action|$(preset_remind "$p" action)|minutes after an error to remind; off = never. standard 10 · verbose 10
remind_pause|2|skip a reminder (it still counts) if you sent a prompt anywhere within this many minutes
welcome_back|10|after this many quiet minutes, your next prompt is preceded by "while you were away: ..."; 0 = off
mute_sessions|(none)|comma-separated session names to never announce
only_sessions|(none = all)|comma-separated; if set, announce ONLY these
voice|(OS default)|a name from \`iriscale-voice voices\` (macOS: say -v ?; Windows: SAPI); Linux: ignored
pronounce|(none)|how to say words the synthesizer gets wrong: word=spoken pairs, comma-separated, whole word, any case (iriscale=eye riss scale,naro=nah row)
rate|0|speaking speed, -10 slow .. 10 fast
volume|100|0-100 (Windows only; others use system volume)
mic_aware|true|Windows: hold an announcement while any app has the microphone open (dictation, a call); if it opens mid-sentence, stop and say the line again after
mic_wait|30|seconds to wait for the microphone to close before speaking anyway
serialize|true|queue announcements so concurrent sessions never overlap
log|$CLAUDE_DIR/iriscale-voice.log|tab-separated activity log; \`none\` disables
board_hide_hours|24|a session with no process and no event for this long is forgotten (Codex records no pid)
board_interval|30|seconds between board heartbeats (ages tick); state changes redraw immediately
board_autostart|false|true = whenever a session event arrives and no board window is open, open one (own terminal window, off to the side)
board_window|84,20|board window size as columns,rows (Windows Terminal)
board_window_pos|1100,80|board window position as x,y pixels (Windows Terminal)
EOF
}
events_table() {
    cat <<'EOF'
Stop|turn finished|"<session> done" (+ "after N minutes")
StopFailure|turn died: rate limit, billing, auth, server|"<session> stopped: rate limit"
PermissionRequest|Claude asks to run a tool|"<session> is waiting for your answer to run git push"
idle_prompt|Claude has been waiting for your input|"<session> is waiting for you"
agent_completed|a background agent finished|"<session> agent finished"
SubagentStop|a subagent stopped|"<session> sub agent done"
StepDone|turn paused: background agents or tasks still running, Claude wakes itself|"<session> finished a step, 1 agent still running"
Scheduled|turn paused until a /loop or scheduled wake-up|"<session> paused until its next wake-up"
SessionEnd|session closed|"<session> session ended"
Remind|a session has needed you for a while (remind_answer / remind_review / remind_action)|"<session> still needs your answer, 10 minutes"
WelcomeBack|your first prompt after welcome_back quiet minutes, if anything waits|"while you were away: payments needs your answer, billing ready for review"
stamp|(internal) marks turn start for min_turn_seconds|—
resume|(internal) a tool ran, so the dialog you were asked about is answered: clears "needs your answer" and its reminders|—
EOF
}
usage() {
    cat <<EOF
iriscale-voice $VERSION — let your coding agents tell you when they are done and need attention.

USAGE
  iriscale-voice <COMMAND> [ARGS]
  iriscale-voice <EVENT>  < payload.json        (how the hooks call it)

COMMANDS
  status                 what's configured and what will speak
  test [--fix]           speak a test phrase; on Windows also reads PowerShell's level in the
                         Volume Mixer (0% there = silent everywhere); --fix sets it to 100%
  say <text>             speak arbitrary text
  speaker [<name>]       who talks: no argument shows the voices worth using (--all for
                         every one), a name sets it and speaks a sample, \`default\` restores
                         the system voice                         (alias: voices = the list)
  mute | unmute          silence / restore (sets enabled=false/true)
  config list            every setting: key, current value, default, meaning
  config get <key>       print one setting's current value
  config set <key> <v>   set one setting   (alias: set <key> <v>)
  config unset <key>     remove a setting, back to preset/default
  config path            print the config file path
  config edit            open the config file in \$EDITOR
  sessions [--plain]     every live session: state, how long, what was last said
  board [--interval N]   the same, live; redraws only on change; click a row or press
                         its number to bring that session's window to the front; q quits
                         (--once prints one frame; --open starts it in its own window)
  focus <n|name|pid>     bring a session's window (or its host IDE/terminal) to the front
  forget <name|--all>    drop a session from the board now (it returns on its next event)
  review-window [N|default]  how long after a turn ends a keypress there still marks it reviewed
                         (sets Claude Code's idle window in settings.json; 10 minutes recommended)
                         (Windows; Linux with wmctrl; not yet on macOS)
  install codex          print Codex config snippets with absolute paths
  install codex --apply  install script, PATH, skill, notify and hooks (Windows; on
                         macOS/Linux: npx @iriscale/voice@latest install codex --apply)
                         npm also installs Claude Code without the plugin:
                         npx @iriscale/voice@latest install claude --apply
  doctor codex           diagnose Codex notify and hook configuration
                         (npm also: doctor claude)
  completions <shell>    print completion for powershell, bash, or zsh
  update                 install the latest release (Windows; npm installs own their own)
  uninstall codex        remove the install and the Codex config it owns
                         (npm installs own this: uninstall codex | uninstall claude)
  presets                the four presets and what each speaks
  events                 every event, when it fires, what it says
  help, -h, --help       this text          -V, --version   print version

ENVIRONMENT
  IRISCALE_VOICE_OFF=1        mute everything, no file edits
  IRISCALE_VOICE_DEBUG=1      print the decision instead of speaking
  CLAUDE_CONFIG_DIR           where the config lives (default ~/.claude)

FILES
  $CONF
  $(cfg log "$CLAUDE_DIR/iriscale-voice.log")

Inside Claude Code: /iriscale-voice:<command>  (type /iriscale-voice: and autocomplete lists them).
Docs: https://github.com/justbuild-it/iriscale_voice
EOF
}
cli_status() {
    p=$(cfg preset standard)
    echo "iriscale-voice $VERSION"
    echo "  config:   $CONF $( [ -f "$CONF" ] && echo '' || echo '(not created yet - using defaults)')"
    echo "  enabled:  $(cfg enabled true)   preset: $p   speaks on: $(preset_events "$p")"
    echo "  quiet:    $(cfg quiet_hours none)   min_turn: $(cfg min_turn_seconds "$(preset_min_turn "$p")")s   cooldown: $(cfg repeat_cooldown 60)s"
    echo "  review:   a key pressed in a session within $(idle_window_label) of its turn ending marks it reviewed"
    [ "$(idle_window_label)" = 60s ] && echo "            60 s is Claude Code's default and too short if you let a finished session sit: run /iriscale-voice:review-window 10"
    echo "  muted:    $(cfg mute_sessions none)   only: $(cfg only_sessions all)"
    echo "  voice:    $(cfg voice default)   volume: $(cfg volume 100)   rate: $(cfg rate 0)   os: $(os)"
    echo "  log:      $(cfg log "$CLAUDE_DIR/iriscale-voice.log")"
    ov=$( [ -f "$CONF" ] && grep '^event\.' "$CONF" | grep -v '=$' | tr '\n' ' ' )
    [ -n "$ov" ] && echo "  overrides: $ov"
    return 0
}
cli_config() {
    sub="$1"; shift
    case "$sub" in
        list|ls|"")
            printf '%-18s %-26s %-22s %s\n' KEY CURRENT DEFAULT MEANING
            settings_table | while IFS='|' read -r k d m; do
                case "$k" in "event.<Event>") cur=$( [ -f "$CONF" ] && grep '^event\.' "$CONF" | grep -v '=$' | tr '\n' ' ' ); [ -z "$cur" ] && cur="(none)";;
                             *) cur=$(cfg "$k" ""); [ -z "$cur" ] && cur="(default)";; esac
                printf '%-18s %-26s %-22s %s\n' "$k" "$cur" "$d" "$m"
            done
            echo; echo "file: $CONF"; [ -f "$CONF" ] || echo "(not created yet)"
            ;;
        get)   [ -n "$1" ] || { echo "usage: iriscale-voice config get <key>" >&2; return 2; }
               v=$(cfg "$1" ""); if [ -n "$v" ]; then echo "$v"; else echo "(unset - using default)"; fi ;;
        set)   [ -n "$1" ] || { echo "usage: iriscale-voice config set <key> <value>" >&2; return 2; }
               cfg_set "$1" "$2" || return $?; echo "$1=$2" ;;
        unset|rm) [ -n "$1" ] || { echo "usage: iriscale-voice config unset <key>" >&2; return 2; }
               [ -f "$CONF" ] && { sed "/^[[:space:]]*$1[[:space:]]*=/d" "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"; }
               echo "unset $1" ;;
        path)  echo "$CONF" ;;
        edit)  [ -f "$CONF" ] || : > "$CONF"; "${EDITOR:-vi}" "$CONF" ;;
        *)     echo "unknown: config $sub  (try: list, get, set, unset, path, edit)" >&2; return 2 ;;
    esac
}

# Where this script really lives, following one symlink: the npm installer links
# ~/.local/bin/iriscale-voice -> <root>/bin/iriscale-voice, and taking dirname of the LINK
# would give ~/.local/bin, which is why this used to hunt for ~/.local/install.ps1.
self_root() {
    case $0 in */*) _inv=$0 ;; *) _inv=$(command -v "$0" 2>/dev/null) ;; esac
    [ -n "$_inv" ] || return 1
    if [ -L "$_inv" ]; then
        _t=$(readlink "$_inv" 2>/dev/null)
        case $_t in
            /*) _inv=$_t ;;
            ?*) _inv=$(dirname -- "$_inv")/$_t ;;
        esac
    fi
    _d=$(CDPATH= cd -- "$(dirname -- "$_inv")" 2>/dev/null && pwd -P) || return 1
    printf '%s' "${_d%/bin}"
}

# Did the npm package install this copy? Its marker says so, and that decides who owns
# the lifecycle verbs. Zero dependencies: a grep, not a JSON parser.
npm_installed() {
    _r=$(self_root) || return 1
    [ -f "$_r/install.json" ] || return 1
    grep -q '"installer"[[:space:]]*:[[:space:]]*"npm"' "$_r/install.json" 2>/dev/null
}

# A verb the npm package owns and this script cannot perform. Name the exact command
# instead of failing with something about PowerShell.
npm_only() {
    echo "this copy was installed by the npm package, which owns '$*'." >&2
    echo "run:  npx @iriscale/voice@latest $*" >&2
    echo "      (already installed globally? npm exec -- @iriscale/voice $*)" >&2
    return 2
}

cli_install() {
    agent=$1
    [ "$agent" = claude ] && { npm_only install claude --apply; return $?; }
    [ "$agent" = codex ] || {
        echo "usage: iriscale-voice install codex" >&2
        return 2
    }

    if [ "${2:-}" = "--apply" ]; then
        # --apply here is the PowerShell installer. The npm one does the same job on
        # every OS in node, so that is what we point at when this path is unavailable.
        npm_installed && { npm_only install codex --apply; return $?; }
        npx_hint="run instead: npx @iriscale/voice@latest install codex --apply"
        [ "$(os)" = win ] || { echo "--apply needs PowerShell; $npx_hint" >&2; return 1; }
        case $0 in */*) invoked=$0 ;; *) invoked=$(command -v "$0") ;; esac
        script_dir=$(CDPATH= cd -- "$(dirname -- "$invoked")" 2>/dev/null && pwd -P)
        installer="$script_dir/../install.ps1"
        [ -f "$installer" ] || installer="$script_dir/install.ps1"
        [ -f "$installer" ] || { echo "install.ps1 not found next to iriscale-voice; $npx_hint" >&2; return 1; }
        command -v powershell.exe >/dev/null 2>&1 || { echo "PowerShell is required for --apply; $npx_hint" >&2; return 1; }
        source_root=$(CDPATH= cd -- "$script_dir/.." 2>/dev/null && pwd -P)
        powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$installer" -SourcePath "$source_root"
        return $?
    fi

    case $0 in */*) invoked=$0 ;; *) invoked=$(command -v "$0") ;; esac
    script_dir=$(CDPATH= cd -- "$(dirname -- "$invoked")" 2>/dev/null && pwd -P)
    script_path="$script_dir/$(basename -- "$invoked")"
    shell_path=$(command -v sh)

    if [ "$(os)" = win ] && command -v cygpath >/dev/null 2>&1; then
        script_path=$(cygpath -m "$script_path")
        shell_path=$(cygpath -m "$shell_path")
        # `command -v sh` resolves to Git's RAW MSYS shell (…/Git/usr/bin/sh.exe).
        # Launched directly from a Windows process it does not put /usr/bin on PATH,
        # so date/uname/mkdir/tr are all missing and hooks fail with
        # "date: command not found". The …/Git/bin/sh.exe WRAPPER sets PATH up;
        # always prefer it when it exists.
        case $shell_path in
            */usr/bin/sh.exe)
                wrapper="${shell_path%/usr/bin/sh.exe}/bin/sh.exe"
                [ -f "$wrapper" ] && shell_path=$wrapper ;;
        esac
        cat <<EOF
# Basic — add at the top of ~/.codex/config.toml
notify = ["$shell_path", "$script_path", "notify"]

# Full (optional) — save as ~/.codex/hooks.json; in /hooks verify Installed=1, then trust
{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" stamp",
        "commandWindows": "\"$shell_path\" \"$script_path\" stamp",
        "timeout": 10 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" PermissionRequest",
        "commandWindows": "\"$shell_path\" \"$script_path\" PermissionRequest",
        "timeout": 30 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" resume",
        "commandWindows": "\"$shell_path\" \"$script_path\" resume",
        "timeout": 10 } ] }
    ]
  }
}
EOF
    else
        cat <<EOF
# Basic — add at the top of ~/.codex/config.toml
notify = ["$script_path", "notify"]

# Full (optional) — save as ~/.codex/hooks.json; in /hooks verify Installed=1, then trust
{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" stamp",
        "timeout": 10 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" PermissionRequest",
        "timeout": 30 } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" resume",
        "timeout": 10 } ] }
    ]
  }
}
EOF
    fi
}

cli_completions() {
    case ${1:-} in
        powershell|pwsh)
            cat <<'EOF'
Register-ArgumentCompleter -Native -CommandName iriscale-voice -ScriptBlock {
  param($wordToComplete, $commandAst, $cursorPosition)
  $elements = @($commandAst.CommandElements | ForEach-Object { $_.Extent.Text })
  $argument = $elements.Count - 1
  if ($commandAst.Extent.Text -match '\s$') { $argument++ }
  if ($argument -le 1) {
    $choices = 'status','sessions','board','focus','test','say','speaker','voices','mute','unmute','config','install','doctor','presets','events','completions','update','uninstall','help'
  } else {
    $choices = switch ($elements[1]) {
      'config' { 'list','get','set','unset','path','edit' }
      { $_ -in 'install','doctor','uninstall' } { 'codex' }
      'completions' { 'powershell','bash','zsh' }
    }
  }
  $choices |
    Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
      [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
    }
}
EOF
            ;;
        bash)
            cat <<'EOF'
_iriscale_voice() {
  if [ "$COMP_CWORD" -eq 1 ]; then
    choices='status sessions board focus test say mute unmute config install doctor presets events completions update uninstall help'
  else
    case ${COMP_WORDS[1]} in
      config) choices='list get set unset path edit' ;;
      install|doctor|uninstall) choices='codex' ;;
      completions) choices='powershell bash zsh' ;;
    esac
  fi
  COMPREPLY=( $(compgen -W "$choices" -- "${COMP_WORDS[COMP_CWORD]}") )
}
complete -F _iriscale_voice iriscale-voice
EOF
            ;;
        zsh)
            cat <<'EOF'
#compdef iriscale-voice
_arguments '1:command:(status sessions board focus test say mute unmute config install doctor presets events completions update uninstall help)'
EOF
            ;;
        *) echo "usage: iriscale-voice completions <powershell|bash|zsh>" >&2; return 2 ;;
    esac
}

# ---------- test (with the Windows Volume Mixer check) ------------------------
# Windows keeps a volume level per application in the Volume Mixer, and every
# announcement is spoken by powershell.exe - so if that slider is at 0% (one stray
# drag while an announcement is showing in the mixer) the plugin goes silent in every
# session while the speech engine still reports success. `test` speaks through a
# PowerShell that reads its own session level while it talks; `--fix` sets it to 100%.
mixer_verdict() {   # mixer_verdict "app=0 appmuted=False master=50 mastermuted=False fixed=False"
    _app=""; _am=""; _mv=""; _mm=""; _fx=""
    for _kv in $1; do case $_kv in app=*) _app=${_kv#app=} ;; appmuted=*) _am=${_kv#appmuted=} ;; master=*) _mv=${_kv#master=} ;;
                                   mastermuted=*) _mm=${_kv#mastermuted=} ;; fixed=*) _fx=${_kv#fixed=} ;; esac; done
    [ "$_fx" = True ] && echo "  restored Windows PowerShell to 100% in the Volume Mixer"
    if [ "$_am" = True ]; then
        echo "  WARNING: Windows PowerShell is muted in the Volume Mixer, so every announcement is silent. Run: iriscale-voice test --fix"
    elif [ "$_app" = 0 ]; then
        echo "  WARNING: Windows PowerShell is at 0% in the Volume Mixer, so every announcement is silent. Run: iriscale-voice test --fix"
    elif [ -n "$_app" ] && [ "$_app" != "?" ] && [ "$_app" -lt 30 ] 2>/dev/null; then
        echo "  note: Windows PowerShell is at ${_app}% in the Volume Mixer (Settings > System > Sound > Volume mixer); test --fix sets 100%"
    fi
    if [ "$_mm" = True ]; then echo "  WARNING: the output device is muted"
    elif [ "$_mv" = 0 ]; then echo "  WARNING: the output device volume is 0"; fi
    return 0
}
# The voices worth suggesting. macOS installs about forty English ones, but most are
# novelty toys (Bells, Boing, Bubbles, Jester, Zarvox...) or the 1980s formant voices
# (Albert, Fred, Ralph, Kathy); listing all of them makes choosing harder, not easier. So
# the default output is this shortlist filtered to what is actually installed, and
# `speaker --all` still prints every one. Matched on the name before any " (English (…))".
SPEAKER_PICKS="Samantha|Alex|Ava|Allison|Susan|Tom|Nicky|Daniel|Kate|Oliver|Serena|Fiona|Karen|Lee|Moira|Tessa|Rishi|Tara|Aman|Veena"

# the voices this machine can name, and where clearer ones come from.
cli_speaker_list() {
    _all=0; case ${1:-} in --all|-a|all) _all=1 ;; esac
    cfgv cur voice ""
    echo "current voice: ${cur:-(system default)}"
    case "$(os)" in
        mac)
            if [ "$_all" = 1 ]; then echo "every English voice installed (say -v ?):"
            else echo "voices worth using (of the ones installed):"; fi
            _vl=$(say -v '?' 2>/dev/null)
            _seen="|"; _tot=0; _shown=0; _rest="$_vl$NL"
            while [ -n "$_rest" ]; do
                _line=${_rest%%"$NL"*}; _rest=${_rest#*"$NL"}
                case $_line in *" en_"*) ;; *) continue ;; esac
                _vn=${_line%% en_*}
                while case $_vn in *' '|*"	") true ;; *) false ;; esac; do _vn=${_vn%?}; done
                # macOS lists some voices twice (the plain one and its Siri variant)
                case $_seen in *"|$_vn|"*) continue ;; esac
                _seen="$_seen$_vn|"; _tot=$((_tot+1))
                if [ "$_all" = 0 ]; then
                    _base=${_vn%% (*}
                    case "|$SPEAKER_PICKS|" in *"|$_base|"*) ;; *) continue ;; esac
                fi
                _vc=${_line#*" en_"}
                _shown=$((_shown+1)); printf '  %-26s en_%s\n' "$_vn" "${_vc%%[ 	]*}"
            done
            [ "$_shown" -gt 0 ] || echo "  (none of the usual voices are installed - run: iriscale-voice speaker --all)"
            # every line stays inside 80 columns: this is read in a terminal pane and
            # pasted into chat windows that do not wrap. A test asserts it.
            echo
            echo "  set one:   iriscale-voice speaker \"Samantha\"   (quote if it has spaces)"
            if [ "$_all" = 0 ] && [ "$_tot" -gt "$_shown" ]; then
                echo "  every one: iriscale-voice speaker --all     ($_tot installed, most are toys)"
            fi
            echo "  clearer:   System Settings > Accessibility > Spoken Content >"
            echo "             System Voice > Manage Voices, then download an (Enhanced)"
            echo "             or (Premium) voice; it appears above under that name." ;;
        win)
            echo "SAPI voices installed:"
            powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \
                "Add-Type -AssemblyName System.Speech; (New-Object System.Speech.Synthesis.SpeechSynthesizer).GetInstalledVoices() | ForEach-Object { '  ' + \$_.VoiceInfo.Name + '   ' + \$_.VoiceInfo.Culture }" 2>/dev/null | tr -d '\r'
            echo
            echo "  set one:   iriscale-voice speaker \"Microsoft Zira Desktop\""
            echo "  clearer:   Settings > Time & Language > Speech > Manage voices." ;;
        *)
            if command -v spd-say >/dev/null 2>&1; then echo "speech-dispatcher voices (spd-say -L):"; spd-say -L 2>/dev/null | sed 's/^/  /'
            elif command -v espeak-ng >/dev/null 2>&1; then echo "espeak-ng English voices:"; espeak-ng --voices=en 2>/dev/null | sed 's/^/  /'
            else echo "no speech backend found (install speech-dispatcher or espeak-ng)"; fi
            echo
            echo "  the voice is chosen in spd-conf / espeak-ng itself, not here." ;;
    esac
}

# speaker [name|default]: who does the talking. No argument lists what you can pick; a
# name sets it and speaks a sample so you hear the difference at once; `default` returns
# to the system voice. (It sets the `voice` config key - the setting keeps its own name.)
cli_speaker() {
    [ $# -gt 0 ] || { cli_speaker_list; return 0; }
    case $1 in --all|-a) cli_speaker_list --all; return 0 ;; esac
    _vn=$*
    case $_vn in
        default|system|unset|off) cli_config unset voice; return $? ;;
        *[!A-Za-z0-9\ ._\(\)-]*) echo "voice names may only contain letters, digits, spaces, . _ - ( )" >&2; return 2 ;;
    esac
    if [ "$(os)" = mac ]; then
        # refuse a name say does not know - it would fail silently on every announcement
        _vl=$(say -v '?' 2>/dev/null); _hit=""
        if [ -n "$_vl" ]; then
            _rest="$_vl$NL"
            while [ -n "$_rest" ]; do _l=${_rest%%"$NL"*}; _rest=${_rest#*"$NL"}; case $_l in "$_vn "*) _hit=1; break ;; esac; done
            [ -n "$_hit" ] || { echo "no voice called \"$_vn\" is installed - run: iriscale-voice speaker" >&2; return 2; }
        fi
    fi
    cfg_set voice "$_vn" || return $?
    echo "voice=$_vn"
    cfgv enabled enabled true
    if [ -n "$IRISCALE_VOICE_OFF" ] || [ "$enabled" != "true" ]; then echo "(muted - not speaking a sample)"; return 0; fi
    speak "iriscale voice now sounds like this" || { echo "speech backend failed; check the selected voice and audio output" >&2; return 1; }
    echo "spoke a sample; to go back: iriscale-voice speaker default"
}

cli_test() {
    fixarg=""; for _a in "$@"; do case $_a in --fix) fixarg=-Fix ;; esac; done
    # honour mute: `test` used to call the speech backend unconditionally (PR #25)
    cfgv enabled enabled true
    if [ -n "$IRISCALE_VOICE_OFF" ] || [ "$enabled" != "true" ]; then
        echo "muted - not speaking. Run 'unmute' first, or 'say <text>' to force speech while muted."; return 0
    fi
    text="iriscale voice is working"
    if [ "$(os)" != win ]; then
        speak "$text" || { echo "speech backend failed; check the selected voice and audio output" >&2; return 1; }
        echo "spoke a test phrase via $(os) backend"; return 0
    fi
    cfgv vol volume 100; cfgv rate rate 0; cfgv voice voice ""
    case $vol in ''|*[!0-9]*) vol=100 ;; esac
    case $rate in ''|-) rate=0 ;; -[0-9]*|[0-9]*) case ${rate#-} in *[!0-9]*) rate=0 ;; esac ;; *) rate=0 ;; esac
    case $voice in *[!A-Za-z0-9\ ._\(\)-]*) voice="" ;; esac
    [ -d "$STATE" ] || mkdir -p -m 700 "$STATE" 2>/dev/null
    cat > "$STATE/mixer.ps1" <<'EOF'
param([string]$Phrase = 'iriscale voice is working', [int]$Volume = 100, [int]$Rate = 0, [string]$Voice = '', [switch]$Fix)
$code = @'
using System; using System.Runtime.InteropServices;
[Guid("A95664D2-9614-4F35-A746-DE8DB63617E6"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
interface IMMDeviceEnumerator { int _0(); int GetDefaultAudioEndpoint(int flow, int role, out IMMDevice d); }
[Guid("D666063F-1587-4E43-81F1-B948E807363F"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
interface IMMDevice { int Activate(ref Guid id, int ctx, IntPtr p, [MarshalAs(UnmanagedType.IUnknown)] out object a); }
[Guid("77AA99A0-1BD6-484F-8BC7-2C654C9A9B6F"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
interface IAudioSessionManager2 { int _0(); int _1(); int GetSessionEnumerator(out IAudioSessionEnumerator e); }
[Guid("E2F5BB11-0570-40CA-ACDD-3AA01277DEE8"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
interface IAudioSessionEnumerator { int GetCount(out int n); int GetSession(int i, out IAudioSessionControl2 s); }
[Guid("BFB7FF88-7239-4FC9-8FA2-07C950BE9C6D"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
interface IAudioSessionControl2 { int GetState(out int s); int _1(); int _2(); int _3(); int _4(); int _5(); int _6(); int _7(); int _8(); int _9(); int _10(); int GetProcessId(out uint pid); }
[Guid("87CE5498-68D6-44E5-9215-6DA47EF883D8"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
interface ISimpleAudioVolume { int SetMasterVolume(float v, ref Guid c); int GetMasterVolume(out float v); int SetMute(bool m, ref Guid c); int GetMute(out bool m); }
[Guid("5CDF2C82-841E-4546-9722-0CF74078229A"), InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
interface IAudioEndpointVolume { int _0(); int _1(); int _2(); int _3(); int _4(); int _5(); int GetMasterVolumeLevelScalar(out float l); int _7(); int _8(); int _9(); int _10(); int _11(); int GetMute(out bool m); }   // vtable: GetMasterVolumeLevelScalar=6, GetMute=12 (SetMute=11)
[ComImport, Guid("BCDE0395-E52F-467C-8E3D-C4579291692E")] class MMDeviceEnumeratorComObject { }
public class Mixer { public static string Report(uint me, bool fix) {
  var e = (IMMDeviceEnumerator)(new MMDeviceEnumeratorComObject()); IMMDevice d; e.GetDefaultAudioEndpoint(0, 1, out d);
  var gv = typeof(IAudioEndpointVolume).GUID; object ov; d.Activate(ref gv, 23, IntPtr.Zero, out ov);
  float ml; ((IAudioEndpointVolume)ov).GetMasterVolumeLevelScalar(out ml); bool mm; ((IAudioEndpointVolume)ov).GetMute(out mm);
  var g = typeof(IAudioSessionManager2).GUID; object o; d.Activate(ref g, 23, IntPtr.Zero, out o);
  IAudioSessionEnumerator en; ((IAudioSessionManager2)o).GetSessionEnumerator(out en); int n; en.GetCount(out n);
  string app = "?"; string am = "?"; string fixed_ = "False";
  for (int i = 0; i < n; i++) { IAudioSessionControl2 s; en.GetSession(i, out s); uint pid; s.GetProcessId(out pid); if (pid != me) continue;
    var sv = (ISimpleAudioVolume)s; float v; sv.GetMasterVolume(out v); bool m; sv.GetMute(out m);
    if (fix && (v < 0.995f || m)) { Guid z = Guid.Empty; sv.SetMasterVolume(1.0f, ref z); sv.SetMute(false, ref z); sv.GetMasterVolume(out v); sv.GetMute(out m); fixed_ = "True"; }
    app = Math.Round(v * 100).ToString(); am = m.ToString(); break; }
  return "app=" + app + " appmuted=" + am + " master=" + Math.Round(ml * 100) + " mastermuted=" + mm + " fixed=" + fixed_; } }
'@
$report = 'app=? appmuted=? master=? mastermuted=? fixed=False'
try {
    Add-Type -AssemblyName System.Speech
    $s = New-Object System.Speech.Synthesis.SpeechSynthesizer
    $s.Volume = $Volume; $s.Rate = $Rate
    if ($Voice) { try { $s.SelectVoice($Voice) } catch {} }
    $null = $s.SpeakAsync($Phrase)
    Start-Sleep -Milliseconds 600
    try { Add-Type -TypeDefinition $code -ErrorAction Stop; $report = [Mixer]::Report([uint32]$PID, [bool]$Fix) } catch {}
    $waited = 0
    while ($s.State -ne 'Ready' -and $waited -lt 150) { Start-Sleep -Milliseconds 100; $waited++ }
    $s.Dispose()
} catch {}
Write-Output $report
EOF
    rep=$(powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$STATE/mixer.ps1" -Phrase "$text" -Volume "$vol" -Rate "$rate" -Voice "$voice" $fixarg 2>/dev/null | tr -d '\r')
    case $rep in
        app=*) echo "spoke a test phrase via win backend"; mixer_verdict "$rep" ;;
        *)     speak "$text"; echo "spoke a test phrase via win backend (Volume Mixer check unavailable)" ;;
    esac
    return 0
}

cli_windows_lifecycle() {
    action=$1
    # An npm install owns update and uninstall: the node CLI knows which agents are
    # configured and how to reverse each. Say so, rather than reporting a missing
    # install.ps1 on a machine that never had one.
    # `update` takes no agent; `uninstall` does. Name the verb exactly as it is typed.
    npm_installed && {
        case $action in
            uninstall) npm_only uninstall "${2:-codex}" ;;
            *)         npm_only "$action" ;;
        esac
        return $?
    }
    case $0 in */*) invoked=$0 ;; *) invoked=$(command -v "$0") ;; esac
    script_dir=$(CDPATH= cd -- "$(dirname -- "$invoked")" 2>/dev/null && pwd -P)
    installer="$script_dir/../install.ps1"; [ -f "$installer" ] || installer="$script_dir/install.ps1"
    hint="installed with npm? use the iriscale-voice on your PATH, or: npx @iriscale/voice@latest install codex --apply"
    [ -f "$installer" ] || { echo "installed install.ps1 not found; $hint" >&2; return 1; }
    command -v powershell.exe >/dev/null 2>&1 || { echo "PowerShell is required; $hint" >&2; return 1; }
    case $action in
        # Detached: this script is the file the installer must replace, and bash keeps
        # it open while running - Windows refuses to overwrite an open file, so an
        # inline update always failed with "being used by another process". Let the
        # launcher exit first, then run the installer; it logs to $STATE.
        update)    ( sleep 1; powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$installer" -Update > "$STATE/update.log" 2>&1 ) </dev/null >/dev/null 2>&1 &
                   echo "updating in the background; in a few seconds run: iriscale-voice --version   (log: $STATE/update.log)" ;;
        uninstall) ( sleep 1; powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$installer" -Uninstall > "$STATE/uninstall.log" 2>&1 ) </dev/null >/dev/null 2>&1 &
                   echo "uninstalling in the background (log: $STATE/uninstall.log)" ;;
    esac
}

# ---------- review lifecycle (passive) ----------------------------------------
# Nothing here asks the user to click or acknowledge anything. Claude Code's idle
# notice fires 60 s (messageIdleNotifThresholdMs) after a turn ends only if no key was
# pressed in that session - focus and mouse do not count. So: a READY Claude session
# that outlives that window without an idle_prompt was reviewed; one that gets the
# notice needs your review. Reminders come from a detached watcher per session-turn,
# merged into one line when several are due, skipped while you are active elsewhere,
# and capped by the schedule (remind_answer / remind_review / remind_action).
st_get() {   # st_get <state-file> <key>
    _v=""
    [ -f "$1" ] && while IFS= read -r _l || [ -n "$_l" ]; do case $_l in "$2="*) _v=${_l#"$2="} ;; esac; done < "$1"
    printf '%s' "$_v"
}
st_put() {   # st_put <state-file> <key> <value>  (builtins; adds the key if missing)
    [ -f "$1" ] || return 1
    _out=""; _seen=0
    while IFS= read -r _l || [ -n "$_l" ]; do
        case $_l in "$2="*) _out="$_out$2=$3$NL"; _seen=1 ;; *) _out="$_out$_l$NL" ;; esac
    done < "$1"
    [ "$_seen" = 1 ] || _out="$_out$2=$3$NL"
    printf '%s' "$_out" > "$1"
}
preset_remind() {   # preset_remind <preset> <answer|review|action> -> minutes, comma list, or ""
    case "$1:$2" in
        verbose:answer)  echo "3,10,20" ;; verbose:review)  echo "10,30" ;; verbose:action)  echo "10" ;;
        standard:answer) echo "3,10" ;;    standard:review) echo "15" ;;    standard:action) echo "10" ;;
        *) echo "" ;;
    esac
}
remind_schedule() {   # remind_schedule <kind> -> minutes list after config (off/none/empty = never)
    cfgv _rp preset standard
    cfgv _rs "remind_$1" "$(preset_remind "$_rp" "$1")"
    case $_rs in off|none|never|false) _rs="" ;; esac
    printf '%s' "$_rs"
}
next_remind() {   # next_remind <kind> <since> <reminded-so-far> -> epoch of the next reminder, or ""
    _sched=$(remind_schedule "$1"); [ -n "$_sched" ] || return 0
    _i=0; _pick=""; _oifs=$IFS; IFS=,; set -f
    for _m in $_sched; do [ "$_i" = "$3" ] && { _pick=$_m; break; }; _i=$((_i+1)); done
    set +f; IFS=$_oifs
    case $_pick in ''|*[!0-9]*) return 0 ;; esac
    printf '%s' $(( $2 + _pick * 60 ))
}
idle_window_label() {   # the window as people read it: "60s", "10m"
    _s=$(( $(idle_window) - 30 ))
    if [ "$_s" -ge 120 ] && [ $(( _s % 60 )) -eq 0 ]; then printf "%sm" $(( _s / 60 )); else printf "%ss" "$_s"; fi
}
idle_window() {   # seconds after a turn end by which Claude's idle notice has fired, plus grace
    _w=60000
    if [ -f "$CLAUDE_DIR/settings.json" ]; then
        _sj=""; while IFS= read -r _l || [ -n "$_l" ]; do _sj="$_sj$_l"; done < "$CLAUDE_DIR/settings.json"
        _t=$(jnum messageIdleNotifThresholdMs "$_sj"); case $_t in ''|*[!0-9]*) ;; *) _w=$_t ;; esac
    fi
    printf '%s' $(( _w / 1000 + 30 ))
}
spoken() {   # '_' and '-' read as spaces
    _o=""; _s=$1
    while [ -n "$_s" ]; do _c=${_s%"${_s#?}"}; _s=${_s#?}; case $_c in _|-) _c=' ' ;; esac; _o="$_o$_c"; done
    printf '%s' "$_o"
}
# pending_kind <status> <agent> -> answer|review|action, or "" when the row is not waiting on you
pending_kind() {
    case $1 in blocked) echo answer ;; error) echo action ;; review|waiting) echo review ;;
                ready) [ "$2" = claude ] || echo review ;; esac   # a Codex READY has no idle notice to graduate it
}
# One line naming every pending row: "<a> needs your answer, <b> ready for review, <c> stopped"
pending_summary() {
    _ps=""
    for _f in "$SESS"/*; do
        [ -f "$_f" ] || continue
        _k=$(pending_kind "$(st_get "$_f" status)" "$(st_get "$_f" agent)"); [ -n "$_k" ] || continue
        _nm=$(spoken "$(st_get "$_f" name)")
        case $_k in answer) _ps="$_ps, $_nm needs your answer" ;; review) _ps="$_ps, $_nm ready for review" ;; action) _ps="$_ps, $_nm stopped" ;; esac
    done
    printf '%s' "${_ps#, }"
}
# tick <sid>: apply the lifecycle to this moment. Idempotent; the watcher calls it at
# the scheduled times, the test suite calls it directly. Speaks through the normal
# event pipeline (Remind) so presets, quiet hours, mutes and the cooldown all apply.
cli_tick() {
    _sf="$SESS/$1"; [ -f "$_sf" ] || return 0
    _now=$(date +%s 2>/dev/null); case $_now in ''|*[!0-9]*) return 0 ;; esac
    _st=$(st_get "$_sf" status); _since=$(st_get "$_sf" since); case $_since in ''|*[!0-9]*) _since=$_now ;; esac
    if [ "$_st" = ready ] && [ "$(st_get "$_sf" agent)" = claude ] && [ $(( _now - _since )) -ge "$(idle_window)" ]; then
        st_put "$_sf" status reviewed; st_put "$_sf" since "$_now"; st_put "$_sf" remind_at ""
        [ -n "$IRISCALE_VOICE_DEBUG" ] && echo "(tick: $1 reviewed - no idle notice inside the window, so a key was pressed there)"
        return 0
    fi
    _due=""; _n=0
    for _f in "$SESS"/*; do
        [ -f "$_f" ] || continue
        _k=$(pending_kind "$(st_get "$_f" status)" "$(st_get "$_f" agent)"); [ -n "$_k" ] || continue
        _ra=$(st_get "$_f" remind_at); case $_ra in ''|*[!0-9]*) continue ;; esac
        [ "$_now" -ge "$_ra" ] || continue
        _rc=$(st_get "$_f" reminded); case $_rc in ''|*[!0-9]*) _rc=0 ;; esac; _rc=$((_rc+1))
        _sn=$(st_get "$_f" since); case $_sn in ''|*[!0-9]*) _sn=$_now ;; esac
        st_put "$_f" reminded "$_rc"; st_put "$_f" remind_at "$(next_remind "$_k" "$_sn" "$_rc")"
        _n=$((_n+1)); _due="$_due|$_k|$(spoken "$(st_get "$_f" name)")|$(( (_now - _sn) / 60 ))"
    done
    [ "$_n" -gt 0 ] || return 0
    cfgv _pause remind_pause 2; _lp=0
    [ -f "$STATE/last_prompt" ] && { IFS= read -r _lp < "$STATE/last_prompt" || :; }; case $_lp in ''|*[!0-9]*) _lp=0 ;; esac
    if [ "$_pause" -gt 0 ] 2>/dev/null && [ $(( _now - _lp )) -lt $(( _pause * 60 )) ]; then
        [ -n "$IRISCALE_VOICE_DEBUG" ] && echo "(tick: reminder skipped, you prompted $(( _now - _lp ))s ago - remind_pause)"
        return 0
    fi
    if [ "$_n" = 1 ]; then
        _d=${_due#|}; _k=${_d%%|*}; _d=${_d#*|}; _nm=${_d%%|*}; _m=${_d#*|}
        case $_k in answer) _line="$_nm still needs your answer, $_m minutes" ;;
                    review) _line="$_nm still ready for review, $_m minutes" ;;
                    action) _line="$_nm still stopped, $_m minutes" ;; esac
    else
        _line="still waiting"; _rest=$_due
        while [ -n "$_rest" ]; do
            _rest=${_rest#|}; _k=${_rest%%|*}; _rest=${_rest#*|}; _nm=${_rest%%|*}; _rest=${_rest#*|}; _rest=${_rest#*[0-9]}; _rest=${_rest#"${_rest%%|*}"}
            case $_k in answer) _line="$_line, $_nm needs your answer" ;; review) _line="$_line, $_nm ready for review" ;; action) _line="$_line, $_nm stopped" ;; esac
        done
        _line=$(printf '%s' "$_line" | sed 's/^still waiting, /still waiting: /')
    fi
    printf '{"session_id":"%s","message":"%s"}' "$1" "$(clean "$_line")" | sh "$0" Remind
}
# watch <sid> <since>: detached by the hook after a turn ends, a permission prompt, or an
# error. Sleeps until the next lifecycle moment and ticks; exits as soon as the session
# moves on (since changes) or nothing more is scheduled. Bounded so it cannot linger.
cli_watch() {
    _wsid=$1; _tok=$2; _wsf="$SESS/$_wsid"; _g=0
    while [ "$_g" -lt 40 ]; do
        _g=$((_g+1))
        [ -f "$_wsf" ] || return 0
        [ "$(st_get "$_wsf" since)" = "$_tok" ] || return 0
        _wnow=$(date +%s 2>/dev/null); case $_wnow in ''|*[!0-9]*) return 0 ;; esac
        _next=""
        if [ "$(st_get "$_wsf" status)" = ready ] && [ "$(st_get "$_wsf" agent)" = claude ]; then _next=$(( _tok + $(idle_window) )); fi
        _ra=$(st_get "$_wsf" remind_at); case $_ra in ''|*[!0-9]*) ;; *) if [ -z "$_next" ] || [ "$_ra" -lt "$_next" ]; then _next=$_ra; fi ;; esac
        [ -n "$_next" ] || return 0
        _d=$(( _next - _wnow )); [ "$_d" -gt 0 ] && sleep "$_d"
        cli_tick "$_wsid" >/dev/null 2>&1
    done
}

# ---------- review-window: set Claude Code's idle window for the user --------------
# The review window is Claude Code's messageIdleNotifThresholdMs in ~/.claude/settings.json.
# Its 60 s default is too short for this plugin's "reviewed" inference, and nobody should
# have to hand-edit JSON to use a notifier. This edits the file for them: a backup first,
# node or python3 for the JSON when present (they keep every other key exactly), and a
# careful text edit of the top-level object otherwise, validated afterwards when any
# validator exists. The plugin cannot ship this setting itself; the npm installer sets it
# too (only when absent, never over a value you chose).
json_validate() {   # json_validate <file>: 0 valid, 1 invalid, 2 no validator here
    if command -v node >/dev/null 2>&1; then node -e 'JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"))' "$1" >/dev/null 2>&1; return $?
    elif command -v python3 >/dev/null 2>&1; then python3 -c 'import json,sys; json.load(open(sys.argv[1], encoding="utf-8"))' "$1" >/dev/null 2>&1; return $?
    fi
    return 2
}
cli_review_window() {
    _sf="$CLAUDE_DIR/settings.json"
    case ${1:-} in
        '')  echo "review window: a key pressed in a session within $(idle_window_label) of its turn ending marks it reviewed"
             echo "  (Claude Code messageIdleNotifThresholdMs in $_sf)"
             [ "$(idle_window_label)" = 60s ] && echo "  60 s is Claude Code's default and too short if you let a finished session sit; run: iriscale-voice review-window 10"
             return 0 ;;
        default) _ms=60000 ;;
        *[!0-9]*) echo "usage: iriscale-voice review-window [minutes|default]   (1-120; Claude Code's default is 1)" >&2; return 2 ;;
        *) [ "$1" -ge 1 ] && [ "$1" -le 120 ] || { echo "review-window: minutes must be 1-120" >&2; return 2; }; _ms=$(( $1 * 60000 )) ;;
    esac
    [ -d "$CLAUDE_DIR" ] || mkdir -p "$CLAUDE_DIR" 2>/dev/null
    if [ -f "$_sf" ]; then
        cp -p "$_sf" "$_sf.iriscale-backup-$(date +%Y%m%d-%H%M%S 2>/dev/null || echo bak)" 2>/dev/null
        if [ -z "${IRISCALE_VOICE_NO_JSON_TOOLS:-}" ] && command -v node >/dev/null 2>&1; then
            node -e 'const fs=require("fs"),f=process.argv[1],ms=+process.argv[2];const d=JSON.parse(fs.readFileSync(f,"utf8"));d.messageIdleNotifThresholdMs=ms;fs.writeFileSync(f,JSON.stringify(d,null,2)+"\n")' "$_sf" "$_ms" || { echo "review-window: $_sf is not valid JSON; fix it, then re-run" >&2; return 1; }
        elif [ -z "${IRISCALE_VOICE_NO_JSON_TOOLS:-}" ] && command -v python3 >/dev/null 2>&1; then
            python3 -c 'import json,sys; f=sys.argv[1]; d=json.load(open(f,encoding="utf-8")); d["messageIdleNotifThresholdMs"]=int(sys.argv[2]); open(f,"w",encoding="utf-8").write(json.dumps(d,indent=2)+"\n")' "$_sf" "$_ms" || { echo "review-window: $_sf is not valid JSON; fix it, then re-run" >&2; return 1; }
        else
            # text edit: replace the key if present, else insert it right after the opening brace
            _c=""; while IFS= read -r _l || [ -n "$_l" ]; do _c="$_c$_l$NL"; done < "$_sf"
            case $_c in
                *'"messageIdleNotifThresholdMs"'*)
                    _pre=${_c%%'"messageIdleNotifThresholdMs"'*}; _post=${_c#*'"messageIdleNotifThresholdMs"'}
                    _post=${_post#*:}; while case $_post in ' '*) true ;; *) false ;; esac; do _post=${_post#?}; done
                    while case $_post in [0-9]*) true ;; *) false ;; esac; do _post=${_post#?}; done
                    printf '%s"messageIdleNotifThresholdMs": %s%s' "$_pre" "$_ms" "$_post" > "$_sf" ;;
                *'{'*)
                    _pre=${_c%%\{*}; _post=${_c#*\{}; _t=$_post
                    while case $_t in [[:space:]]*) true ;; *) false ;; esac; do _t=${_t#?}; done
                    case $_t in '}'*) printf '%s{\n  "messageIdleNotifThresholdMs": %s\n%s' "$_pre" "$_ms" "$_t" > "$_sf" ;;
                              *)   printf '%s{\n  "messageIdleNotifThresholdMs": %s,%s' "$_pre" "$_ms" "$_post" > "$_sf" ;; esac ;;
                *) echo "review-window: $_sf does not look like a JSON object; edit it by hand: \"messageIdleNotifThresholdMs\": $_ms" >&2; return 1 ;;
            esac
        fi
    else
        printf '{\n  "messageIdleNotifThresholdMs": %s\n}\n' "$_ms" > "$_sf"
    fi
    json_validate "$_sf"; _rc=$?
    if [ "$_rc" = 1 ]; then
        _b=$(ls -t "$_sf".iriscale-backup-* 2>/dev/null | sed -n 1p); [ -n "$_b" ] && cp -p "$_b" "$_sf"
        echo "review-window: the edit did not produce valid JSON; $_sf was restored from its backup. Add by hand: \"messageIdleNotifThresholdMs\": $_ms" >&2; return 1
    fi
    echo "review window: a key pressed in a session within $(idle_window_label) of its turn ending marks it reviewed"
    echo "  (messageIdleNotifThresholdMs=$_ms in $_sf). Restart Claude Code to apply."
    return 0
}

# ---------- session board -----------------------------------------------------
_ago() { s=$1; if [ "$s" -lt 60 ]; then printf '%ss' "$s"; elif [ "$s" -lt 3600 ]; then printf '%sm' "$((s/60))"; else printf '%sh' "$((s/3600))"; fi; }

# Is process $1 alive? Under MSYS `kill -0` cannot see Windows pids, so on Windows
# prune_dead lists them once with `ps -W` (about a second on a busy machine) into
# WINPS, the WINPID column with a space either side. If that listing failed, assume
# alive: a stale row is better than dropping every session.
WINPS=""; PRUNED=""
pid_alive() {
    case $1 in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$1" 2>/dev/null && return 0
    case "${OS:-}" in Windows_NT)
        [ -n "$WINPS" ] || return 0
        case "$WINPS" in *" $1 "*) return 0 ;; *) return 1 ;; esac ;;
    esac
    return 1
}
# Forget sessions whose process is gone. A session that recorded no pid (Codex, a
# hand-fed event) is forgotten after board_hide_hours without an event. Costs a
# process or two, so: `sessions`, the board once a minute, never the hook path.
prune_dead() {
    case "${OS:-}" in Windows_NT) WINPS=$(ps -W 2>/dev/null | awk 'NR>1{printf " %s ", $4}') ;; esac
    PRUNED=1
    cfgv hideh board_hide_hours 24
    _pn=$(date +%s 2>/dev/null); case $_pn in ''|*[!0-9]*) return 0 ;; esac
    for _pf in "$SESS"/*; do
        [ -f "$_pf" ] || continue; _pp=""; _pu=""
        while IFS= read -r _pl || [ -n "$_pl" ]; do case $_pl in pid=*) _pp=${_pl#pid=} ;; updated=*) _pu=${_pl#updated=} ;; esac; done < "$_pf"
        if [ -n "$_pp" ]; then pid_alive "$_pp" || rm -f "$_pf" 2>/dev/null
        else case $_pu in ''|*[!0-9]*) _pu=0 ;; esac; [ $(( _pn - _pu )) -gt $(( hideh * 3600 )) ] && rm -f "$_pf" 2>/dev/null; fi
    done
    return 0
}
# forget <name|--all>: drop sessions from the board now; each comes back on its next event.
cli_forget() {
    [ -n "$1" ] || { echo "usage: iriscale-voice forget <session-name|--all>" >&2; return 2; }
    _fc=0
    for _ff in "$SESS"/*; do
        [ -f "$_ff" ] || continue
        if [ "$1" != --all ]; then
            _fn=""; while IFS= read -r _fl || [ -n "$_fl" ]; do case $_fl in name=*) _fn=${_fl#name=} ;; esac; done < "$_ff"
            [ "$_fn" = "$1" ] || continue
        fi
        rm -f "$_ff" 2>/dev/null && _fc=$((_fc+1))
    done
    echo "forgot $_fc session(s)"
    return 0
}

# Render one frame of the board to stdout. Rows come from $SESS state files; Claude
# sessions that predate the state layer are synthesized from ~/.claude/sessions so
# nothing is missing on first run. Sorted: needs you first, then ready, working, idle.
cli_sessions() {
    plain=0; force=0; keys=0
    _focus_os=$(os)
    for _a in "$@"; do case $_a in --plain) plain=1 ;; --color|--colour) force=1 ;; --keys) keys=1 ;; esac; done
    if [ "$plain" = 1 ] || { [ "$force" = 0 ] && [ ! -t 1 ]; }; then G=""; Y=""; R=""; M=""; D=""; B=""; N=""; EL=""
    else G="${ESC}[32m"; Y="${ESC}[33m"; R="${ESC}[31m"; M="${ESC}[35m"; D="${ESC}[2m"; B="${ESC}[1m"; N="${ESC}[0m"; EL="${ESC}[K"; fi
    now=$(date +%s 2>/dev/null); case $now in ''|*[!0-9]*) now=0 ;; esac
    cfgv hideh board_hide_hours 24
    rows=""
    seen=""
    for sf in "$SESS"/*; do
        [ -f "$sf" ] || continue
        a=""; n=""; st=""; since=""; upd=""; said=""; fp=""; snote=""
        while IFS= read -r l || [ -n "$l" ]; do
            case $l in agent=*) a=${l#agent=} ;; name=*) n=${l#name=} ;; status=*) st=${l#status=} ;;
                       since=*) since=${l#since=} ;; updated=*) upd=${l#updated=} ;; said=*) said=${l#said=} ;; pid=*) fp=${l#pid=} ;; note=*) snote=${l#note=} ;; esac
        done < "$sf"
        seen="$seen ${sf##*/} "
        [ -n "$snote" ] && said=$snote   # what it is waiting on beats what it last said
        rows="$rows$(_row "$a" "$n" "$st" "${since:-0}" "${upd:-0}" "$said" "$fp")$NL"
    done
    # Claude sessions with no state file yet (started before this version)
    if [ -d "$CLAUDE_DIR/sessions" ]; then
        for f in "$CLAUDE_DIR"/sessions/*.json; do
            [ -f "$f" ] || continue
            IFS= read -r sj < "$f" || :
            csid=$(jget sessionId "$sj"); case $seen in *" $csid "*) continue ;; esac
            fp=$(jnum pid "$sj"); if [ -n "$PRUNED" ] && ! pid_alive "$fp"; then continue; fi
            n=$(jget name "$sj"); [ -n "$n" ] || { n=$(jget cwd "$sj"); n=${n##*\\}; n=${n##*/}; }
            cst=$(jget status "$sj"); ts=$(jnum statusUpdatedAt "$sj"); ts=$(( ${ts:-0} / 1000 ))
            case $cst in busy) st=working ;; *) st=ready ;; esac
            rows="$rows$(_row claude "$n" "$st" "$ts" "$ts" "" "$fp")$NL"
        done
    fi
    printf "${B}iriscale voice${N} ${D}v$VERSION${N}   ${B}sessions${N}   ${D}updated %s${N}\n\n" "$(date +%H:%M:%S 2>/dev/null)"
    if [ "$keys" = 1 ]; then printf "   %-26s %-13s %-6s %-8s %s\n" "SESSION" "STATE" "FOR" "AGENT" "LAST SAID"
    else printf "     %-26s %-13s %-6s %-8s %s\n" "SESSION" "STATE" "FOR" "AGENT" "LAST SAID"; fi
    [ "$keys" = 1 ] && : > "$STATE/board.rows"
    idx=0
    printf '%s' "$rows" | sort | while IFS='|' read -r _p a n st age said spid; do
        [ -n "$n" ] || continue
        idx=$((idx+1))
        case $st in
            blocked)   dot="${R}*${N}"; label="NEEDS ANSWER" ;;
            error)     dot="${M}*${N}"; label="NEEDS ACTION" ;;
            review|waiting) dot="${G}*${N}"; label="NEEDS REVIEW" ;;
            ready)     dot="${G}*${N}"; label="READY" ;;
            working)   dot="${Y}*${N}"; label="working" ;;
            scheduled) dot="${D}*${N}"; label="scheduled" ;;
            reviewed)  dot="${D}o${N}"; label="reviewed" ;;
            *)         dot="${D}o${N}"; label="idle" ;;
        esac
        if [ "$keys" = 1 ]; then
            printf '%s|%s|%s|%s\n' "$idx" "$spid" "$n" "$a" >> "$STATE/board.rows"
            k=$idx; [ "$idx" -gt 9 ] || [ -z "$spid" ] || [ "$_focus_os" = mac ] && k=" "
            printf "${D}%s${N} %s  %-26.26s %-10s %-6s %-8s ${D}%.44s${N}${EL}\n" "$k" "$dot" "$n" "$label" "$(_ago "$age")" "$a" "$said"
        else
            printf "  %s  %-26.26s %-10s %-6s %-8s ${D}%.44s${N}${EL}\n" "$dot" "$n" "$label" "$(_ago "$age")" "$a" "$said"
        fi
    done
    printf "\n  ${R}*${N} needs your answer   ${M}*${N} needs your action   ${G}*${N} ready for review   ${Y}*${N} working   ${D}o${N} reviewed${EL}\n"
    if [ "$keys" = 1 ]; then
        if [ "$_focus_os" = mac ]; then printf "  ${D}q quits - window focusing is unavailable on macOS${N}${EL}\n"
        else printf "  ${D}click a numbered row or press its number to focus - q quits${N}${EL}\n"; fi
    fi
    [ "$keys" = 1 ] && printf "  ${D}reviewed = a key pressed there within %s of finishing (not a click or focus)${N}${EL}\n" "$(idle_window_label)"
    return 0   # (a trailing failed [ ] test made `sessions` exit 1 - caught by CI)
}
# _row agent name status since updated said pid -> "prio|agent|name|status|age|said|pid" (or nothing if hidden)
_row() {
    [ "$now" -gt 0 ] && age=$(( now - $4 )) || age=0
    [ "$now" -gt 0 ] && quiet=$(( now - $5 )) || quiet=0
    [ "$quiet" -gt $(( hideh * 3600 )) ] && return 0
    st=$3
    case $st in blocked) p=0 ;; error) p=1 ;; review|waiting) p=2 ;; ready) p=3 ;; working) p=4 ;; scheduled) p=5 ;; *) p=6 ;; esac
    printf '%s|%s|%s|%s|%s|%s|%s' "$p" "$1" "$2" "$st" "$age" "$6" "${7:-}"
}

# focus <row-number | session name | pid>: bring that session's window to the front.
# Walks up from the session's pid to the first ancestor that owns a window - the
# terminal or IDE hosting it. Exact for own-window sessions; for tabs inside one host
# (Windows Terminal, an IDE) it raises the host and you pick the tab.
cli_focus() {
    target=$1; fpid=""; fname=""
    [ -n "$target" ] || { echo "usage: iriscale-voice focus <row-number|session-name|pid>" >&2; return 2; }
    case $target in
        [1-9]) [ -f "$STATE/board.rows" ] && while IFS='|' read -r i p n a; do [ "$i" = "$target" ] && { fpid=$p; fname=$n; break; }; done < "$STATE/board.rows" ;;
    esac
    if [ -z "$fname" ]; then
        for sf in "$SESS"/*; do
            [ -f "$sf" ] || continue; n=""; p=""
            while IFS= read -r l || [ -n "$l" ]; do case $l in name=*) n=${l#name=} ;; pid=*) p=${l#pid=} ;; esac; done < "$sf"
            [ "$n" = "$target" ] && { fname=$n; fpid=$p; break; }
        done
    fi
    if [ -z "$fname" ] && [ -d "$CLAUDE_DIR/sessions" ]; then
        for f in "$CLAUDE_DIR"/sessions/*.json; do
            [ -f "$f" ] || continue; IFS= read -r sj < "$f" || :
            n=$(jget name "$sj"); [ "$n" = "$target" ] && { fname=$n; fpid=$(jnum pid "$sj"); break; }
        done
    fi
    if [ -z "$fname" ]; then case $target in *[!0-9]*|"") ;; *) fpid=$target; fname="pid $target" ;; esac; fi
    [ -n "$fname" ] || { echo "no session called '$target'" >&2; return 1; }
    [ -n "$fpid" ] || { echo "no window known for $fname (its agent does not report a pid yet)" >&2; return 1; }
    case "$(os)" in
        win)
            # One WMI query for the whole process table (not one per hop), then walk up
            # in memory; activate with WScript.Shell.AppActivate (no Add-Type compile).
            # Measured: ~3.0 s -> well under 1 s per focus.
            cat > "$STATE/focus.ps1" <<'EOF'
param([int]$TargetPid, [string]$SessionName)
$parents = @{}; $names = @{}
foreach ($w in Get-CimInstance Win32_Process -Property ProcessId,ParentProcessId,Name) { $parents[[int]$w.ProcessId] = [int]$w.ParentProcessId; $names[[int]$w.ProcessId] = $w.Name }
$ws = New-Object -ComObject WScript.Shell
$id = $TargetPid; $hops = 0
while ($id -and $hops -lt 8) {
    if ($ws.AppActivate($id)) {
        $hostName = $names[$id] -replace '\.exe$',''
        switch -Regex ($hostName) {
            '^(Devin|Code|Code - Insiders|Windsurf|Cursor|WindowsTerminal)$' {
                Write-Output ("$hostName is in front - it hosts several sessions, so pick the terminal tab named '" + $SessionName + "'"); break }
            default { Write-Output ("brought to front: " + $hostName + " (" + $SessionName + ")") }
        }
        exit 0
    }
    $id = $parents[$id]; $hops++
}
Write-Output "no window found for $SessionName"; exit 1
EOF
            powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$STATE/focus.ps1" -TargetPid "$fpid" -SessionName "$fname" 2>/dev/null ;;
        mac)   echo "focus on macOS is not implemented yet (session $fname, pid $fpid)" >&2; return 1 ;;
        *)     if command -v wmctrl >/dev/null 2>&1; then wmctrl -ia "$(wmctrl -lp | awk -v p="$fpid" '$3==p{print $1; exit}')" 2>/dev/null
               else echo "focus on Linux needs wmctrl (session $fname, pid $fpid)" >&2; return 1; fi ;;
    esac
}

# Live board: repaint only when a state file changes (or on the heartbeat so the
# "for" column ticks). Cursor-home + overwrite, never clear -> no flicker. q quits.
# Is a board already running? Its pid file is written by cli_board and removed on exit.
board_alive() {
    [ -f "$STATE/board.pid" ] || return 1
    IFS= read -r _bp < "$STATE/board.pid" 2>/dev/null || return 1
    case $_bp in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$_bp" 2>/dev/null
}

# Open the board in its own terminal window, detached, and return at once. Used by
# `board --open`, the /iriscale-voice:board command, and board_autostart on hook events.
cli_board_open() {
    if board_alive; then echo "board is already running"; return 0; fi
    case $0 in */*) _me=$0 ;; *) _me=$(command -v "$0") ;; esac
    case "$(os)" in
        win)
            command -v cygpath >/dev/null 2>&1 || { echo "board --open needs Git Bash (cygpath)" >&2; return 1; }
            _mew=$(cygpath -m "$_me"); _bash="$(cygpath -m /)/bin/bash.exe"
            cfgv geom board_window "84,20"; cfgv pos board_window_pos "1100,80"
            # NB: wt treats ';' as its own separator - keep the command line free of them
            ( wt.exe -w iriscale-board --size "$geom" --pos "$pos" --title sessions "$_bash" "$_mew" board ) </dev/null >/dev/null 2>&1 &
            echo "opened the board in a new Windows Terminal window" ;;
        mac)
            _me=$(CDPATH= cd -P "$(dirname "$_me")" && printf '%s/%s' "$PWD" "${_me##*/}") || return 1
            # Pass data in argv, not AppleScript source; Terminal gets a shell-quoted path.
            osascript - "$_me" <<'APPLESCRIPT' >/dev/null || { echo "could not open the board in Terminal" >&2; return 1; }
on run argv
    tell application "Terminal" to do script (quoted form of (item 1 of argv)) & " board"
end run
APPLESCRIPT
            echo "opened the board in a new Terminal window" ;;
        *)
            for _t in x-terminal-emulator gnome-terminal konsole xterm; do
                if command -v "$_t" >/dev/null 2>&1; then
                    case $_t in gnome-terminal) ( "$_t" -- "$_me" board ) </dev/null >/dev/null 2>&1 & ;;
                                *)              ( "$_t" -e "$_me board" ) </dev/null >/dev/null 2>&1 & ;; esac
                    echo "opened the board in a new $_t window"; return 0
                fi
            done
            echo "no terminal emulator found to open the board in; run: iriscale-voice board" >&2; return 1 ;;
    esac
}

cli_board() {
    interval=""; while [ $# -gt 0 ]; do case $1 in --interval) interval=$2; shift ;; --once) cli_sessions --keys; return 0 ;; --open) cli_board_open; return $? ;; esac; shift; done
    printf '%s\n' "$$" > "$STATE/board.pid" 2>/dev/null
    [ -n "$interval" ] || cfgv interval board_interval 30
    # keys and clicks need `read -n/-t`; plain POSIX sh (dash) lacks them, so re-run the
    # board under bash or zsh when we are not already in one.
    if ! IFS= read -r -n 1 -t 1 _probe </dev/null 2>/dev/null && [ $? -eq 2 ]; then
        for _sh in bash zsh; do
            if command -v "$_sh" >/dev/null 2>&1; then exec "$_sh" "$0" board ${interval:+--interval "$interval"}; fi
        done
        echo "board: interactive keys need bash or zsh; showing a static frame (Ctrl-C to stop)" >&2
    fi
    # raw keys + mouse reporting (SGR 1006 gives unambiguous row numbers). Restored on exit.
    old_stty=$(stty -g 2>/dev/null)
    stty -echo -icanon 2>/dev/null
    board_exit() { printf '\033[?1006l\033[?1000l\033[?25h'; [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null; rm -f "$STATE/board.pid" 2>/dev/null; }
    trap 'board_exit; exit 0' INT TERM EXIT
    printf '\033[?25l\033[?1000h\033[?1006h'
    last_sig=""; last_paint=0; last_prune=0; note=""
    while :; do
        t=$(date +%s 2>/dev/null); case $t in ""|*[!0-9]*) t=0 ;; esac
        if [ $(( t - last_prune )) -ge 60 ]; then prune_dead; last_prune=$t; fi
        sig=""
        for sf in "$SESS"/* "$CLAUDE_DIR"/sessions/*.json; do [ -f "$sf" ] || continue; IFS= read -r l < "$sf" 2>/dev/null || :; sig="$sig$l"; done
        # state files are multi-line; fold the whole file in
        for sf in "$SESS"/*; do [ -f "$sf" ] || continue; while IFS= read -r l || [ -n "$l" ]; do sig="$sig$l"; done < "$sf"; done
        if [ "$sig" != "$last_sig" ] || [ $(( t - last_paint )) -ge "$interval" ] || [ -n "$note" ]; then
            printf '\033[H'; cli_sessions --keys; [ -n "$note" ] && printf '  %s\033[K\n' "$note"; printf '\033[J'
            last_sig=$sig; last_paint=$t; note=""
        fi
        # one read per second: a key, a mouse sequence, or a timeout. bash/ksh/zsh have
        # -n/-t; a shell without them falls back to line input, then sleep.
        # First character arrives immediately (a digit acts at once); only an ESC needs
        # the rest of the mouse sequence, read with a short timeout.
        seq=""; c=""
        if IFS= read -r -s -n 1 -t 1 c 2>/dev/null; then
            seq=$c
            case $c in "$ESC") IFS= read -r -s -n 23 -t 0.2 rest 2>/dev/null || IFS= read -r -s -n 23 -t 1 rest 2>/dev/null; seq="$c$rest" ;; esac
        else rc=$?; [ "$rc" -gt 128 ] || { IFS= read -r -t 1 seq 2>/dev/null || sleep 1; }; fi
        case $seq in
            *[qQ]*) break ;;
            *'[<'*)   # SGR mouse press: ESC[<button;col;rowM  (rows start on screen line 4)
                m=${seq#*\[<}; case $m in *M*) ;; *) continue ;; esac
                m=${m%%[Mm]*}; b=${m%%;*}; rest=${m#*;}; y=${rest#*;}
                if [ "${b:-1}" = 0 ] && [ "$y" -gt 3 ] 2>/dev/null; then note=$(cli_focus $((y-3)) 2>&1); fi ;;
            [1-9]*) note=$(cli_focus "${seq%%[!1-9]*}" 2>&1) ;;
        esac
    done
    board_exit; trap - INT TERM EXIT
}

cli_doctor() {
    agent=$1
    # `doctor claude` only applies to the npm install (the plugin needs no diagnosis), so
    # it lives in the node CLI. Point there rather than printing a bare usage line.
    [ "$agent" = claude ] && {
        npm_only doctor claude
        echo "(a plugin install needs no diagnosis - /iriscale-voice:status shows everything)" >&2
        return 2
    }
    [ "$agent" = codex ] || {
        echo "usage: iriscale-voice doctor codex" >&2
        return 2
    }

    codex_dir=${CODEX_HOME:-$HOME/.codex}
    codex_config="$codex_dir/config.toml"
    codex_hooks="$codex_dir/hooks.json"
    failed=0

    echo "Codex voice configuration"
    if [ -f "$codex_config" ] && grep '^[[:space:]]*notify[[:space:]]*=' "$codex_config" | grep 'iriscale-voice' >/dev/null 2>&1; then
        echo "  OK    completion notify is configured"
    else
        echo "  MISSING completion notify in $codex_config"
        failed=1
    fi

    if [ ! -f "$codex_hooks" ]; then
        echo "  MISSING permission hooks file: $codex_hooks"
        failed=1
    else
        json_validate "$codex_hooks"; _valid=$?
        [ "$_valid" = 1 ] && { echo "  ERROR hooks.json is not valid JSON"; failed=1; }
        grep '"UserPromptSubmit"' "$codex_hooks" >/dev/null 2>&1 &&
            echo "  OK    UserPromptSubmit hook is defined" || { echo "  MISSING UserPromptSubmit hook"; failed=1; }
        grep '"PermissionRequest"' "$codex_hooks" >/dev/null 2>&1 &&
            echo "  OK    PermissionRequest hook is defined" || { echo "  MISSING PermissionRequest hook"; failed=1; }
        grep '"PostToolUse"' "$codex_hooks" >/dev/null 2>&1 &&
            echo "  OK    PostToolUse hook is defined" || { echo "  MISSING PostToolUse resume hook; reapply the installer"; failed=1; }
        command_count=$(grep -o '"command"[[:space:]]*:' "$codex_hooks" 2>/dev/null | wc -l | tr -d '[:space:]')
        if [ "${command_count:-0}" -lt 3 ]; then
            echo "  ERROR all three hooks require a command field"
            failed=1
        else
            echo "  OK    hook command fields are defined"
        fi
    fi

    echo "  CHECK Open /hooks: each event must show Installed 1 and Active 1."
    echo "  CHECK These are basic file checks only; target validation: npx @iriscale/voice@latest doctor codex"
    return "$failed"
}

case "$EVENT" in
    help|-h|--help|"?")  usage; exit 0 ;;
    -V|--version|version) echo "$VERSION"; exit 0 ;;
    status)  cli_status; exit $? ;;
    sessions) shift; prune_dead; cli_sessions "$@"; exit $? ;;
    board)   shift; cli_board "$@"; exit $? ;;
    focus)   shift; cli_focus "$@"; exit $? ;;
    forget)  shift; cli_forget "$@"; exit $? ;;
    review-window) shift; cli_review_window "$@"; exit $? ;;
    tick)    shift; cli_tick "$@"; exit $? ;;      # (internal) apply the review lifecycle now
    watch)   shift; cli_watch "$@"; exit $? ;;     # (internal) follow one session-turn
    install) shift; cli_install "$@"; exit $? ;;
    doctor)  shift; cli_doctor "$@"; exit $? ;;
    completions) shift; cli_completions "$@"; exit $? ;;
    update) cli_windows_lifecycle update; exit $? ;;
    uninstall) case "${2:-}" in
                   claude) npm_only uninstall claude; exit $? ;;
                   codex)  ;;
                   *) echo "usage: iriscale-voice uninstall <codex|claude>" >&2; exit 2 ;;
               esac
               cli_windows_lifecycle uninstall codex; exit $? ;;
    config)  shift; cli_config "$@"; exit $? ;;
    set)     [ -n "$2" ] || { echo "usage: iriscale-voice set <key> <value>" >&2; exit 2; }
             cfg_set "$2" "$3" || exit $?; echo "$2=$3"; exit 0 ;;
    get)     shift; cli_config get "$@"; exit $? ;;
    unset)   shift; cli_config unset "$@"; exit $? ;;
    mute)    cfg_set enabled false; echo "muted (enabled=false)"; exit 0 ;;
    unmute)  cfg_set enabled true;  echo "unmuted (enabled=true)"; exit 0 ;;
    presets)
        for p in off basic standard verbose; do printf '  %-9s %s\n' "$p" "$(preset_events "$p" | sed 's/^$/(nothing)/')"; done
        echo; echo "  standard also skips 'done' for turns under 30s (min_turn_seconds)."; exit 0 ;;
    events)
        printf '  %-18s %-46s %s\n' EVENT "WHEN IT FIRES" "WHAT IT SAYS"
        events_table | while IFS='|' read -r e w s; do printf '  %-18s %-46s %s\n' "$e" "$w" "$s"; done; exit 0 ;;
    say|speak) shift; speak "${*:-iriscale voice test}"; exit 0 ;;
    speaker) shift; cli_speaker "$@"; exit $? ;;
    voices)  shift; cli_speaker_list "$@"; exit $? ;;   # the list under the word people reach for
    test)    shift; cli_test "$@"; exit $? ;;
    mixer-verdict) mixer_verdict "$2"; exit 0 ;;   # (test suite) render one mixer report line
    -*)      echo "unknown option: $EVENT" >&2; usage >&2; exit 2 ;;
esac

# ---------- hook path ---------------------------------------------------------
# If date is unreachable (PATH-less launch), NOW=0 and every time-based gate
# (min_turn, cooldown, quiet hours) is skipped rather than misfiring.
NOW=$(date +%s 2>/dev/null); case $NOW in ''|*[!0-9]*) NOW=0 ;; esac
# Payload source: JSON on stdin (Claude Code, Codex hooks, Copilot, Gemini, ...) or as
# an argument (Codex `notify = [...]` appends the JSON as the last argv; also accepts a
# bare JSON first argument). Then normalize other agents' names onto ours.
payload=""
case $EVENT in
    notify) for _a in "$@"; do payload=$_a; done ;;      # last argument
    '{'*)   payload=$EVENT ;;
    *)      while IFS= read -r _l || [ -n "$_l" ]; do payload="$payload$_l$NL"; done 2>/dev/null ;;
esac
case $EVENT in
    notify|'{'*)
        _t=$(jget type "$payload"); [ -n "$_t" ] || _t=$(jget hook_event_name "$payload")
        case $_t in
            agent-turn-complete|"") EVENT=Stop ;;
            *) EVENT=$_t ;;
        esac ;;
esac
# event aliases (other agents' names for the same moment)
case $EVENT in
    agentStop|AfterAgent|TaskComplete|session.idle|post_cascade_response|agent-turn-complete) EVENT=Stop ;;
    errorOccurred|session.error|TaskCancel) EVENT=StopFailure ;;
    permissionRequest|permission.asked) EVENT=PermissionRequest ;;
    stop)   # Cursor: one event, three outcomes
        _status=$(jget status "$payload")
        case $_status in completed|"") EVENT=Stop ;; error) EVENT=StopFailure ;; aborted) exit 0 ;; esac ;;
esac
# session id aliases: Claude/Codex hooks | Codex notify | Copilot | Cursor
sid=$(jget session_id "$payload")
[ -n "$sid" ] || sid=$(jget thread-id "$payload")
[ -n "$sid" ] || sid=$(jget sessionId "$payload")
[ -n "$sid" ] || sid=$(jget conversation_id "$payload")
# The id becomes a file name under $STATE and $SESS (and is rm -f'd on SessionEnd).
# Hosts issue UUIDs, but never trust it: keep [A-Za-z0-9._-], map anything else to '_',
# and refuse '..' so a crafted id can't reach outside those directories.
if [ -n "$sid" ]; then
    _s=$sid; sid=""
    while [ -n "$_s" ]; do _ch=${_s%"${_s#?}"}; _s=${_s#?}; case $_ch in [A-Za-z0-9._-]) sid="$sid$_ch" ;; *) sid="${sid}_" ;; esac; done
    case $sid in ..|.|"") sid="" ;; *..*) sid=$(printf '%s' "$sid" | tr '.' '_') ;; esac
fi

# resume: PostToolUse - a tool just ran, so the agent is working again. That fires on
# EVERY tool call, so it does the least possible and exits: only a session marked
# "needs your answer" is touched (the answered dialog is what let the tool run).
# Answering a permission prompt or an AskUserQuestion fires no UserPromptSubmit, so
# without this the session stayed blocked until the turn ended and the 3/10-minute
# "still needs your answer" reminders spoke over a turn you had already unblocked.
# Moving `since` ends that turn's reminder watcher; the answer also counts as you
# being present (remind_pause). Builtins only, one file read, one write.
if [ "$EVENT" = resume ]; then
    _rf="$SESS/$sid"
    if [ -n "$sid" ] && [ -f "$_rf" ]; then
        _rs=""; _rout=""
        while IFS= read -r _l || [ -n "$_l" ]; do
            case $_l in
                status=*)    _rs=${_l#status=}; _l="status=working" ;;
                since=*)     _l="since=$NOW" ;;
                updated=*)   _l="updated=$NOW" ;;
                note=*)      _l="note=" ;;
                remind_at=*) _l="remind_at=" ;;
                reminded=*)  _l="reminded=0" ;;
            esac
            _rout="$_rout$_l$NL"
        done < "$_rf"
        if [ "$_rs" = blocked ]; then
            printf '%s' "$_rout" > "$_rf" 2>/dev/null
            [ "$NOW" -gt 0 ] && printf '%s\n' "$NOW" > "$STATE/last_prompt" 2>/dev/null
            [ -n "$IRISCALE_VOICE_DEBUG" ] && echo "(resume: $sid answered, working again)"
        fi
    fi
    exit 0
fi

# Background work. Claude Code (2.1+) sends background_tasks (running/pending subagents,
# shells, monitors, workflows) and session_crons (/loop, scheduled wake-ups) on Stop and
# SubagentStop, exactly so a hook can tell "done" from "paused until that work wakes me".
# A Stop with work in flight is spoken as StepDone (verbose only) and shown as working;
# a Stop that only waits for a cron is Scheduled. No field = older host = plain Stop.
# Builtins only (hook path).
bg_state=unknown; bg_n=0; bg_kind=""; bg_desc=""; bg_note=""; crons=0
case $payload in
    *'"background_tasks":[]'*|*'"background_tasks": []'*) bg_state=empty ;;
    *'"background_tasks":['*|*'"background_tasks": ['*)
        bg_state=busy
        _r=${payload#*\"background_tasks\"}; _r=${_r%%\"session_crons\"*}
        bg_kind=$(jget type "$_r"); bg_desc=$(jget description "$_r")
        while :; do case $_r in *'"status":'*) bg_n=$((bg_n+1)); _r=${_r#*\"status\":} ;; *) break ;; esac; done
        [ "$bg_n" -gt 0 ] || bg_n=1 ;;
esac
case $payload in
    *'"session_crons":[]'*|*'"session_crons": []'*) ;;
    *'"session_crons":['*|*'"session_crons": ['*) crons=1 ;;
esac
if [ "$EVENT" = Stop ]; then
    if [ "$bg_state" = busy ]; then
        EVENT=StepDone
        if [ "$bg_n" = 1 ] && [ "$bg_kind" = subagent ]; then bg_what="1 agent"
        elif [ "$bg_n" = 1 ]; then bg_what="1 background task"
        else bg_what="$bg_n background tasks"; fi
        bg_note="waiting for $bg_what"; [ -n "$bg_desc" ] && bg_note="$bg_note: $(printf '%.48s' "$bg_desc")"
        bg_note=$(clean "$bg_note")
    elif [ "$crons" = 1 ]; then
        EVENT=Scheduled; bg_note="paused until its next wake-up"
    fi
fi

# stamp: a prompt from you starts the turn clock; a wake-up (source system, loop_wakeup,
# schedule_wakeup, poll_event - Claude resuming itself after background work) keeps the
# original start, so "done after N minutes" covers the whole job.
if [ "$EVENT" = stamp ] && [ -n "$sid" ]; then
    _src=$(jget source "$payload")
    case $_src in
        ''|user|sdk) printf '%s\n' "$NOW" > "$STATE/$sid.start" ;;
        *)           [ -f "$STATE/$sid.start" ] || printf '%s\n' "$NOW" > "$STATE/$sid.start" ;;
    esac
fi

# resolve a friendly session name: /rename'd name -> cwd folder -> "Claude".
# Claude Code: ~/.claude/sessions/<pid>.json, one JSON object per file.
# Codex CLI:   ~/.codex/session_index.jsonl, one {"id","thread_name"} per line.
# Both scanned with builtins (no grep). Also records which agent this is and, for
# Claude, its pid - both feed the session board.
name=""; agent=""; pid=""
if [ -n "$sid" ] && [ -d "$CLAUDE_DIR/sessions" ]; then
    for f in "$CLAUDE_DIR"/sessions/*.json; do
        [ -f "$f" ] || continue
        IFS= read -r sj < "$f" || :
        case $sj in *"\"sessionId\":\"$sid\""*) name=$(jget name "$sj"); pid=$(jnum pid "$sj"); agent=claude; break ;; esac
    done
fi
CODEX_INDEX="${CODEX_HOME:-$HOME/.codex}/session_index.jsonl"
if [ -z "$name" ] && [ -n "$sid" ] && [ -f "$CODEX_INDEX" ]; then
    while IFS= read -r cj || [ -n "$cj" ]; do
        case $cj in *"\"id\":\"$sid\""*) name=$(jget thread_name "$cj"); agent=codex; break ;; esac
    done < "$CODEX_INDEX"
fi
if [ -z "$agent" ]; then
    case $payload in
        *'"thread-id"'*) agent=codex ;;
        *'"conversation_id"'*) agent=cursor ;;
        *'"sessionId"'*) agent=copilot ;;
        *'"hook_event_name"'*) agent=claude ;;
        *) agent=agent ;;
    esac
fi
cwd=$(jget cwd "$payload")
[ -n "$cwd" ] || cwd=$(jfirst workspace_roots "$payload")
if [ -z "$name" ]; then
    # basename of a JSON-escaped Windows or POSIX path: C:\\Users\\x\\proj\\ -> proj
    _c=$cwd
    while case $_c in *\\) true ;; *) false ;; esac; do _c=${_c%\\}; done
    while case $_c in */) true ;; *) false ;; esac; do _c=${_c%/}; done
    name=${_c##*\\}; name=${name##*/}
fi
[ -z "$name" ] && name="Claude"

# ---------- session state (feeds `sessions` / `board`) -----------------------
# One small key=value file per session under $SESS. Written with builtins only.
# status: working | ready | review | reviewed | blocked | error | scheduled. `since` only moves when the
# status changes; `said` is the last line actually spoken for this session.
state_write() {   # state_write <status> [said] [note]   (note: what the session is waiting on)
    [ -n "$sid" ] || return 0
    [ -d "$SESS" ] || mkdir -p -m 700 "$SESS" 2>/dev/null
    _sf="$SESS/$sid"; _os=""; _osince=""; _osaid=""; _orem=""; _ora=""
    if [ -f "$_sf" ]; then
        while IFS= read -r _l || [ -n "$_l" ]; do
            case $_l in status=*) _os=${_l#status=} ;; since=*) _osince=${_l#since=} ;; said=*) _osaid=${_l#said=} ;;
                       reminded=*) _orem=${_l#reminded=} ;; remind_at=*) _ora=${_l#remind_at=} ;; esac   # lifecycle fields survive rewrites
        done < "$_sf"
    fi
    _since=$NOW; [ "$_os" = "$1" ] && [ -n "$_osince" ] && _since=$_osince
    _said=${2:-$_osaid}
    printf 'agent=%s\nname=%s\nstatus=%s\nsince=%s\nupdated=%s\npid=%s\ncwd=%s\nsaid=%s\nnote=%s\n' \
        "$agent" "$name" "$1" "$_since" "$NOW" "$pid" "$cwd" "$_said" "${3:-}" > "$_sf" 2>/dev/null
    if [ "$_os" = "$1" ]; then
        printf 'reminded=%s\nremind_at=%s\n' "$_orem" "$_ora" >> "$_sf" 2>/dev/null
    fi
}
if [ "$EVENT" = "stamp" ]; then
    state_write working
    # a prompt from you (not a wake-up) is the one sure sign you are here: it feeds
    # remind_pause, and after welcome_back quiet minutes it earns a summary of what waited
    case $(jget source "$payload") in
        ''|user|sdk)
            _lp=0; [ -f "$STATE/last_prompt" ] && { IFS= read -r _lp < "$STATE/last_prompt" || :; }; case $_lp in ''|*[!0-9]*) _lp=0 ;; esac
            [ "$NOW" -gt 0 ] && printf '%s\n' "$NOW" > "$STATE/last_prompt" 2>/dev/null
            cfgv _wb welcome_back 10
            if [ "$_wb" -gt 0 ] 2>/dev/null && [ "$_lp" -gt 0 ] && [ $(( NOW - _lp )) -ge $(( _wb * 60 )) ]; then
                _sum=$(pending_summary)
                if [ -n "$_sum" ]; then
                    _wl="while you were away: $_sum"
                    if [ -n "$IRISCALE_VOICE_DEBUG" ]; then echo "(welcome_back: would say: $_wl)"
                    else printf '{"session_id":"%s","message":"%s"}' "$sid" "$(clean "$_wl")" | sh "$0" WelcomeBack >/dev/null 2>&1 & fi
                fi
            fi ;;
    esac
    exit 0
fi
case $EVENT in
    Stop)              st_new=ready ;;
    StepDone)          st_new=working ;;
    Scheduled)         st_new=scheduled ;;
    PermissionRequest) st_new=blocked ;;
    idle_prompt)       st_new=review; _cs=""; _cn=""; bg_hold=""
                       [ -n "$sid" ] && [ -f "$SESS/$sid" ] && while IFS= read -r _l || [ -n "$_l" ]; do case $_l in status=*) _cs=${_l#status=} ;; note=*) _cn=${_l#note=} ;; esac; done < "$SESS/$sid"
                       case $_cs in blocked|error) st_new="" ;;
                                  working|scheduled) [ -n "$_cn" ] && { st_new=""; bg_hold=1; } ;;   # Claude's idle timer ignores background agents; we do not
                       esac ;;
    StopFailure)       st_new=error ;;
    SessionEnd)        st_new=""; [ -n "$sid" ] && rm -f "$SESS/$sid" 2>/dev/null ;;
    *)                 st_new="" ;;
esac
# speak '_' and '-' as spaces, with builtins
spoken_name=""; _n=$name
while [ -n "$_n" ]; do _c=${_n%"${_n#?}"}; _n=${_n#?}; case $_c in _|-) _c=' ' ;; esac; spoken_name="$spoken_name$_c"; done

# ---------- decide ------------------------------------------------------------
reason=""
cfgv preset preset standard
[ -n "$IRISCALE_VOICE_OFF" ]            && reason="muted via IRISCALE_VOICE_OFF"
[ -z "$reason" ] && [ "${bg_hold:-}" = 1 ] && reason="background work still running - Claude's idle notice ignored"
cfgv enabled enabled true
[ -z "$reason" ] && [ "$enabled" != "true" ] && reason="disabled (enabled=false)"

if [ -z "$reason" ]; then
    # per-event override wins:  event.Stop=off  /  event.SubagentStop=on
    cfgv ov "event.$EVENT" ""
    case "$ov" in
        off|false|0) reason="event $EVENT is off in config" ;;
        on|true|1)   : ;;
        *) case " $(preset_events "$preset") " in
               *" $EVENT "*) : ;;
               *) reason="event $EVENT is off in preset $preset" ;;
           esac ;;
    esac
fi

if [ -z "$reason" ]; then
    cfgv qh quiet_hours ""          # e.g. 22-8
    if [ -n "$qh" ]; then
        qs=${qh%-*}; qe=${qh#*-}; h=$(hour_now 2>/dev/null)
        case $h in ''|*[!0-9]*) h="" ;; esac      # date unreachable -> skip quiet hours
        if [ -n "$h" ]; then
            if [ "$qs" -lt "$qe" ] 2>/dev/null; then [ "$h" -ge "$qs" ] && [ "$h" -lt "$qe" ] && reason="quiet hours ($qh)"
            elif [ "$qs" -gt "$qe" ] 2>/dev/null; then { [ "$h" -ge "$qs" ] || [ "$h" -lt "$qe" ]; } && reason="quiet hours ($qh)"; fi
        fi
    fi
fi

if [ -z "$reason" ]; then
    cfgv only only_sessions ""; cfgv mute mute_sessions ""
    [ -n "$only" ] && case ",$only," in *",$name,"*) : ;; *) reason="$name not in only_sessions" ;; esac
    [ -n "$mute" ] && case ",$mute," in *",$name,"*) reason="$name is in mute_sessions" ;; esac
fi

elapsed=""
if [ "$NOW" -gt 0 ] && [ -n "$sid" ] && [ -f "$STATE/$sid.start" ]; then
    IFS= read -r started < "$STATE/$sid.start" || started=0
    case $started in ''|*[!0-9]*) started=0 ;; esac
    [ "$started" -gt 0 ] && elapsed=$(( NOW - started ))
fi
if [ -z "$reason" ] && [ "$EVENT" = "Stop" ]; then
    cfgv min min_turn_seconds "$(preset_min_turn "$preset")"
    [ -n "$elapsed" ] && [ "$min" -gt 0 ] && [ "$elapsed" -lt "$min" ] && reason="turn took ${elapsed}s, under min_turn_seconds=$min"
fi

# ---------- phrase ------------------------------------------------------------
case "$EVENT" in
    Stop)              tail="done" ;;
    StopFailure)       why=$(jget reason "$payload"); [ -z "$why" ] && why=$(jget error "$payload")
                       tail="stopped with an error"; [ -n "$why" ] && tail="stopped: $(printf '%s' "$why" | tr '_' ' ')" ;;
    PermissionRequest) tool=$(jget tool_name "$payload")
                       tail="is waiting for your answer"; [ -n "$tool" ] && tail="is waiting for your answer to use $tool"
                       if [ "$tool" = "Bash" ]; then
                           # PRIVACY: the command may carry secrets (curl -H "Authorization: Bearer ...")
                           # and this text goes to the speaker and the log. command_detail:
                           #   redacted (default) - up to 60 chars, credential-looking words scrubbed
                           #   program            - program + first word only ("git push"), for shared spaces
                           #   full               - verbatim 60 chars, no scrubbing
                           # Builtins only - this is the hook path.
                           cmd=$(jget command "$payload"); cfgv detail command_detail redacted
                           if [ -n "$cmd" ]; then
                               set -f; set -- $cmd; set +f
                               if [ "$detail" != program ]; then
                                   out=""; n=0; prev=""
                                   for w in "$@"; do
                                       n=$((n+1)); [ "$n" -gt 12 ] && break
                                       if [ "$detail" != full ]; then
                                           # Quotes are shell syntax, not part of a credential prefix.
                                           while case $w in \"*|\'*) true ;; *) false ;; esac; do w=${w#?}; done
                                           while case $w in *\"|*\') true ;; *) false ;; esac; do w=${w%?}; done
                                           lc_to _credential "$w"
                                           _previous=$prev; prev=$_credential
                                           case $_credential in
                                               *secret*=*|*password*=*|*passwd*=*|*token*=*|*key=*) w="${w%%=*}=[redacted]" ;;
                                               *key:?*|*token:?*|*secret:?*) w="${w%%:*}:[redacted]" ;;
                                           esac
                                           case $w in
                                               sk-*|sk_*|ghp_*|gho_*|ghs_*|github_pat_*|AKIA*|xox[abp]-*|glpat-*|AIza*|eyJ*|npm_*|pypi-*) w="[redacted]" ;;
                                               *://*:*@*) w="${w%%://*}://[redacted]@${w#*@}" ;;   # user:pass@host in URLs
                                           esac
                                           case $_previous in bearer|basic|--token|--password|--passwd|-p|--api-key|--key|--secret|--auth|*key:|*token:|*secret:) w="[redacted]" ;; esac
                                       fi
                                       out="$out $w"
                                   done
                                   cmd=$(printf '%.60s' "${out# }")
                               else
                                   # Environment assignments are not program names (or safe to say).
                                   while [ $# -gt 0 ]; do case $1 in *=*) shift ;; *) break ;; esac; done
                                   [ $# -gt 0 ] || set -- command
                                   p1=${1##*/}; p2=${2:-}
                                   case $p1 in sudo|npx|pnpm|npm|yarn|git|gh|docker|kubectl|cargo|go|pip|pip3|python|python3|make|dotnet|az|aws|gcloud)
                                              case $p2 in ''|-*) cmd=$p1 ;; *) cmd="$p1 ${p2##*/}" ;; esac ;;
                                          *)  cmd=$p1 ;;
                                   esac
                               fi
                               [ -n "$cmd" ] && tail="is waiting for your answer to run $cmd"
                           fi
                       fi ;;
    permission_prompt) tail="needs permission" ;;
    idle_prompt)       tail="is waiting for you" ;;
    agent_completed)   tail="agent finished" ;;
    SubagentStop)      tail="sub agent done" ;;      # "subagent" gets read as "soob-agent"
    StepDone)          tail="finished a step, $bg_what still running" ;;
    Scheduled)         tail="paused until its next wake-up" ;;
    SessionEnd)        tail="session ended"; [ -n "$sid" ] && rm -f "$STATE/$sid.start" ;;
    *)                 tail="$EVENT" ;;
esac
# elapsed time on completion, when it's long enough to matter
cfgv say_elapsed say_elapsed true
if [ "$EVENT" = "Stop" ] && [ -n "$elapsed" ] && [ "$elapsed" -ge 60 ] && [ "$say_elapsed" = "true" ]; then
    m=$((elapsed / 60)); tail="$tail after $m minute$( [ "$m" -ne 1 ] && echo s)"
fi
line="$spoken_name $tail"
# what the speaker gets: a comma after the name makes the synthesizer pause there, so
# "payments api, done" is heard as a name and a verdict, not one run-on phrase. The
# log, the board and the repeat guard keep the plain line.
say_line="$spoken_name, $tail"
case $EVENT in Remind|WelcomeBack) line=$(jget message "$payload"); say_line=$line ;; esac   # whole line comes from tick / stamp

# repeat guard: the same announcement for the same session within repeat_cooldown
# seconds is noise (a subagent looping, a hook double-firing) — say it once.
cfgv cool repeat_cooldown 60
lastf="$STATE/${sid:-nosid}.last"
if [ -z "$reason" ] && [ "$NOW" -gt 0 ] && [ "$cool" -gt 0 ] 2>/dev/null && [ -f "$lastf" ]; then
    { IFS= read -r last_t; IFS= read -r last_line; } < "$lastf"
    if [ "$last_line" = "$line" ] && [ $(( NOW - ${last_t:-0} )) -lt "$cool" ]; then
        reason="same announcement within ${cool}s (repeat_cooldown)"
    fi
fi
[ -z "$reason" ] && printf '%s\n%s\n' "$NOW" "$line" > "$lastf" 2>/dev/null

# keep the board window open if asked to: on any event, if board_autostart is on and no
# board is alive, open one (detached; ~two spawns, and only when it is actually missing)
cfgv autostart board_autostart false
if [ "$autostart" = true ] && ! board_alive; then
    if [ -n "$IRISCALE_VOICE_DEBUG" ]; then echo "(board_autostart: would open the board)"
    else cli_board_open >/dev/null 2>&1; fi
fi

# record the session's new state for the board, whether or not we speak
if [ -n "$st_new" ]; then
    if [ -z "$reason" ]; then state_write "$st_new" "$line" "$bg_note"; else state_write "$st_new" "" "$bg_note"; fi
fi
# passive lifecycle bookkeeping, after the state is recorded (builtins only)
if [ -n "$sid" ] && [ -n "$st_new" ] && [ -f "$SESS/$sid" ] && [ "$(st_get "$SESS/$sid" since)" = "$NOW" ]; then
    case $st_new in
        ready|review|blocked|error)
            _rk=$(pending_kind "$st_new" "$agent"); [ "$st_new" = ready ] && _rk=review
            st_put "$SESS/$sid" reminded 0; st_put "$SESS/$sid" remind_at "$(next_remind "$_rk" "$NOW" 0)"
            # one detached watcher per session-turn: sleeps until the review check /
            # reminders are due, exits when the session moves on. Debug runs skip it
            # (the suite drives `tick` directly).
            [ -n "$IRISCALE_VOICE_DEBUG" ] || ( cli_watch "$sid" "$NOW" ) </dev/null >/dev/null 2>&1 & ;;
    esac
fi

# ---------- act ---------------------------------------------------------------
if [ -n "$IRISCALE_VOICE_DEBUG" ]; then
    # show exactly what the speaker would receive (after clean())
    line=$(clean "$line")
    if [ -n "$reason" ]; then echo "SKIP  [$EVENT] ($reason)  would say: $line"
    else echo "SPEAK [$EVENT] $line"; echo "      spoken as: $(clean "$(sayable "$say_line")")"; fi
    exit 0
fi
[ -n "$reason" ] && exit 0

cfgv log log "$CLAUDE_DIR/iriscale-voice.log"
if [ "$log" != "none" ]; then
    # keep the log bounded: roll it at ~1 MB (one older copy kept)
    if [ -f "$log" ] && [ "$(wc -c < "$log" 2>/dev/null)" -gt 1000000 ] 2>/dev/null; then mv -f "$log" "$log.1" 2>/dev/null; fi
    printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$EVENT" "$line" >> "$log" 2>/dev/null
fi

# Speak in a detached background subshell so the hook returns immediately.
# Synchronous hosts (Codex runs hooks synchronously - async definitions are
# skipped as of 0.147) would otherwise freeze for the whole spoken phrase:
# measured ~7 s blocking on a permission announcement. The subshell inherits
# CONF_DATA and the serialize lock still queues concurrent sessions.
cfgv serialize serialize true
(
    if [ "$serialize" = "true" ]; then with_lock speak "$say_line"; else speak "$say_line"; fi
) </dev/null >/dev/null 2>&1 &
exit 0
