#!/bin/sh
# iriscale_voice — let your coding agents tell you when they're done or need you.
#
# Called by Claude Code hooks with the hook's JSON payload on stdin:
#   iriscale-voice <event>          (see `iriscale-voice events`)
# Also a CLI, used by the /iriscale-voice:* slash commands and by humans:
#   iriscale-voice --help
#
# Strict POSIX sh, zero dependencies: no jq, node, python. Speech uses whatever the
# OS ships: PowerShell/System.Speech (Windows), say (macOS), spd-say/espeak (Linux).

VERSION="0.1.17"
EVENT="${1:-Stop}"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CONF="$CLAUDE_DIR/iriscale-voice.conf"
STATE="${TMPDIR:-/tmp}/iriscale-voice"
[ -d "$STATE" ] || mkdir -p -m 700 "$STATE" 2>/dev/null   # private: /tmp may be shared
SESS="$CLAUDE_DIR/iriscale-voice-sessions"     # one state file per live session (any agent)

# ---------- tiny helpers ------------------------------------------------------
# PERFORMANCE NOTE. This script runs on every hook event, and on Windows/MSYS each
# external process (sed, grep, tr...) costs 25-50 ms to spawn. The first versions
# spawned ~40 of them per event and took ~1.8 s before speaking. So the hot paths
# below use only shell builtins: the config file is read ONCE into memory and every
# lookup is parameter expansion + case. Keep it that way.
NL='
'
CR=$(printf '\r')
ESC=$(printf '\033')     # the escape byte; colours and cursor control are built from it

# Pull a string field out of flat-ish JSON without jq: first occurrence of "key",
# then optional whitespace, ':', whitespace, and a double-quoted value. Not a JSON
# parser — good enough for the ids, paths and tool names we read. Zero spawns.
jget() {
    j=$2
    case $j in *"\"$1\""*) ;; *) return 0 ;; esac
    r=${j#*"\"$1\""}
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in ':'*) r=${r#:} ;; *) return 0 ;; esac
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in '"'*) r=${r#\"} ;; *) return 0 ;; esac
    # fast path: no backslash before the closing quote
    _head=${r%%\"*}
    case $_head in *\\*) ;; *) printf '%s' "$_head"; return 0 ;; esac
    # slow path: honour JSON escapes (\" \\ \n \t \/) so a value like
    # curl -H \"Authorization: ...\" is returned whole, not cut at the first \"
    _v=""
    while [ -n "$r" ]; do
        _ch=${r%"${r#?}"}; r=${r#?}
        case $_ch in
            \\) _n=${r%"${r#?}"}; r=${r#?}
                case $_n in n|t|r) _v="$_v " ;; '') ;; *) _v="$_v$_n" ;; esac ;;
            \") break ;;
            *)  _v="$_v$_ch" ;;
        esac
    done
    printf '%s' "$_v"
}

# Unquoted number field: "pid":12345  (zero spawns)
jnum() { case $2 in *"\"$1\":"*) r=${2#*"\"$1\":"}; while case $r in ' '*) true ;; *) false ;; esac; do r=${r#?}; done; printf '%s' "${r%%[!0-9]*}" ;; esac; }

# Pull the first string from a JSON array field (for workspace_roots aliases).
# Like jget, this deliberately handles only the small hook-payload shape we need.
jfirst() {
    j=$2
    case $j in *"\"$1\""*) ;; *) return 0 ;; esac
    r=${j#*"\"$1\""}
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in ':'*) r=${r#:} ;; *) return 0 ;; esac
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in '['*) r=${r#[} ;; *) return 0 ;; esac
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in '"'*) r=${r#\"} ;; *) return 0 ;; esac
    printf '%s' "${r%%\"*}"
}

# Config: key=value lines, '#' comments, no quoting. Loaded once into CONF_DATA
# (normalized: trimmed, CR stripped, comments dropped). Last occurrence of a key wins.
CONF_DATA=""
load_conf() {
    CONF_DATA=""
    [ -f "$CONF" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%"$CR"}
        case $line in *=*) ;; *) continue ;; esac          # skips blanks and non key=value lines
        k=${line%%=*}; v=${line#*=}
        while case $k in ' '*|"	"*) true ;; *) false ;; esac; do k=${k#?}; done
        while case $k in *' '|*"	") true ;; *) false ;; esac; do k=${k%?}; done
        while case $v in ' '*|"	"*) true ;; *) false ;; esac; do v=${v#?}; done
        while case $v in *' '|*"	") true ;; *) false ;; esac; do v=${v%?}; done
        case $k in '#'*|'') continue ;; esac                # comments
        CONF_DATA="$CONF_DATA$k=$v$NL"
    done < "$CONF"
}
load_conf

# cfgv VAR <key> <default> — assign the setting to VAR with no subshell (use this on
# the hook path: $(cfg ...) forks, ~14 ms each on MSYS).  cfg <key> <default> prints.
# Precedence: conf file > plugin setting (CLAUDE_PLUGIN_OPTION_<KEY>) > default.
cfgv() {
    _k=$2; _v=""; _rest=$CONF_DATA
    while [ -n "$_rest" ]; do
        _line=${_rest%%"$NL"*}; _rest=${_rest#*"$NL"}
        case $_line in "$_k="*) _v=${_line#*=} ;; esac
    done
    if [ -z "$_v" ] && [ "$HAVE_PLUGIN_OPTS" = 1 ]; then
        _envkey=CLAUDE_PLUGIN_OPTION_$(printf '%s' "$_k" | tr 'a-z.' 'A-Z_')
        eval "_v=\${$_envkey:-}"
    fi
    [ -n "$_v" ] || _v=$3
    eval "$1=\$_v"
}
cfg() { cfgv _out "$1" "$2"; printf '%s' "$_out"; }
# only pay for the env-var fallback if the plugin host actually exported options
HAVE_PLUGIN_OPTS=0
case "$(env 2>/dev/null)" in *CLAUDE_PLUGIN_OPTION_*) HAVE_PLUGIN_OPTS=1 ;; esac
cfg_set() {   # cfg_set <key> <value>  (create/replace the line, keep everything else)
    case $1 in ''|*[!A-Za-z0-9._]*) echo "invalid key: $1" >&2; return 2 ;; esac
    case $2 in *"$NL"*) echo "value may not contain a newline" >&2; return 2 ;; esac
    [ -f "$CONF" ] || : > "$CONF"
    # rewrite with builtins (no sed metacharacter surprises from '|', '&', '\')
    _out=""; _hit=0
    while IFS= read -r _l || [ -n "$_l" ]; do
        _k=${_l%%=*}; while case $_k in ' '*|"	"*) true ;; *) false ;; esac; do _k=${_k#?}; done
        while case $_k in *' '|*"	") true ;; *) false ;; esac; do _k=${_k%?}; done
        case $_l in *=*) if [ "$_k" = "$1" ]; then _out="$_out$1=$2$NL"; _hit=1; continue; fi ;; esac
        _out="$_out$_l$NL"
    done < "$CONF"
    [ "$_hit" = 1 ] || _out="$_out$1=$2$NL"
    printf '%s' "$_out" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
    load_conf
}
now() { printf "%s" "$NOW"; }   # NOW is set once, at the top of the hook path
os() {
    # $OS is set to Windows_NT by Windows itself - no spawn, and it works even when
    # the launching process gave us a PATH without uname (raw MSYS sh.exe).
    case "${OS:-}" in Windows_NT) echo win; return ;; esac
    case "$(uname -s 2>/dev/null)" in
        Darwin) echo mac ;;
        MINGW*|MSYS*|CYGWIN*|Windows_NT) echo win ;;
        *) echo linux ;;
    esac
}
# keep spoken text shell-safe for every backend: letters, digits, basic punctuation.
# SECURITY INVARIANT: the allowlist must never admit ' " \ ` or $ - the Windows
# backend embeds this text in a single-quoted PowerShell string. A test asserts it.
# If tr is unreachable (PATH-less launch) fall back to a builtin scrub of the
# characters that could break the quoted speech command - never go silent.
clean() {
    # allowlist scrub with builtins only (no tr): anything outside the set becomes a
    # space, runs of spaces collapse. Zero spawns, works with a PATH-less launch.
    _in=$1; _o=""; _sp=0
    while [ -n "$_in" ]; do
        _ch=${_in%"${_in#?}"}; _in=${_in#?}
        case $_ch in
            [A-Za-z0-9.,:\;!?\(\)/\&%+=@#\[\]-]) _o="$_o$_ch"; _sp=0 ;;
            *) [ "$_sp" = 1 ] || _o="$_o "; _sp=1 ;;
        esac
    done
    printf '%s' "$_o"
}
# empty output = clock unavailable (caller then skips quiet hours). Midnight "00" -> "0".
hour_now() { h=$(date +%H 2>/dev/null); case $h in ??) h=${h#0} ;; esac; printf '%s' "$h"; }

# ---------- presets -----------------------------------------------------------
# preset_events <preset>  -> space-separated list of events that speak
preset_events() {
    case "$1" in
        basic)    echo "Stop idle_prompt" ;;
        verbose)  echo "Stop StopFailure PermissionRequest idle_prompt agent_completed SubagentStop SessionEnd" ;;
        off)      echo "" ;;
        *)        echo "Stop StopFailure PermissionRequest idle_prompt" ;;   # standard
    esac
}
preset_min_turn() { case "$1" in standard) echo 30 ;; *) echo 0 ;; esac; }

# ---------- speaking backends -------------------------------------------------
speak() {
    text=$(clean "$1")
    cfgv vol volume 100; cfgv rate rate 0; cfgv voice voice ""
    # config values are interpolated into the speech command: keep them boring
    case $vol in ''|*[!0-9]*) vol=100 ;; esac
    case $rate in ''|-) rate=0 ;; -[0-9]*|[0-9]*) case ${rate#-} in *[!0-9]*) rate=0 ;; esac ;; *) rate=0 ;; esac
    case $voice in *[!A-Za-z0-9\ ._-]*) voice="" ;; esac
    case "$(os)" in
        win)
            ps="Add-Type -AssemblyName System.Speech; \$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \$s.Volume=$vol; \$s.Rate=$rate;"
            [ -n "$voice" ] && ps="$ps try { \$s.SelectVoice('$voice') } catch {};"
            ps="$ps \$s.Speak('$text')"
            powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$ps" >/dev/null 2>&1 ;;
        mac)
            # say: rate is words/min (default ~175); map our -10..10 onto 120..300
            wpm=$((175 + rate * 12))
            if [ -n "$voice" ]; then say -v "$voice" -r "$wpm" "$text" 2>/dev/null
            else say -r "$wpm" "$text" 2>/dev/null; fi ;;
        *)
            if command -v spd-say >/dev/null 2>&1; then spd-say -w -r "$((rate * 10))" "$text" 2>/dev/null
            elif command -v espeak-ng >/dev/null 2>&1; then espeak-ng "$text" 2>/dev/null
            elif command -v espeak >/dev/null 2>&1; then espeak "$text" 2>/dev/null
            elif command -v notify-send >/dev/null 2>&1; then notify-send "iriscale voice" "$text" 2>/dev/null
            else printf '\a'; fi ;;
    esac
}

# serialize across concurrent sessions so two announcements never overlap.
# mkdir is atomic everywhere; flock isn't on macOS.
with_lock() {
    lock="$STATE/speak.lock"; i=0
    while ! mkdir "$lock" 2>/dev/null; do
        # stale lock (a killed speaker) is stolen once it is over a minute old; after
        # ~20 s of waiting we give up on the queue and speak anyway (an overlap beats a
        # lost announcement).
        if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rmdir "$lock" 2>/dev/null; continue; fi
        i=$((i+1)); [ "$i" -gt 40 ] && break; sleep 0.5
    done
    "$@"
    rmdir "$lock" 2>/dev/null
}

# ---------- CLI ---------------------------------------------------------------
# All settings, with their default and one-line meaning. Single source of truth for
# `config list`, `config get`, and `--help`; docs/CONFIG.md mirrors it.
#   key | default | description
settings_table() {
    p=$(cfg preset standard)
    cat <<EOF
preset|standard|off, basic, standard, verbose — how much gets spoken
enabled|true|false = silent (\`mute\` / \`unmute\`)
event.<Event>|(preset)|on/off — override one event regardless of preset (see \`events\`)
quiet_hours|(none)|22-8 style, 24h, may wrap midnight; nothing speaks inside the window
min_turn_seconds|$(preset_min_turn "$p")|don't say "done" for turns shorter than this; errors and permission prompts still speak
say_elapsed|true|append "after N minutes" to "done" for turns of 60s or more
speak_full_command|false|permission prompts: false = program + first word only ("git push"); true = up to 60 chars with token-like words redacted (may still expose secrets)
repeat_cooldown|60|seconds; identical line for the same session inside the window is said once; 0 disables
mute_sessions|(none)|comma-separated session names to never announce
only_sessions|(none = all)|comma-separated; if set, announce ONLY these
voice|(OS default)|Windows: e.g. Microsoft Zira Desktop; macOS: any from \`say -v ?\`; Linux: ignored
rate|0|speaking speed, -10 slow .. 10 fast
volume|100|0-100 (Windows only; others use system volume)
serialize|true|queue announcements so concurrent sessions never overlap
log|$CLAUDE_DIR/iriscale-voice.log|tab-separated activity log; \`none\` disables
board_ready_minutes|15|on the board, a finished session shows READY for this long, then idle
board_hide_hours|24|the board hides sessions with no event for this long
board_interval|30|seconds between board heartbeats (ages tick); state changes redraw immediately
EOF
}
events_table() {
    cat <<'EOF'
Stop|turn finished|"<session> done" (+ "after N minutes")
StopFailure|turn died: rate limit, billing, auth, server|"<session> stopped: rate limit"
PermissionRequest|Claude asks to run a tool|"<session> is waiting for your answer to run git push"
idle_prompt|Claude has been waiting for your input|"<session> is waiting for you"
agent_completed|a background agent finished|"<session> agent finished"
SubagentStop|a subagent stopped|"<session> sub agent done"
SessionEnd|session closed|"<session> session ended"
stamp|(internal) marks turn start for min_turn_seconds|—
EOF
}
usage() {
    cat <<EOF
iriscale-voice $VERSION — let your coding agents tell you when they are done and need attention.

USAGE
  iriscale-voice <COMMAND> [ARGS]
  iriscale-voice <EVENT>  < payload.json        (how the hooks call it)

COMMANDS
  status                 what's configured and what will speak
  test                   speak a test phrase out loud
  say <text>             speak arbitrary text
  mute | unmute          silence / restore (sets enabled=false/true)
  config list            every setting: key, current value, default, meaning
  config get <key>       print one setting's current value
  config set <key> <v>   set one setting   (alias: set <key> <v>)
  config unset <key>     remove a setting, back to preset/default
  config path            print the config file path
  config edit            open the config file in \$EDITOR
  sessions [--plain]     every live session: state, how long, what was last said
  board [--interval N]   the same, live; redraws only on change; click a row or press
                         its number to bring that session's window to the front; q quits
                         (--once prints one frame and exits)
  focus <n|name|pid>     bring a session's window (or its host IDE/terminal) to the front
                         (Windows; Linux with wmctrl; not yet on macOS)
  install codex          print Codex config snippets with absolute paths
  install codex --apply  install launcher, completion, notify, and hooks (Windows)
  doctor codex           diagnose Codex notify and hook configuration
  completions <shell>    print completion for powershell, bash, or zsh
  update                 install the latest release (Windows)
  uninstall codex        remove the Windows install and owned Codex config
  presets                the four presets and what each speaks
  events                 every event, when it fires, what it says
  help, -h, --help       this text          -V, --version   print version

ENVIRONMENT
  IRISCALE_VOICE_OFF=1        mute everything, no file edits
  IRISCALE_VOICE_DEBUG=1      print the decision instead of speaking
  CLAUDE_CONFIG_DIR           where the config lives (default ~/.claude)

FILES
  $CONF
  $(cfg log "$CLAUDE_DIR/iriscale-voice.log")

Inside Claude Code: /iriscale-voice:<command>  (type /iriscale-voice: and autocomplete lists them).
Docs: https://github.com/justbuild-it/iriscale_voice
EOF
}
cli_status() {
    p=$(cfg preset standard)
    echo "iriscale-voice $VERSION"
    echo "  config:   $CONF $( [ -f "$CONF" ] && echo '' || echo '(not created yet - using defaults)')"
    echo "  enabled:  $(cfg enabled true)   preset: $p   speaks on: $(preset_events "$p")"
    echo "  quiet:    $(cfg quiet_hours none)   min_turn: $(cfg min_turn_seconds "$(preset_min_turn "$p")")s   cooldown: $(cfg repeat_cooldown 60)s"
    echo "  muted:    $(cfg mute_sessions none)   only: $(cfg only_sessions all)"
    echo "  voice:    $(cfg voice default)   volume: $(cfg volume 100)   rate: $(cfg rate 0)   os: $(os)"
    echo "  log:      $(cfg log "$CLAUDE_DIR/iriscale-voice.log")"
    ov=$( [ -f "$CONF" ] && grep '^event\.' "$CONF" | grep -v '=$' | tr '\n' ' ' )
    [ -n "$ov" ] && echo "  overrides: $ov"
    return 0
}
cli_config() {
    sub="$1"; shift
    case "$sub" in
        list|ls|"")
            printf '%-18s %-26s %-22s %s\n' KEY CURRENT DEFAULT MEANING
            settings_table | while IFS='|' read -r k d m; do
                case "$k" in "event.<Event>") cur=$( [ -f "$CONF" ] && grep '^event\.' "$CONF" | grep -v '=$' | tr '\n' ' ' ); [ -z "$cur" ] && cur="(none)";;
                             *) cur=$(cfg "$k" ""); [ -z "$cur" ] && cur="(default)";; esac
                printf '%-18s %-26s %-22s %s\n' "$k" "$cur" "$d" "$m"
            done
            echo; echo "file: $CONF"; [ -f "$CONF" ] || echo "(not created yet)"
            ;;
        get)   [ -n "$1" ] || { echo "usage: iriscale-voice config get <key>" >&2; return 2; }
               v=$(cfg "$1" ""); if [ -n "$v" ]; then echo "$v"; else echo "(unset - using default)"; fi ;;
        set)   [ -n "$1" ] || { echo "usage: iriscale-voice config set <key> <value>" >&2; return 2; }
               cfg_set "$1" "$2" || return $?; echo "$1=$2" ;;
        unset|rm) [ -n "$1" ] || { echo "usage: iriscale-voice config unset <key>" >&2; return 2; }
               [ -f "$CONF" ] && { sed "/^[[:space:]]*$1[[:space:]]*=/d" "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"; }
               echo "unset $1" ;;
        path)  echo "$CONF" ;;
        edit)  [ -f "$CONF" ] || : > "$CONF"; "${EDITOR:-vi}" "$CONF" ;;
        *)     echo "unknown: config $sub  (try: list, get, set, unset, path, edit)" >&2; return 2 ;;
    esac
}

cli_install() {
    agent=$1
    [ "$agent" = codex ] || {
        echo "usage: iriscale-voice install codex" >&2
        return 2
    }

    if [ "${2:-}" = "--apply" ]; then
        case $0 in */*) invoked=$0 ;; *) invoked=$(command -v "$0") ;; esac
        script_dir=$(CDPATH= cd -- "$(dirname -- "$invoked")" 2>/dev/null && pwd -P)
        installer="$script_dir/../install.ps1"
        [ -f "$installer" ] || installer="$script_dir/install.ps1"
        [ -f "$installer" ] || { echo "install.ps1 not found next to iriscale-voice" >&2; return 1; }
        command -v powershell.exe >/dev/null 2>&1 || { echo "PowerShell is required for --apply" >&2; return 1; }
        source_root=$(CDPATH= cd -- "$script_dir/.." 2>/dev/null && pwd -P)
        powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$installer" -SourcePath "$source_root"
        return $?
    fi

    case $0 in */*) invoked=$0 ;; *) invoked=$(command -v "$0") ;; esac
    script_dir=$(CDPATH= cd -- "$(dirname -- "$invoked")" 2>/dev/null && pwd -P)
    script_path="$script_dir/$(basename -- "$invoked")"
    shell_path=$(command -v sh)

    if [ "$(os)" = win ] && command -v cygpath >/dev/null 2>&1; then
        script_path=$(cygpath -m "$script_path")
        shell_path=$(cygpath -m "$shell_path")
        # `command -v sh` resolves to Git's RAW MSYS shell (…/Git/usr/bin/sh.exe).
        # Launched directly from a Windows process it does not put /usr/bin on PATH,
        # so date/uname/mkdir/tr are all missing and hooks fail with
        # "date: command not found". The …/Git/bin/sh.exe WRAPPER sets PATH up;
        # always prefer it when it exists.
        case $shell_path in
            */usr/bin/sh.exe)
                wrapper="${shell_path%/usr/bin/sh.exe}/bin/sh.exe"
                [ -f "$wrapper" ] && shell_path=$wrapper ;;
        esac
        cat <<EOF
# Basic — add at the top of ~/.codex/config.toml
notify = ["$shell_path", "$script_path", "notify"]

# Full (optional) — save as ~/.codex/hooks.json; in /hooks verify Installed=1, then trust
{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" stamp",
        "commandWindows": "\"$shell_path\" \"$script_path\" stamp",
        "timeout": 10 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" PermissionRequest",
        "commandWindows": "\"$shell_path\" \"$script_path\" PermissionRequest",
        "timeout": 30 } ] }
    ]
  }
}
EOF
    else
        cat <<EOF
# Basic — add at the top of ~/.codex/config.toml
notify = ["$script_path", "notify"]

# Full (optional) — save as ~/.codex/hooks.json; in /hooks verify Installed=1, then trust
{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" stamp",
        "timeout": 10 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" PermissionRequest",
        "timeout": 30 } ] }
    ]
  }
}
EOF
    fi
}

cli_completions() {
    case ${1:-} in
        powershell|pwsh)
            cat <<'EOF'
Register-ArgumentCompleter -Native -CommandName iriscale-voice -ScriptBlock {
  param($wordToComplete, $commandAst, $cursorPosition)
  $elements = @($commandAst.CommandElements | ForEach-Object { $_.Extent.Text })
  $argument = $elements.Count - 1
  if ($commandAst.Extent.Text -match '\s$') { $argument++ }
  if ($argument -le 1) {
    $choices = 'status','sessions','board','focus','test','say','mute','unmute','config','install','doctor','presets','events','completions','update','uninstall','help'
  } else {
    $choices = switch ($elements[1]) {
      'config' { 'list','get','set','unset','path','edit' }
      { $_ -in 'install','doctor','uninstall' } { 'codex' }
      'completions' { 'powershell','bash','zsh' }
    }
  }
  $choices |
    Where-Object { $_ -like "$wordToComplete*" } | ForEach-Object {
      [System.Management.Automation.CompletionResult]::new($_, $_, 'ParameterValue', $_)
    }
}
EOF
            ;;
        bash)
            cat <<'EOF'
_iriscale_voice() {
  if [ "$COMP_CWORD" -eq 1 ]; then
    choices='status sessions board focus test say mute unmute config install doctor presets events completions update uninstall help'
  else
    case ${COMP_WORDS[1]} in
      config) choices='list get set unset path edit' ;;
      install|doctor|uninstall) choices='codex' ;;
      completions) choices='powershell bash zsh' ;;
    esac
  fi
  COMPREPLY=( $(compgen -W "$choices" -- "${COMP_WORDS[COMP_CWORD]}") )
}
complete -F _iriscale_voice iriscale-voice
EOF
            ;;
        zsh)
            cat <<'EOF'
#compdef iriscale-voice
_arguments '1:command:(status sessions board focus test say mute unmute config install doctor presets events completions update uninstall help)'
EOF
            ;;
        *) echo "usage: iriscale-voice completions <powershell|bash|zsh>" >&2; return 2 ;;
    esac
}

cli_windows_lifecycle() {
    action=$1
    case $0 in */*) invoked=$0 ;; *) invoked=$(command -v "$0") ;; esac
    script_dir=$(CDPATH= cd -- "$(dirname -- "$invoked")" 2>/dev/null && pwd -P)
    installer="$script_dir/../install.ps1"; [ -f "$installer" ] || installer="$script_dir/install.ps1"
    [ -f "$installer" ] || { echo "installed install.ps1 not found" >&2; return 1; }
    command -v powershell.exe >/dev/null 2>&1 || { echo "PowerShell is required" >&2; return 1; }
    case $action in
        # Detached: this script is the file the installer must replace, and bash keeps
        # it open while running - Windows refuses to overwrite an open file, so an
        # inline update always failed with "being used by another process". Let the
        # launcher exit first, then run the installer; it logs to $STATE.
        update)    ( sleep 1; powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$installer" -Update > "$STATE/update.log" 2>&1 ) </dev/null >/dev/null 2>&1 &
                   echo "updating in the background; in a few seconds run: iriscale-voice --version   (log: $STATE/update.log)" ;;
        uninstall) ( sleep 1; powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$installer" -Uninstall > "$STATE/uninstall.log" 2>&1 ) </dev/null >/dev/null 2>&1 &
                   echo "uninstalling in the background (log: $STATE/uninstall.log)" ;;
    esac
}

# ---------- session board -----------------------------------------------------
_ago() { s=$1; if [ "$s" -lt 60 ]; then printf '%ss' "$s"; elif [ "$s" -lt 3600 ]; then printf '%sm' "$((s/60))"; else printf '%sh' "$((s/3600))"; fi; }

# Render one frame of the board to stdout. Rows come from $SESS state files; Claude
# sessions that predate the state layer are synthesized from ~/.claude/sessions so
# nothing is missing on first run. Sorted: needs you first, then ready, working, idle.
cli_sessions() {
    plain=0; force=0; keys=0
    for _a in "$@"; do case $_a in --plain) plain=1 ;; --color|--colour) force=1 ;; --keys) keys=1 ;; esac; done
    if [ "$plain" = 1 ] || { [ "$force" = 0 ] && [ ! -t 1 ]; }; then G=""; Y=""; R=""; M=""; D=""; B=""; N=""; EL=""
    else G="${ESC}[32m"; Y="${ESC}[33m"; R="${ESC}[31m"; M="${ESC}[35m"; D="${ESC}[2m"; B="${ESC}[1m"; N="${ESC}[0m"; EL="${ESC}[K"; fi
    now=$(date +%s 2>/dev/null); case $now in ''|*[!0-9]*) now=0 ;; esac
    cfgv readym board_ready_minutes 15; cfgv hideh board_hide_hours 24
    rows=""
    seen=""
    for sf in "$SESS"/*; do
        [ -f "$sf" ] || continue
        a=""; n=""; st=""; since=""; upd=""; said=""; fp=""
        while IFS= read -r l || [ -n "$l" ]; do
            case $l in agent=*) a=${l#agent=} ;; name=*) n=${l#name=} ;; status=*) st=${l#status=} ;;
                       since=*) since=${l#since=} ;; updated=*) upd=${l#updated=} ;; said=*) said=${l#said=} ;; pid=*) fp=${l#pid=} ;; esac
        done < "$sf"
        seen="$seen ${sf##*/} "
        rows="$rows$(_row "$a" "$n" "$st" "${since:-0}" "${upd:-0}" "$said" "$fp")$NL"
    done
    # Claude sessions with no state file yet (started before this version)
    if [ -d "$CLAUDE_DIR/sessions" ]; then
        for f in "$CLAUDE_DIR"/sessions/*.json; do
            [ -f "$f" ] || continue
            IFS= read -r sj < "$f" || :
            csid=$(jget sessionId "$sj"); case $seen in *" $csid "*) continue ;; esac
            n=$(jget name "$sj"); [ -n "$n" ] || { n=$(jget cwd "$sj"); n=${n##*\\}; n=${n##*/}; }
            cst=$(jget status "$sj"); ts=$(jnum statusUpdatedAt "$sj"); ts=$(( ${ts:-0} / 1000 ))
            case $cst in busy) st=working ;; *) st=ready ;; esac
            rows="$rows$(_row claude "$n" "$st" "$ts" "$ts" "" "$(jnum pid "$sj")")$NL"
        done
    fi
    printf "${B}iriscale voice${N} ${D}v$VERSION${N}   ${B}sessions${N}   ${D}updated %s${N}\n\n" "$(date +%H:%M:%S 2>/dev/null)"
    if [ "$keys" = 1 ]; then printf "   %-26s %-10s %-6s %-8s %s\n" "SESSION" "STATE" "FOR" "AGENT" "LAST SAID"
    else printf "     %-26s %-10s %-6s %-8s %s\n" "SESSION" "STATE" "FOR" "AGENT" "LAST SAID"; fi
    [ "$keys" = 1 ] && : > "$STATE/board.rows"
    idx=0
    printf '%s' "$rows" | sort | while IFS='|' read -r _p a n st age said spid; do
        [ -n "$n" ] || continue
        idx=$((idx+1))
        case $st in
            blocked) dot="${R}*${N}"; label="NEEDS YOU" ;;
            error)   dot="${M}*${N}"; label="ERROR" ;;
            ready)   dot="${G}*${N}"; label="READY" ;;
            working) dot="${Y}*${N}"; label="working" ;;
            waiting) dot="${D}*${N}"; label="waiting" ;;
            *)       dot="${D}o${N}"; label="idle" ;;
        esac
        if [ "$keys" = 1 ]; then
            printf '%s|%s|%s|%s\n' "$idx" "$spid" "$n" "$a" >> "$STATE/board.rows"
            k=$idx; [ "$idx" -gt 9 ] && k=" "
            printf "${D}%s${N} %s  %-26.26s %-10s %-6s %-8s ${D}%.44s${N}${EL}\n" "$k" "$dot" "$n" "$label" "$(_ago "$age")" "$a" "$said"
        else
            printf "  %s  %-26.26s %-10s %-6s %-8s ${D}%.44s${N}${EL}\n" "$dot" "$n" "$label" "$(_ago "$age")" "$a" "$said"
        fi
    done
    printf "\n  ${R}*${N} needs your answer   ${G}*${N} ready for review   ${Y}*${N} working   ${M}*${N} error   ${D}o${N} idle${EL}\n"
    [ "$keys" = 1 ] && printf "  ${D}click a row or press its number to bring it to the front - q quits${N}${EL}\n"
    return 0   # (a trailing failed [ ] test made `sessions` exit 1 - caught by CI)
}
# _row agent name status since updated said pid -> "prio|agent|name|status|age|said|pid" (or nothing if hidden)
_row() {
    [ "$now" -gt 0 ] && age=$(( now - $4 )) || age=0
    [ "$now" -gt 0 ] && quiet=$(( now - $5 )) || quiet=0
    [ "$quiet" -gt $(( hideh * 3600 )) ] && return 0
    st=$3
    [ "$st" = ready ] && [ "$age" -gt $(( readym * 60 )) ] && st=idle
    case $st in blocked) p=0 ;; error) p=1 ;; ready) p=2 ;; working) p=3 ;; waiting) p=4 ;; *) p=5 ;; esac
    printf '%s|%s|%s|%s|%s|%s|%s' "$p" "$1" "$2" "$st" "$age" "$6" "${7:-}"
}

# focus <row-number | session name | pid>: bring that session's window to the front.
# Walks up from the session's pid to the first ancestor that owns a window - the
# terminal or IDE hosting it. Exact for own-window sessions; for tabs inside one host
# (Windows Terminal, an IDE) it raises the host and you pick the tab.
cli_focus() {
    target=$1; fpid=""; fname=""
    [ -n "$target" ] || { echo "usage: iriscale-voice focus <row-number|session-name|pid>" >&2; return 2; }
    case $target in
        [1-9]) [ -f "$STATE/board.rows" ] && while IFS='|' read -r i p n a; do [ "$i" = "$target" ] && { fpid=$p; fname=$n; break; }; done < "$STATE/board.rows" ;;
    esac
    if [ -z "$fname" ]; then
        for sf in "$SESS"/*; do
            [ -f "$sf" ] || continue; n=""; p=""
            while IFS= read -r l || [ -n "$l" ]; do case $l in name=*) n=${l#name=} ;; pid=*) p=${l#pid=} ;; esac; done < "$sf"
            [ "$n" = "$target" ] && { fname=$n; fpid=$p; break; }
        done
    fi
    if [ -z "$fname" ] && [ -d "$CLAUDE_DIR/sessions" ]; then
        for f in "$CLAUDE_DIR"/sessions/*.json; do
            [ -f "$f" ] || continue; IFS= read -r sj < "$f" || :
            n=$(jget name "$sj"); [ "$n" = "$target" ] && { fname=$n; fpid=$(jnum pid "$sj"); break; }
        done
    fi
    if [ -z "$fname" ]; then case $target in *[!0-9]*|"") ;; *) fpid=$target; fname="pid $target" ;; esac; fi
    [ -n "$fname" ] || { echo "no session called '$target'" >&2; return 1; }
    [ -n "$fpid" ] || { echo "no window known for $fname (its agent does not report a pid yet)" >&2; return 1; }
    case "$(os)" in
        win)
            # One WMI query for the whole process table (not one per hop), then walk up
            # in memory; activate with WScript.Shell.AppActivate (no Add-Type compile).
            # Measured: ~3.0 s -> well under 1 s per focus.
            cat > "$STATE/focus.ps1" <<'EOF'
param([int]$TargetPid, [string]$SessionName)
$parents = @{}; $names = @{}
foreach ($w in Get-CimInstance Win32_Process -Property ProcessId,ParentProcessId,Name) { $parents[[int]$w.ProcessId] = [int]$w.ParentProcessId; $names[[int]$w.ProcessId] = $w.Name }
$ws = New-Object -ComObject WScript.Shell
$id = $TargetPid; $hops = 0
while ($id -and $hops -lt 8) {
    if ($ws.AppActivate($id)) {
        $hostName = $names[$id] -replace '\.exe$',''
        switch -Regex ($hostName) {
            '^(Devin|Code|Code - Insiders|Windsurf|Cursor|WindowsTerminal)$' {
                Write-Output ("$hostName is in front - it hosts several sessions, so pick the terminal tab named '" + $SessionName + "'"); break }
            default { Write-Output ("brought to front: " + $hostName + " (" + $SessionName + ")") }
        }
        exit 0
    }
    $id = $parents[$id]; $hops++
}
Write-Output "no window found for $SessionName"; exit 1
EOF
            powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$STATE/focus.ps1" -TargetPid "$fpid" -SessionName "$fname" 2>/dev/null ;;
        mac)   echo "focus on macOS is not implemented yet (session $fname, pid $fpid)" >&2; return 1 ;;
        *)     if command -v wmctrl >/dev/null 2>&1; then wmctrl -ia "$(wmctrl -lp | awk -v p="$fpid" '$3==p{print $1; exit}')" 2>/dev/null
               else echo "focus on Linux needs wmctrl (session $fname, pid $fpid)" >&2; return 1; fi ;;
    esac
}

# Live board: repaint only when a state file changes (or on the heartbeat so the
# "for" column ticks). Cursor-home + overwrite, never clear -> no flicker. q quits.
cli_board() {
    interval=""; while [ $# -gt 0 ]; do case $1 in --interval) interval=$2; shift ;; --once) cli_sessions --keys; return 0 ;; esac; shift; done
    [ -n "$interval" ] || cfgv interval board_interval 30
    # keys and clicks need `read -n/-t`; plain POSIX sh (dash) lacks them, so re-run the
    # board under bash or zsh when we are not already in one.
    if ! IFS= read -r -n 1 -t 1 _probe </dev/null 2>/dev/null && [ $? -eq 2 ]; then
        for _sh in bash zsh; do
            if command -v "$_sh" >/dev/null 2>&1; then exec "$_sh" "$0" board ${interval:+--interval "$interval"}; fi
        done
        echo "board: interactive keys need bash or zsh; showing a static frame (Ctrl-C to stop)" >&2
    fi
    # raw keys + mouse reporting (SGR 1006 gives unambiguous row numbers). Restored on exit.
    old_stty=$(stty -g 2>/dev/null)
    stty -echo -icanon 2>/dev/null
    board_exit() { printf '\033[?1006l\033[?1000l\033[?25h'; [ -n "$old_stty" ] && stty "$old_stty" 2>/dev/null; }
    trap 'board_exit; exit 0' INT TERM EXIT
    printf '\033[?25l\033[?1000h\033[?1006h'
    last_sig=""; last_paint=0; note=""
    while :; do
        sig=""
        for sf in "$SESS"/* "$CLAUDE_DIR"/sessions/*.json; do [ -f "$sf" ] || continue; IFS= read -r l < "$sf" 2>/dev/null || :; sig="$sig$l"; done
        # state files are multi-line; fold the whole file in
        for sf in "$SESS"/*; do [ -f "$sf" ] || continue; while IFS= read -r l || [ -n "$l" ]; do sig="$sig$l"; done < "$sf"; done
        t=$(date +%s 2>/dev/null); case $t in ''|*[!0-9]*) t=0 ;; esac
        if [ "$sig" != "$last_sig" ] || [ $(( t - last_paint )) -ge "$interval" ] || [ -n "$note" ]; then
            printf '\033[H'; cli_sessions --keys; [ -n "$note" ] && printf '  %s\033[K\n' "$note"; printf '\033[J'
            last_sig=$sig; last_paint=$t; note=""
        fi
        # one read per second: a key, a mouse sequence, or a timeout. bash/ksh/zsh have
        # -n/-t; a shell without them falls back to line input, then sleep.
        # First character arrives immediately (a digit acts at once); only an ESC needs
        # the rest of the mouse sequence, read with a short timeout.
        seq=""; c=""
        if IFS= read -r -s -n 1 -t 1 c 2>/dev/null; then
            seq=$c
            case $c in "$ESC") IFS= read -r -s -n 23 -t 0.2 rest 2>/dev/null || IFS= read -r -s -n 23 -t 1 rest 2>/dev/null; seq="$c$rest" ;; esac
        else rc=$?; [ "$rc" -gt 128 ] || { IFS= read -r -t 1 seq 2>/dev/null || sleep 1; }; fi
        case $seq in
            *[qQ]*) break ;;
            *'[<'*)   # SGR mouse press: ESC[<button;col;rowM  (rows start on screen line 4)
                m=${seq#*\[<}; case $m in *M*) ;; *) continue ;; esac
                m=${m%%[Mm]*}; b=${m%%;*}; rest=${m#*;}; y=${rest#*;}
                if [ "${b:-1}" = 0 ] && [ "$y" -gt 3 ] 2>/dev/null; then note=$(cli_focus $((y-3)) 2>&1); fi ;;
            [1-9]*) note=$(cli_focus "${seq%%[!1-9]*}" 2>&1) ;;
        esac
    done
    board_exit; trap - INT TERM EXIT
}

cli_doctor() {
    agent=$1
    [ "$agent" = codex ] || {
        echo "usage: iriscale-voice doctor codex" >&2
        return 2
    }

    codex_dir=${CODEX_HOME:-$HOME/.codex}
    codex_config="$codex_dir/config.toml"
    codex_hooks="$codex_dir/hooks.json"
    failed=0

    echo "Codex voice configuration"
    if [ -f "$codex_config" ] && grep '^[[:space:]]*notify[[:space:]]*=' "$codex_config" | grep 'iriscale-voice' >/dev/null 2>&1; then
        echo "  OK    completion notify is configured"
    else
        echo "  MISSING completion notify in $codex_config"
        failed=1
    fi

    if [ ! -f "$codex_hooks" ]; then
        echo "  MISSING permission hooks file: $codex_hooks"
        failed=1
    else
        if grep '"async"[[:space:]]*:[[:space:]]*true' "$codex_hooks" >/dev/null 2>&1; then
            echo "  ERROR hooks use async=true; Codex 0.147 skips asynchronous hooks"
            failed=1
        fi
        grep '"UserPromptSubmit"' "$codex_hooks" >/dev/null 2>&1 &&
            echo "  OK    UserPromptSubmit hook is defined" || { echo "  MISSING UserPromptSubmit hook"; failed=1; }
        grep '"PermissionRequest"' "$codex_hooks" >/dev/null 2>&1 &&
            echo "  OK    PermissionRequest hook is defined" || { echo "  MISSING PermissionRequest hook"; failed=1; }
        command_count=$(grep -o '"command"[[:space:]]*:' "$codex_hooks" 2>/dev/null | wc -l | tr -d '[:space:]')
        if [ "${command_count:-0}" -lt 2 ]; then
            echo "  ERROR UserPromptSubmit and PermissionRequest hooks each require a command field"
            failed=1
        else
            echo "  OK    hook command fields are defined"
        fi
    fi

    echo "  CHECK Open /hooks: each event must show Installed 1 and Active 1."
    [ "$failed" -eq 0 ] && echo "  READY Hook files look installable; confirm installation and trust in /hooks."
    return "$failed"
}

case "$EVENT" in
    help|-h|--help|"?")  usage; exit 0 ;;
    -V|--version|version) echo "$VERSION"; exit 0 ;;
    status)  cli_status; exit $? ;;
    sessions) shift; cli_sessions "$@"; exit $? ;;
    board)   shift; cli_board "$@"; exit $? ;;
    focus)   shift; cli_focus "$@"; exit $? ;;
    install) shift; cli_install "$@"; exit $? ;;
    doctor)  shift; cli_doctor "$@"; exit $? ;;
    completions) shift; cli_completions "$@"; exit $? ;;
    update) cli_windows_lifecycle update; exit $? ;;
    uninstall) [ "${2:-}" = codex ] || { echo "usage: iriscale-voice uninstall codex" >&2; exit 2; }
               cli_windows_lifecycle uninstall; exit $? ;;
    config)  shift; cli_config "$@"; exit $? ;;
    set)     [ -n "$2" ] || { echo "usage: iriscale-voice set <key> <value>" >&2; exit 2; }
             cfg_set "$2" "$3" || exit $?; echo "$2=$3"; exit 0 ;;
    get)     shift; cli_config get "$@"; exit $? ;;
    unset)   shift; cli_config unset "$@"; exit $? ;;
    mute)    cfg_set enabled false; echo "muted (enabled=false)"; exit 0 ;;
    unmute)  cfg_set enabled true;  echo "unmuted (enabled=true)"; exit 0 ;;
    presets)
        for p in off basic standard verbose; do printf '  %-9s %s\n' "$p" "$(preset_events "$p" | sed 's/^$/(nothing)/')"; done
        echo; echo "  standard also skips 'done' for turns under 30s (min_turn_seconds)."; exit 0 ;;
    events)
        printf '  %-18s %-46s %s\n' EVENT "WHEN IT FIRES" "WHAT IT SAYS"
        events_table | while IFS='|' read -r e w s; do printf '  %-18s %-46s %s\n' "$e" "$w" "$s"; done; exit 0 ;;
    say|speak) shift; speak "${*:-iriscale voice test}"; exit 0 ;;
    test)    speak "iriscale voice is working"; echo "spoke a test phrase via $(os) backend"; exit 0 ;;
    -*)      echo "unknown option: $EVENT" >&2; usage >&2; exit 2 ;;
esac

# ---------- hook path ---------------------------------------------------------
# If date is unreachable (PATH-less launch), NOW=0 and every time-based gate
# (min_turn, cooldown, quiet hours) is skipped rather than misfiring.
NOW=$(date +%s 2>/dev/null); case $NOW in ''|*[!0-9]*) NOW=0 ;; esac
# Payload source: JSON on stdin (Claude Code, Codex hooks, Copilot, Gemini, ...) or as
# an argument (Codex `notify = [...]` appends the JSON as the last argv; also accepts a
# bare JSON first argument). Then normalize other agents' names onto ours.
payload=""
case $EVENT in
    notify) for _a in "$@"; do payload=$_a; done ;;      # last argument
    '{'*)   payload=$EVENT ;;
    *)      while IFS= read -r _l || [ -n "$_l" ]; do payload="$payload$_l$NL"; done 2>/dev/null ;;
esac
case $EVENT in
    notify|'{'*)
        _t=$(jget type "$payload"); [ -n "$_t" ] || _t=$(jget hook_event_name "$payload")
        case $_t in
            agent-turn-complete|"") EVENT=Stop ;;
            *) EVENT=$_t ;;
        esac ;;
esac
# event aliases (other agents' names for the same moment)
case $EVENT in
    agentStop|AfterAgent|TaskComplete|session.idle|post_cascade_response|agent-turn-complete) EVENT=Stop ;;
    errorOccurred|session.error|TaskCancel) EVENT=StopFailure ;;
    permissionRequest|permission.asked) EVENT=PermissionRequest ;;
    stop)   # Cursor: one event, three outcomes
        _status=$(jget status "$payload")
        case $_status in completed|"") EVENT=Stop ;; error) EVENT=StopFailure ;; aborted) exit 0 ;; esac ;;
esac
# session id aliases: Claude/Codex hooks | Codex notify | Copilot | Cursor
sid=$(jget session_id "$payload")
[ -n "$sid" ] || sid=$(jget thread-id "$payload")
[ -n "$sid" ] || sid=$(jget sessionId "$payload")
[ -n "$sid" ] || sid=$(jget conversation_id "$payload")
# The id becomes a file name under $STATE and $SESS (and is rm -f'd on SessionEnd).
# Hosts issue UUIDs, but never trust it: keep [A-Za-z0-9._-], map anything else to '_',
# and refuse '..' so a crafted id can't reach outside those directories.
if [ -n "$sid" ]; then
    _s=$sid; sid=""
    while [ -n "$_s" ]; do _ch=${_s%"${_s#?}"}; _s=${_s#?}; case $_ch in [A-Za-z0-9._-]) sid="$sid$_ch" ;; *) sid="${sid}_" ;; esac; done
    case $sid in ..|.|"") sid="" ;; *..*) sid=$(printf '%s' "$sid" | tr '.' '_') ;; esac
fi

[ "$EVENT" = "stamp" ] && [ -n "$sid" ] && printf '%s\n' "$NOW" > "$STATE/$sid.start"

# resolve a friendly session name: /rename'd name -> cwd folder -> "Claude".
# Claude Code: ~/.claude/sessions/<pid>.json, one JSON object per file.
# Codex CLI:   ~/.codex/session_index.jsonl, one {"id","thread_name"} per line.
# Both scanned with builtins (no grep). Also records which agent this is and, for
# Claude, its pid - both feed the session board.
name=""; agent=""; pid=""
if [ -n "$sid" ] && [ -d "$CLAUDE_DIR/sessions" ]; then
    for f in "$CLAUDE_DIR"/sessions/*.json; do
        [ -f "$f" ] || continue
        IFS= read -r sj < "$f" || :
        case $sj in *"\"sessionId\":\"$sid\""*) name=$(jget name "$sj"); pid=$(jnum pid "$sj"); agent=claude; break ;; esac
    done
fi
CODEX_INDEX="${CODEX_HOME:-$HOME/.codex}/session_index.jsonl"
if [ -z "$name" ] && [ -n "$sid" ] && [ -f "$CODEX_INDEX" ]; then
    while IFS= read -r cj || [ -n "$cj" ]; do
        case $cj in *"\"id\":\"$sid\""*) name=$(jget thread_name "$cj"); agent=codex; break ;; esac
    done < "$CODEX_INDEX"
fi
if [ -z "$agent" ]; then
    case $payload in
        *'"thread-id"'*) agent=codex ;;
        *'"conversation_id"'*) agent=cursor ;;
        *'"sessionId"'*) agent=copilot ;;
        *'"hook_event_name"'*) agent=claude ;;
        *) agent=agent ;;
    esac
fi
cwd=$(jget cwd "$payload")
[ -n "$cwd" ] || cwd=$(jfirst workspace_roots "$payload")
if [ -z "$name" ]; then
    # basename of a JSON-escaped Windows or POSIX path: C:\\Users\\x\\proj\\ -> proj
    _c=$cwd
    while case $_c in *\\) true ;; *) false ;; esac; do _c=${_c%\\}; done
    while case $_c in */) true ;; *) false ;; esac; do _c=${_c%/}; done
    name=${_c##*\\}; name=${name##*/}
fi
[ -z "$name" ] && name="Claude"

# ---------- session state (feeds `sessions` / `board`) -----------------------
# One small key=value file per session under $SESS. Written with builtins only.
# status: working | ready | blocked | waiting | error. `since` only moves when the
# status changes; `said` is the last line actually spoken for this session.
state_write() {   # state_write <status> [said]
    [ -n "$sid" ] || return 0
    [ -d "$SESS" ] || mkdir -p -m 700 "$SESS" 2>/dev/null
    _sf="$SESS/$sid"; _os=""; _osince=""; _osaid=""
    if [ -f "$_sf" ]; then
        while IFS= read -r _l || [ -n "$_l" ]; do
            case $_l in status=*) _os=${_l#status=} ;; since=*) _osince=${_l#since=} ;; said=*) _osaid=${_l#said=} ;; esac
        done < "$_sf"
    fi
    _since=$NOW; [ "$_os" = "$1" ] && [ -n "$_osince" ] && _since=$_osince
    _said=${2:-$_osaid}
    printf 'agent=%s\nname=%s\nstatus=%s\nsince=%s\nupdated=%s\npid=%s\ncwd=%s\nsaid=%s\n' \
        "$agent" "$name" "$1" "$_since" "$NOW" "$pid" "$cwd" "$_said" > "$_sf" 2>/dev/null
}
if [ "$EVENT" = "stamp" ]; then state_write working; exit 0; fi
case $EVENT in
    Stop)              st_new=ready ;;
    PermissionRequest) st_new=blocked ;;
    idle_prompt)       st_new=waiting ;;
    StopFailure)       st_new=error ;;
    SessionEnd)        st_new=""; [ -n "$sid" ] && rm -f "$SESS/$sid" 2>/dev/null ;;
    *)                 st_new="" ;;
esac
# speak '_' and '-' as spaces, with builtins
spoken_name=""; _n=$name
while [ -n "$_n" ]; do _c=${_n%"${_n#?}"}; _n=${_n#?}; case $_c in _|-) _c=' ' ;; esac; spoken_name="$spoken_name$_c"; done

# ---------- decide ------------------------------------------------------------
reason=""
cfgv preset preset standard
[ -n "$IRISCALE_VOICE_OFF" ]            && reason="muted via IRISCALE_VOICE_OFF"
cfgv enabled enabled true
[ -z "$reason" ] && [ "$enabled" != "true" ] && reason="disabled (enabled=false)"

if [ -z "$reason" ]; then
    # per-event override wins:  event.Stop=off  /  event.SubagentStop=on
    cfgv ov "event.$EVENT" ""
    case "$ov" in
        off|false|0) reason="event $EVENT is off in config" ;;
        on|true|1)   : ;;
        *) case " $(preset_events "$preset") " in
               *" $EVENT "*) : ;;
               *) reason="event $EVENT is off in preset $preset" ;;
           esac ;;
    esac
fi

if [ -z "$reason" ]; then
    cfgv qh quiet_hours ""          # e.g. 22-8
    if [ -n "$qh" ]; then
        qs=${qh%-*}; qe=${qh#*-}; h=$(hour_now 2>/dev/null)
        case $h in ''|*[!0-9]*) h="" ;; esac      # date unreachable -> skip quiet hours
        if [ -n "$h" ]; then
            if [ "$qs" -lt "$qe" ] 2>/dev/null; then [ "$h" -ge "$qs" ] && [ "$h" -lt "$qe" ] && reason="quiet hours ($qh)"
            elif [ "$qs" -gt "$qe" ] 2>/dev/null; then { [ "$h" -ge "$qs" ] || [ "$h" -lt "$qe" ]; } && reason="quiet hours ($qh)"; fi
        fi
    fi
fi

if [ -z "$reason" ]; then
    cfgv only only_sessions ""; cfgv mute mute_sessions ""
    [ -n "$only" ] && case ",$only," in *",$name,"*) : ;; *) reason="$name not in only_sessions" ;; esac
    [ -n "$mute" ] && case ",$mute," in *",$name,"*) reason="$name is in mute_sessions" ;; esac
fi

elapsed=""
if [ "$NOW" -gt 0 ] && [ -n "$sid" ] && [ -f "$STATE/$sid.start" ]; then
    IFS= read -r started < "$STATE/$sid.start" || started=0
    case $started in ''|*[!0-9]*) started=0 ;; esac
    [ "$started" -gt 0 ] && elapsed=$(( NOW - started ))
fi
if [ -z "$reason" ] && [ "$EVENT" = "Stop" ]; then
    cfgv min min_turn_seconds "$(preset_min_turn "$preset")"
    [ -n "$elapsed" ] && [ "$min" -gt 0 ] && [ "$elapsed" -lt "$min" ] && reason="turn took ${elapsed}s, under min_turn_seconds=$min"
fi

# ---------- phrase ------------------------------------------------------------
case "$EVENT" in
    Stop)              tail="done" ;;
    StopFailure)       why=$(jget reason "$payload"); [ -z "$why" ] && why=$(jget error "$payload")
                       tail="stopped with an error"; [ -n "$why" ] && tail="stopped: $(printf '%s' "$why" | tr '_' ' ')" ;;
    PermissionRequest) tool=$(jget tool_name "$payload")
                       tail="is waiting for your answer"; [ -n "$tool" ] && tail="is waiting for your answer to use $tool"
                       if [ "$tool" = "Bash" ]; then
                           # PRIVACY: the command may carry secrets (curl -H "Authorization: Bearer ...").
                           # By default speak/log only the program and its first word ("git push",
                           # "npm test"). speak_full_command=true speaks up to 60 chars, with
                           # token-like words redacted. Builtins only - this is the hook path.
                           cmd=$(jget command "$payload"); cfgv fullcmd speak_full_command false
                           if [ -n "$cmd" ]; then
                               set -f; set -- $cmd; set +f
                               if [ "$fullcmd" = true ]; then
                                   out=""; n=0; prev=""
                                   for w in "$@"; do
                                       n=$((n+1)); [ "$n" -gt 12 ] && break
                                       case $w in
                                           *[Ss]ecret*=*|*[Pp]assword*=*|*[Tt]oken*=*|*[Kk]ey=*|*[Kk]ey:*) w="${w%%=*}=[redacted]" ;;
                                           sk-*|ghp_*|gho_*|github_pat_*|AKIA*|xox[abp]-*|glpat-*|AIza*|eyJ*) w="[redacted]" ;;
                                       esac
                                       case $prev in [Bb]earer|--token|--password|-p|--api-key|--key) w="[redacted]" ;; esac
                                       prev=$w; out="$out $w"
                                   done
                                   cmd=$(printf '%.60s' "${out# }")
                               else
                                   p1=${1##*/}; p2=${2:-}
                                   case $p1 in sudo|npx|pnpm|npm|yarn|git|gh|docker|kubectl|cargo|go|pip|pip3|python|python3|make|dotnet|az|aws|gcloud)
                                              case $p2 in ''|-*) cmd=$p1 ;; *) cmd="$p1 ${p2##*/}" ;; esac ;;
                                          *)  cmd=$p1 ;;
                                   esac
                               fi
                               [ -n "$cmd" ] && tail="is waiting for your answer to run $cmd"
                           fi
                       fi ;;
    permission_prompt) tail="needs permission" ;;
    idle_prompt)       tail="is waiting for you" ;;
    agent_completed)   tail="agent finished" ;;
    SubagentStop)      tail="sub agent done" ;;      # "subagent" gets read as "soob-agent"
    SessionEnd)        tail="session ended"; [ -n "$sid" ] && rm -f "$STATE/$sid.start" ;;
    *)                 tail="$EVENT" ;;
esac
# elapsed time on completion, when it's long enough to matter
cfgv say_elapsed say_elapsed true
if [ "$EVENT" = "Stop" ] && [ -n "$elapsed" ] && [ "$elapsed" -ge 60 ] && [ "$say_elapsed" = "true" ]; then
    m=$((elapsed / 60)); tail="$tail after $m minute$( [ "$m" -ne 1 ] && echo s)"
fi
line="$spoken_name $tail"

# repeat guard: the same announcement for the same session within repeat_cooldown
# seconds is noise (a subagent looping, a hook double-firing) — say it once.
cfgv cool repeat_cooldown 60
lastf="$STATE/${sid:-nosid}.last"
if [ -z "$reason" ] && [ "$NOW" -gt 0 ] && [ "$cool" -gt 0 ] 2>/dev/null && [ -f "$lastf" ]; then
    { IFS= read -r last_t; IFS= read -r last_line; } < "$lastf"
    if [ "$last_line" = "$line" ] && [ $(( NOW - ${last_t:-0} )) -lt "$cool" ]; then
        reason="same announcement within ${cool}s (repeat_cooldown)"
    fi
fi
[ -z "$reason" ] && printf '%s\n%s\n' "$NOW" "$line" > "$lastf" 2>/dev/null

# record the session's new state for the board, whether or not we speak
if [ -n "$st_new" ]; then
    if [ -z "$reason" ]; then state_write "$st_new" "$line"; else state_write "$st_new"; fi
fi

# ---------- act ---------------------------------------------------------------
if [ -n "$IRISCALE_VOICE_DEBUG" ]; then
    # show exactly what the speaker would receive (after clean())
    line=$(clean "$line")
    if [ -n "$reason" ]; then echo "SKIP  [$EVENT] ($reason)  would say: $line"
    else echo "SPEAK [$EVENT] $line"; fi
    exit 0
fi
[ -n "$reason" ] && exit 0

cfgv log log "$CLAUDE_DIR/iriscale-voice.log"
if [ "$log" != "none" ]; then
    # keep the log bounded: roll it at ~1 MB (one older copy kept)
    if [ -f "$log" ] && [ "$(wc -c < "$log" 2>/dev/null)" -gt 1000000 ] 2>/dev/null; then mv -f "$log" "$log.1" 2>/dev/null; fi
    printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$EVENT" "$line" >> "$log" 2>/dev/null
fi

# Speak in a detached background subshell so the hook returns immediately.
# Synchronous hosts (Codex runs hooks synchronously - async definitions are
# skipped as of 0.147) would otherwise freeze for the whole spoken phrase:
# measured ~7 s blocking on a permission announcement. The subshell inherits
# CONF_DATA and the serialize lock still queues concurrent sessions.
cfgv serialize serialize true
(
    if [ "$serialize" = "true" ]; then with_lock speak "$line"; else speak "$line"; fi
) </dev/null >/dev/null 2>&1 &
exit 0
