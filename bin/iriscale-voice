#!/bin/sh
# iriscale_voice — let your coding agents tell you when they're done or need you.
#
# Called by Claude Code hooks with the hook's JSON payload on stdin:
#   iriscale-voice <event>          (see `iriscale-voice events`)
# Also a CLI, used by the /iriscale-voice:* slash commands and by humans:
#   iriscale-voice --help
#
# Strict POSIX sh, zero dependencies: no jq, node, python. Speech uses whatever the
# OS ships: PowerShell/System.Speech (Windows), say (macOS), spd-say/espeak (Linux).

VERSION="0.1.7"
EVENT="${1:-Stop}"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CONF="$CLAUDE_DIR/iriscale-voice.conf"
STATE="${TMPDIR:-/tmp}/iriscale-voice"
[ -d "$STATE" ] || mkdir -p "$STATE" 2>/dev/null

# ---------- tiny helpers ------------------------------------------------------
# PERFORMANCE NOTE. This script runs on every hook event, and on Windows/MSYS each
# external process (sed, grep, tr...) costs 25-50 ms to spawn. The first versions
# spawned ~40 of them per event and took ~1.8 s before speaking. So the hot paths
# below use only shell builtins: the config file is read ONCE into memory and every
# lookup is parameter expansion + case. Keep it that way.
NL='
'
CR=$(printf '\r')

# Pull a string field out of flat-ish JSON without jq: first occurrence of "key",
# then optional whitespace, ':', whitespace, and a double-quoted value. Not a JSON
# parser — good enough for the ids, paths and tool names we read. Zero spawns.
jget() {
    j=$2
    case $j in *"\"$1\""*) ;; *) return 0 ;; esac
    r=${j#*"\"$1\""}
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in ':'*) r=${r#:} ;; *) return 0 ;; esac
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in '"'*) r=${r#\"} ;; *) return 0 ;; esac
    printf '%s' "${r%%\"*}"
}

# Pull the first string from a JSON array field (for workspace_roots aliases).
# Like jget, this deliberately handles only the small hook-payload shape we need.
jfirst() {
    j=$2
    case $j in *"\"$1\""*) ;; *) return 0 ;; esac
    r=${j#*"\"$1\""}
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in ':'*) r=${r#:} ;; *) return 0 ;; esac
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in '['*) r=${r#[} ;; *) return 0 ;; esac
    while case $r in ' '*|"	"*|"$NL"*|"$CR"*) true ;; *) false ;; esac; do r=${r#?}; done
    case $r in '"'*) r=${r#\"} ;; *) return 0 ;; esac
    printf '%s' "${r%%\"*}"
}

# Config: key=value lines, '#' comments, no quoting. Loaded once into CONF_DATA
# (normalized: trimmed, CR stripped, comments dropped). Last occurrence of a key wins.
CONF_DATA=""
load_conf() {
    CONF_DATA=""
    [ -f "$CONF" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%"$CR"}
        case $line in *=*) ;; *) continue ;; esac          # skips blanks and non key=value lines
        k=${line%%=*}; v=${line#*=}
        while case $k in ' '*|"	"*) true ;; *) false ;; esac; do k=${k#?}; done
        while case $k in *' '|*"	") true ;; *) false ;; esac; do k=${k%?}; done
        while case $v in ' '*|"	"*) true ;; *) false ;; esac; do v=${v#?}; done
        while case $v in *' '|*"	") true ;; *) false ;; esac; do v=${v%?}; done
        case $k in '#'*|'') continue ;; esac                # comments
        CONF_DATA="$CONF_DATA$k=$v$NL"
    done < "$CONF"
}
load_conf

# cfgv VAR <key> <default> — assign the setting to VAR with no subshell (use this on
# the hook path: $(cfg ...) forks, ~14 ms each on MSYS).  cfg <key> <default> prints.
# Precedence: conf file > plugin setting (CLAUDE_PLUGIN_OPTION_<KEY>) > default.
cfgv() {
    _k=$2; _v=""; _rest=$CONF_DATA
    while [ -n "$_rest" ]; do
        _line=${_rest%%"$NL"*}; _rest=${_rest#*"$NL"}
        case $_line in "$_k="*) _v=${_line#*=} ;; esac
    done
    if [ -z "$_v" ] && [ "$HAVE_PLUGIN_OPTS" = 1 ]; then
        _envkey=CLAUDE_PLUGIN_OPTION_$(printf '%s' "$_k" | tr 'a-z.' 'A-Z_')
        eval "_v=\${$_envkey:-}"
    fi
    [ -n "$_v" ] || _v=$3
    eval "$1=\$_v"
}
cfg() { cfgv _out "$1" "$2"; printf '%s' "$_out"; }
# only pay for the env-var fallback if the plugin host actually exported options
HAVE_PLUGIN_OPTS=0
case "$(env 2>/dev/null)" in *CLAUDE_PLUGIN_OPTION_*) HAVE_PLUGIN_OPTS=1 ;; esac
cfg_set() {   # cfg_set <key> <value>  (create/replace the line, keep everything else)
    [ -f "$CONF" ] || : > "$CONF"
    if grep -q "^[[:space:]]*$1[[:space:]]*=" "$CONF" 2>/dev/null; then
        sed "s|^[[:space:]]*$1[[:space:]]*=.*|$1=$2|" "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"
    else
        printf '%s=%s\n' "$1" "$2" >> "$CONF"
    fi
    load_conf
}
now() { printf "%s" "$NOW"; }   # NOW is set once, at the top of the hook path
os() {
    case "$(uname -s 2>/dev/null)" in
        Darwin) echo mac ;;
        MINGW*|MSYS*|CYGWIN*|Windows_NT) echo win ;;
        *) echo linux ;;
    esac
}
# keep spoken text shell-safe for every backend: letters, digits, basic punctuation
clean() { printf '%s' "$1" | tr -c 'A-Za-z0-9 .,:;!?()/&%+-' ' ' | tr -s ' '; }
hour_now() { h=$(date +%H); h=${h#0}; printf '%s' "${h:-0}"; }

# ---------- presets -----------------------------------------------------------
# preset_events <preset>  -> space-separated list of events that speak
preset_events() {
    case "$1" in
        basic)    echo "Stop idle_prompt" ;;
        verbose)  echo "Stop StopFailure PermissionRequest idle_prompt agent_completed SubagentStop SessionEnd" ;;
        off)      echo "" ;;
        *)        echo "Stop StopFailure PermissionRequest idle_prompt" ;;   # standard
    esac
}
preset_min_turn() { case "$1" in standard) echo 30 ;; *) echo 0 ;; esac; }

# ---------- speaking backends -------------------------------------------------
speak() {
    text=$(clean "$1")
    cfgv vol volume 100; cfgv rate rate 0; cfgv voice voice ""
    case "$(os)" in
        win)
            ps="Add-Type -AssemblyName System.Speech; \$s = New-Object System.Speech.Synthesis.SpeechSynthesizer; \$s.Volume=$vol; \$s.Rate=$rate;"
            [ -n "$voice" ] && ps="$ps try { \$s.SelectVoice('$voice') } catch {};"
            ps="$ps \$s.Speak('$text')"
            powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$ps" >/dev/null 2>&1 ;;
        mac)
            # say: rate is words/min (default ~175); map our -10..10 onto 120..300
            wpm=$((175 + rate * 12))
            if [ -n "$voice" ]; then say -v "$voice" -r "$wpm" "$text" 2>/dev/null
            else say -r "$wpm" "$text" 2>/dev/null; fi ;;
        *)
            if command -v spd-say >/dev/null 2>&1; then spd-say -w -r "$((rate * 10))" "$text" 2>/dev/null
            elif command -v espeak-ng >/dev/null 2>&1; then espeak-ng "$text" 2>/dev/null
            elif command -v espeak >/dev/null 2>&1; then espeak "$text" 2>/dev/null
            elif command -v notify-send >/dev/null 2>&1; then notify-send "Claude Code" "$text" 2>/dev/null
            else printf '\a'; fi ;;
    esac
}

# serialize across concurrent sessions so two announcements never overlap.
# mkdir is atomic everywhere; flock isn't on macOS.
with_lock() {
    lock="$STATE/speak.lock"; i=0
    while ! mkdir "$lock" 2>/dev/null; do
        # stale lock (a killed speaker) — steal after 20s
        if [ -n "$(find "$lock" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rmdir "$lock" 2>/dev/null; continue; fi
        i=$((i+1)); [ "$i" -gt 40 ] && break; sleep 0.5
    done
    "$@"
    rmdir "$lock" 2>/dev/null
}

# ---------- CLI ---------------------------------------------------------------
# All settings, with their default and one-line meaning. Single source of truth for
# `config list`, `config get`, and `--help`; docs/CONFIG.md mirrors it.
#   key | default | description
settings_table() {
    p=$(cfg preset standard)
    cat <<EOF
preset|standard|off, basic, standard, verbose — how much gets spoken
enabled|true|false = silent (\`mute\` / \`unmute\`)
event.<Event>|(preset)|on/off — override one event regardless of preset (see \`events\`)
quiet_hours|(none)|22-8 style, 24h, may wrap midnight; nothing speaks inside the window
min_turn_seconds|$(preset_min_turn "$p")|don't say "done" for turns shorter than this; errors and permission prompts still speak
say_elapsed|true|append "after N minutes" to "done" for turns of 60s or more
repeat_cooldown|60|seconds; identical line for the same session inside the window is said once; 0 disables
mute_sessions|(none)|comma-separated session names to never announce
only_sessions|(none = all)|comma-separated; if set, announce ONLY these
voice|(OS default)|Windows: e.g. Microsoft Zira Desktop; macOS: any from \`say -v ?\`; Linux: ignored
rate|0|speaking speed, -10 slow .. 10 fast
volume|100|0-100 (Windows only; others use system volume)
serialize|true|queue announcements so concurrent sessions never overlap
log|$CLAUDE_DIR/iriscale-voice.log|tab-separated activity log; \`none\` disables
EOF
}
events_table() {
    cat <<'EOF'
Stop|turn finished|"<session> done" (+ "after N minutes")
StopFailure|turn died: rate limit, billing, auth, server|"<session> stopped: rate limit"
PermissionRequest|Claude asks to run a tool|"<session> is waiting for your answer to run git push"
idle_prompt|Claude has been waiting for your input|"<session> is waiting for you"
agent_completed|a background agent finished|"<session> agent finished"
SubagentStop|a subagent stopped|"<session> sub agent done"
SessionEnd|session closed|"<session> session ended"
stamp|(internal) marks turn start for min_turn_seconds|—
EOF
}
usage() {
    cat <<EOF
iriscale-voice $VERSION — let your coding agents tell you when they are done and need attention.

USAGE
  iriscale-voice <COMMAND> [ARGS]
  iriscale-voice <EVENT>  < payload.json        (how the hooks call it)

COMMANDS
  status                 what's configured and what will speak
  test                   speak a test phrase out loud
  say <text>             speak arbitrary text
  mute | unmute          silence / restore (sets enabled=false/true)
  config list            every setting: key, current value, default, meaning
  config get <key>       print one setting's current value
  config set <key> <v>   set one setting   (alias: set <key> <v>)
  config unset <key>     remove a setting, back to preset/default
  config path            print the config file path
  config edit            open the config file in \$EDITOR
  install codex          print Codex config snippets with absolute paths
  doctor codex           diagnose Codex notify and hook configuration
  presets                the four presets and what each speaks
  events                 every event, when it fires, what it says
  help, -h, --help       this text          -V, --version   print version

ENVIRONMENT
  IRISCALE_VOICE_OFF=1        mute everything, no file edits
  IRISCALE_VOICE_DEBUG=1      print the decision instead of speaking
  CLAUDE_CONFIG_DIR           where the config lives (default ~/.claude)

FILES
  $CONF
  $(cfg log "$CLAUDE_DIR/iriscale-voice.log")

Inside Claude Code: /iriscale-voice:<command>  (type /iriscale-voice: and autocomplete lists them).
Docs: https://github.com/justbuild-it/iriscale_voice
EOF
}
cli_status() {
    p=$(cfg preset standard)
    echo "iriscale-voice $VERSION"
    echo "  config:   $CONF $( [ -f "$CONF" ] && echo '' || echo '(not created yet - using defaults)')"
    echo "  enabled:  $(cfg enabled true)   preset: $p   speaks on: $(preset_events "$p")"
    echo "  quiet:    $(cfg quiet_hours none)   min_turn: $(cfg min_turn_seconds "$(preset_min_turn "$p")")s   cooldown: $(cfg repeat_cooldown 60)s"
    echo "  muted:    $(cfg mute_sessions none)   only: $(cfg only_sessions all)"
    echo "  voice:    $(cfg voice default)   volume: $(cfg volume 100)   rate: $(cfg rate 0)   os: $(os)"
    echo "  log:      $(cfg log "$CLAUDE_DIR/iriscale-voice.log")"
    ov=$( [ -f "$CONF" ] && grep '^event\.' "$CONF" | grep -v '=$' | tr '\n' ' ' )
    [ -n "$ov" ] && echo "  overrides: $ov"
    return 0
}
cli_config() {
    sub="$1"; shift
    case "$sub" in
        list|ls|"")
            printf '%-18s %-26s %-22s %s\n' KEY CURRENT DEFAULT MEANING
            settings_table | while IFS='|' read -r k d m; do
                case "$k" in "event.<Event>") cur=$( [ -f "$CONF" ] && grep '^event\.' "$CONF" | grep -v '=$' | tr '\n' ' ' ); [ -z "$cur" ] && cur="(none)";;
                             *) cur=$(cfg "$k" ""); [ -z "$cur" ] && cur="(default)";; esac
                printf '%-18s %-26s %-22s %s\n' "$k" "$cur" "$d" "$m"
            done
            echo; echo "file: $CONF"; [ -f "$CONF" ] || echo "(not created yet)"
            ;;
        get)   [ -n "$1" ] || { echo "usage: iriscale-voice config get <key>" >&2; return 2; }
               v=$(cfg "$1" ""); if [ -n "$v" ]; then echo "$v"; else echo "(unset - using default)"; fi ;;
        set)   [ -n "$1" ] || { echo "usage: iriscale-voice config set <key> <value>" >&2; return 2; }
               cfg_set "$1" "$2"; echo "$1=$2" ;;
        unset|rm) [ -n "$1" ] || { echo "usage: iriscale-voice config unset <key>" >&2; return 2; }
               [ -f "$CONF" ] && { sed "/^[[:space:]]*$1[[:space:]]*=/d" "$CONF" > "$CONF.tmp" && mv "$CONF.tmp" "$CONF"; }
               echo "unset $1" ;;
        path)  echo "$CONF" ;;
        edit)  [ -f "$CONF" ] || : > "$CONF"; "${EDITOR:-vi}" "$CONF" ;;
        *)     echo "unknown: config $sub  (try: list, get, set, unset, path, edit)" >&2; return 2 ;;
    esac
}

cli_install() {
    agent=$1
    [ "$agent" = codex ] || {
        echo "usage: iriscale-voice install codex" >&2
        return 2
    }

    case $0 in */*) invoked=$0 ;; *) invoked=$(command -v "$0") ;; esac
    script_dir=$(CDPATH= cd -- "$(dirname -- "$invoked")" 2>/dev/null && pwd -P)
    script_path="$script_dir/$(basename -- "$invoked")"
    shell_path=$(command -v sh)

    if [ "$(os)" = win ] && command -v cygpath >/dev/null 2>&1; then
        script_path=$(cygpath -m "$script_path")
        shell_path=$(cygpath -m "$shell_path")
        cat <<EOF
# Basic — add at the top of ~/.codex/config.toml
notify = ["$shell_path", "$script_path", "notify"]

# Full (optional) — save as ~/.codex/hooks.json; in /hooks verify Installed=1, then trust
{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" stamp",
        "commandWindows": "\"$shell_path\" \"$script_path\" stamp",
        "timeout": 10 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" PermissionRequest",
        "commandWindows": "\"$shell_path\" \"$script_path\" PermissionRequest",
        "timeout": 30 } ] }
    ]
  }
}
EOF
    else
        cat <<EOF
# Basic — add at the top of ~/.codex/config.toml
notify = ["$script_path", "notify"]

# Full (optional) — save as ~/.codex/hooks.json; in /hooks verify Installed=1, then trust
{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" stamp",
        "timeout": 10 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command",
        "command": "sh \"$script_path\" PermissionRequest",
        "timeout": 30 } ] }
    ]
  }
}
EOF
    fi
}

cli_doctor() {
    agent=$1
    [ "$agent" = codex ] || {
        echo "usage: iriscale-voice doctor codex" >&2
        return 2
    }

    codex_dir=${CODEX_HOME:-$HOME/.codex}
    codex_config="$codex_dir/config.toml"
    codex_hooks="$codex_dir/hooks.json"
    failed=0

    echo "Codex voice configuration"
    if [ -f "$codex_config" ] && grep '^[[:space:]]*notify[[:space:]]*=' "$codex_config" | grep 'iriscale-voice' >/dev/null 2>&1; then
        echo "  OK    completion notify is configured"
    else
        echo "  MISSING completion notify in $codex_config"
        failed=1
    fi

    if [ ! -f "$codex_hooks" ]; then
        echo "  MISSING permission hooks file: $codex_hooks"
        failed=1
    else
        if grep '"async"[[:space:]]*:[[:space:]]*true' "$codex_hooks" >/dev/null 2>&1; then
            echo "  ERROR hooks use async=true; Codex 0.147 skips asynchronous hooks"
            failed=1
        fi
        grep '"UserPromptSubmit"' "$codex_hooks" >/dev/null 2>&1 &&
            echo "  OK    UserPromptSubmit hook is defined" || { echo "  MISSING UserPromptSubmit hook"; failed=1; }
        grep '"PermissionRequest"' "$codex_hooks" >/dev/null 2>&1 &&
            echo "  OK    PermissionRequest hook is defined" || { echo "  MISSING PermissionRequest hook"; failed=1; }
    fi

    echo "  CHECK Open /hooks: each event must show Installed 1 and Active 1."
    [ "$failed" -eq 0 ] && echo "  READY Hook files look installable; confirm installation and trust in /hooks."
    return "$failed"
}

case "$EVENT" in
    help|-h|--help)  usage; exit 0 ;;
    -V|--version|version) echo "$VERSION"; exit 0 ;;
    status)  cli_status; exit $? ;;
    install) shift; cli_install "$@"; exit $? ;;
    doctor)  shift; cli_doctor "$@"; exit $? ;;
    config)  shift; cli_config "$@"; exit $? ;;
    set)     [ -n "$2" ] || { echo "usage: iriscale-voice set <key> <value>" >&2; exit 2; }
             cfg_set "$2" "$3"; echo "$2=$3"; exit 0 ;;
    get)     shift; cli_config get "$@"; exit $? ;;
    unset)   shift; cli_config unset "$@"; exit $? ;;
    mute)    cfg_set enabled false; echo "muted (enabled=false)"; exit 0 ;;
    unmute)  cfg_set enabled true;  echo "unmuted (enabled=true)"; exit 0 ;;
    presets)
        for p in off basic standard verbose; do printf '  %-9s %s\n' "$p" "$(preset_events "$p" | sed 's/^$/(nothing)/')"; done
        echo; echo "  standard also skips 'done' for turns under 30s (min_turn_seconds)."; exit 0 ;;
    events)
        printf '  %-18s %-46s %s\n' EVENT "WHEN IT FIRES" "WHAT IT SAYS"
        events_table | while IFS='|' read -r e w s; do printf '  %-18s %-46s %s\n' "$e" "$w" "$s"; done; exit 0 ;;
    say|speak) shift; speak "${*:-iriscale voice test}"; exit 0 ;;
    test)    speak "iriscale voice is working"; echo "spoke a test phrase via $(os) backend"; exit 0 ;;
    -*)      echo "unknown option: $EVENT" >&2; usage >&2; exit 2 ;;
esac

# ---------- hook path ---------------------------------------------------------
NOW=$(date +%s)
# Payload source: JSON on stdin (Claude Code, Codex hooks, Copilot, Gemini, ...) or as
# an argument (Codex `notify = [...]` appends the JSON as the last argv; also accepts a
# bare JSON first argument). Then normalize other agents' names onto ours.
payload=""
case $EVENT in
    notify) for _a in "$@"; do payload=$_a; done ;;      # last argument
    '{'*)   payload=$EVENT ;;
    *)      while IFS= read -r _l || [ -n "$_l" ]; do payload="$payload$_l$NL"; done 2>/dev/null ;;
esac
case $EVENT in
    notify|'{'*)
        _t=$(jget type "$payload"); [ -n "$_t" ] || _t=$(jget hook_event_name "$payload")
        case $_t in
            agent-turn-complete|"") EVENT=Stop ;;
            *) EVENT=$_t ;;
        esac ;;
esac
# event aliases (other agents' names for the same moment)
case $EVENT in
    agentStop|AfterAgent|TaskComplete|session.idle|post_cascade_response|agent-turn-complete) EVENT=Stop ;;
    errorOccurred|session.error|TaskCancel) EVENT=StopFailure ;;
    permissionRequest|permission.asked) EVENT=PermissionRequest ;;
    stop)   # Cursor: one event, three outcomes
        _status=$(jget status "$payload")
        case $_status in completed|"") EVENT=Stop ;; error) EVENT=StopFailure ;; aborted) exit 0 ;; esac ;;
esac
# session id aliases: Claude/Codex hooks | Codex notify | Copilot | Cursor
sid=$(jget session_id "$payload")
[ -n "$sid" ] || sid=$(jget thread-id "$payload")
[ -n "$sid" ] || sid=$(jget sessionId "$payload")
[ -n "$sid" ] || sid=$(jget conversation_id "$payload")

if [ "$EVENT" = "stamp" ]; then
    [ -n "$sid" ] && printf '%s\n' "$NOW" > "$STATE/$sid.start"
    exit 0
fi

# resolve a friendly session name: /rename'd name -> cwd folder -> "Claude".
# Claude Code: ~/.claude/sessions/<pid>.json, one JSON object per file.
# Codex CLI:   ~/.codex/session_index.jsonl, one {"id","thread_name"} per line.
# Both scanned with builtins (no grep).
name=""
if [ -n "$sid" ] && [ -d "$CLAUDE_DIR/sessions" ]; then
    for f in "$CLAUDE_DIR"/sessions/*.json; do
        [ -f "$f" ] || continue
        IFS= read -r sj < "$f" || :
        case $sj in *"\"sessionId\":\"$sid\""*) name=$(jget name "$sj"); break ;; esac
    done
fi
CODEX_INDEX="${CODEX_HOME:-$HOME/.codex}/session_index.jsonl"
if [ -z "$name" ] && [ -n "$sid" ] && [ -f "$CODEX_INDEX" ]; then
    while IFS= read -r cj || [ -n "$cj" ]; do
        case $cj in *"\"id\":\"$sid\""*) name=$(jget thread_name "$cj"); break ;; esac
    done < "$CODEX_INDEX"
fi
if [ -z "$name" ]; then
    cwd=$(jget cwd "$payload")
    [ -n "$cwd" ] || cwd=$(jfirst workspace_roots "$payload")
    # basename of a JSON-escaped Windows or POSIX path: C:\\Users\\x\\proj\\ -> proj
    while case $cwd in *\\) true ;; *) false ;; esac; do cwd=${cwd%\\}; done
    while case $cwd in */) true ;; *) false ;; esac; do cwd=${cwd%/}; done
    name=${cwd##*\\}; name=${name##*/}
fi
[ -z "$name" ] && name="Claude"
# speak '_' and '-' as spaces, with builtins
spoken_name=""; _n=$name
while [ -n "$_n" ]; do _c=${_n%"${_n#?}"}; _n=${_n#?}; case $_c in _|-) _c=' ' ;; esac; spoken_name="$spoken_name$_c"; done

# ---------- decide ------------------------------------------------------------
reason=""
cfgv preset preset standard
[ -n "$IRISCALE_VOICE_OFF" ]            && reason="muted via IRISCALE_VOICE_OFF"
cfgv enabled enabled true
[ -z "$reason" ] && [ "$enabled" != "true" ] && reason="disabled (enabled=false)"

if [ -z "$reason" ]; then
    # per-event override wins:  event.Stop=off  /  event.SubagentStop=on
    cfgv ov "event.$EVENT" ""
    case "$ov" in
        off|false|0) reason="event $EVENT is off in config" ;;
        on|true|1)   : ;;
        *) case " $(preset_events "$preset") " in
               *" $EVENT "*) : ;;
               *) reason="event $EVENT is off in preset $preset" ;;
           esac ;;
    esac
fi

if [ -z "$reason" ]; then
    cfgv qh quiet_hours ""          # e.g. 22-8
    if [ -n "$qh" ]; then
        qs=${qh%-*}; qe=${qh#*-}; h=$(hour_now)
        if [ "$qs" -lt "$qe" ]; then [ "$h" -ge "$qs" ] && [ "$h" -lt "$qe" ] && reason="quiet hours ($qh)"
        elif [ "$qs" -gt "$qe" ]; then { [ "$h" -ge "$qs" ] || [ "$h" -lt "$qe" ]; } && reason="quiet hours ($qh)"; fi
    fi
fi

if [ -z "$reason" ]; then
    cfgv only only_sessions ""; cfgv mute mute_sessions ""
    [ -n "$only" ] && case ",$only," in *",$name,"*) : ;; *) reason="$name not in only_sessions" ;; esac
    [ -n "$mute" ] && case ",$mute," in *",$name,"*) reason="$name is in mute_sessions" ;; esac
fi

elapsed=""
if [ -n "$sid" ] && [ -f "$STATE/$sid.start" ]; then
    IFS= read -r started < "$STATE/$sid.start" || started=0; elapsed=$(( NOW - ${started:-0} ))
fi
if [ -z "$reason" ] && [ "$EVENT" = "Stop" ]; then
    cfgv min min_turn_seconds "$(preset_min_turn "$preset")"
    [ -n "$elapsed" ] && [ "$min" -gt 0 ] && [ "$elapsed" -lt "$min" ] && reason="turn took ${elapsed}s, under min_turn_seconds=$min"
fi

# ---------- phrase ------------------------------------------------------------
case "$EVENT" in
    Stop)              tail="done" ;;
    StopFailure)       why=$(jget reason "$payload"); [ -z "$why" ] && why=$(jget error "$payload")
                       tail="stopped with an error"; [ -n "$why" ] && tail="stopped: $(printf '%s' "$why" | tr '_' ' ')" ;;
    PermissionRequest) tool=$(jget tool_name "$payload")
                       tail="is waiting for your answer"; [ -n "$tool" ] && tail="is waiting for your answer to use $tool"
                       if [ "$tool" = "Bash" ]; then
                           cmd=$(jget command "$payload"); cmd=$(printf '%.60s' "$cmd"); [ -n "$cmd" ] && tail="is waiting for your answer to run $cmd"
                       fi ;;
    permission_prompt) tail="needs permission" ;;
    idle_prompt)       tail="is waiting for you" ;;
    agent_completed)   tail="agent finished" ;;
    SubagentStop)      tail="sub agent done" ;;      # "subagent" gets read as "soob-agent"
    SessionEnd)        tail="session ended"; [ -n "$sid" ] && rm -f "$STATE/$sid.start" ;;
    *)                 tail="$EVENT" ;;
esac
# elapsed time on completion, when it's long enough to matter
cfgv say_elapsed say_elapsed true
if [ "$EVENT" = "Stop" ] && [ -n "$elapsed" ] && [ "$elapsed" -ge 60 ] && [ "$say_elapsed" = "true" ]; then
    m=$((elapsed / 60)); tail="$tail after $m minute$( [ "$m" -ne 1 ] && echo s)"
fi
line="$spoken_name $tail"

# repeat guard: the same announcement for the same session within repeat_cooldown
# seconds is noise (a subagent looping, a hook double-firing) — say it once.
cfgv cool repeat_cooldown 60
lastf="$STATE/${sid:-nosid}.last"
if [ -z "$reason" ] && [ "$cool" -gt 0 ] 2>/dev/null && [ -f "$lastf" ]; then
    { IFS= read -r last_t; IFS= read -r last_line; } < "$lastf"
    if [ "$last_line" = "$line" ] && [ $(( NOW - ${last_t:-0} )) -lt "$cool" ]; then
        reason="same announcement within ${cool}s (repeat_cooldown)"
    fi
fi
[ -z "$reason" ] && printf '%s\n%s\n' "$NOW" "$line" > "$lastf" 2>/dev/null

# ---------- act ---------------------------------------------------------------
if [ -n "$IRISCALE_VOICE_DEBUG" ]; then
    if [ -n "$reason" ]; then echo "SKIP  [$EVENT] ($reason)  would say: $line"
    else echo "SPEAK [$EVENT] $line"; fi
    exit 0
fi
[ -n "$reason" ] && exit 0

cfgv log log "$CLAUDE_DIR/iriscale-voice.log"
[ "$log" != "none" ] && printf '%s\t%s\t%s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$EVENT" "$line" >> "$log" 2>/dev/null

# Speak in a detached background subshell so the hook returns immediately.
# Synchronous hosts (Codex runs hooks synchronously - async definitions are
# skipped as of 0.147) would otherwise freeze for the whole spoken phrase:
# measured ~7 s blocking on a permission announcement. The subshell inherits
# CONF_DATA and the serialize lock still queues concurrent sessions.
cfgv serialize serialize true
(
    if [ "$serialize" = "true" ]; then with_lock speak "$line"; else speak "$line"; fi
) </dev/null >/dev/null 2>&1 &
exit 0
