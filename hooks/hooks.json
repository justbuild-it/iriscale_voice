{
  "description": "iriscale voice — speaks the session name when Claude Code finishes, fails, or needs you. All events route to one script; what actually gets spoken is decided by the preset in ~/.claude/iriscale-voice.conf (see /iriscale-voice:voice).",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/notify.sh\" stamp", "async": true, "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/notify.sh\" Stop", "async": true, "timeout": 30 } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/notify.sh\" StopFailure", "async": true, "timeout": 30 } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/notify.sh\" PermissionRequest", "async": true, "timeout": 30 } ] }
    ],
    "Notification": [
      { "matcher": "idle_prompt",     "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/notify.sh\" idle_prompt",     "async": true, "timeout": 30 } ] },
      { "matcher": "agent_completed", "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/notify.sh\" agent_completed", "async": true, "timeout": 30 } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/notify.sh\" SubagentStop", "async": true, "timeout": 30 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/notify.sh\" SessionEnd", "async": true, "timeout": 30 } ] }
    ]
  }
}
